&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИТКДобавитьПоле("Номер", "Объект.Номер", "Номер", Истина, ЭтаФорма);
	ИТКДобавитьПоле("Дата", "Объект.Дата", "Дата", Истина, ЭтаФорма);
	ИТКДобавитьПоле("Поставщик", "Объект.Поставщик", "Поставщик", Истина, ЭтаФорма);
	ИТКДобавитьПоле("Валюта", "Объект.Валюта", "Валюта закупки", Истина, ЭтаФорма);
	ИТКДобавитьПоле("Состояние", "Объект.Состояние", "Состояние", Истина, ЭтаФорма);
	ИТКДобавитьПоле("СуммаДокумента", "Объект.СуммаДокумента", "Ориентировочная сумма", Истина, ЭтаФорма);
	Таблица = Элементы.Найти("Товары");
	Если Таблица = Неопределено Тогда
		Таблица = Элементы.Добавить("Товары", Тип("ТаблицаФормы"), ЭтаФорма);
	КонецЕсли;
	Таблица.ПутьКДанным = "Объект.Товары";
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.УстановитьДействие("ПриИзменении", "ИТКТоварыПриИзменении");
	ИТКДобавитьПоле("ТоварыТовар", "Объект.Товары.Товар", "Товар", Истина, Таблица);
	ИТКДобавитьПоле("ТоварыЕдиницыИзмерения", "Объект.Товары.ЕдиницыИзмерения", "Единицы измерения", Истина, Таблица);
	ИТКДобавитьПоле("ТоварыКоличество", "Объект.Товары.Количество", "Количество", Ложь, Таблица);
	ИТКДобавитьПоле("ТоварыЦена", "Объект.Товары.Цена", "Закупочная цена", Ложь, Таблица);
	ИТКДобавитьПоле("ТоварыСумма", "Объект.Товары.Сумма", "Сумма", Истина, Таблица);
	ИТКДобавитьКоманду("ИТКОтправить", "Отметить отправленным");
	ИТКДобавитьКоманду("ИТКПринять", "Оформить приёмку");
	ИТКДобавитьКоманду("ИТКОтменить", "Отменить заказ");
	ИТКНастроитьДоступность(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ИТКДобавитьПоле(Имя, Путь, Заголовок, Просмотр, Родитель)

	Поле = Элементы.Найти(Имя);
	Если Поле = Неопределено Тогда
		Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	КонецЕсли;
	Поле.ПутьКДанным = Путь;
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.Заголовок = Заголовок;
	Поле.ТолькоПросмотр = Просмотр;

КонецПроцедуры

&НаСервере
Процедура ИТКДобавитьКоманду(Имя, Заголовок)

	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Кнопка = Элементы.Добавить(Имя + "Кнопка", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
	Кнопка.ИмяКоманды = Имя;
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;

КонецПроцедуры

&НаКлиенте
Процедура ИТКТоварыПриИзменении(Элемент)

	Объект.СуммаДокумента = 0;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
		Объект.СуммаДокумента = Объект.СуммаДокумента + СтрокаТовара.Сумма;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИТКОтправить(Команда)

	ИТКСменитьСостояние(ПредопределенноеЗначение("Перечисление.ИТКСостоянияЗаказов.Отправлен"));

КонецПроцедуры

&НаКлиенте
Процедура ИТКПринять(Команда)

	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТовара = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку товара заказа.");
		Возврат;
	КонецЕсли;
	Заполнение = ИТКЗаполнениеПриемкиНаСервере(СтрокаТовара.Товар, СтрокаТовара.ЕдиницыИзмерения);
	Оповещение = Новый ОписаниеОповещения("ИТКПослеЗакрытияПриемки", ЭтаФорма);
	ОткрытьФорму("Документ.ИТКПриемкаПартии.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", Заполнение), ЭтаФорма, Истина, , , Оповещение);

КонецПроцедуры

&НаСервере
Функция ИТКЗаполнениеПриемкиНаСервере(Товар, ЕдиницыИзмерения)

	Возврат ИТКЗакупкиСервер.ЗаполнениеПриемки(Объект.Ссылка, Товар, ЕдиницыИзмерения);

КонецФункции

&НаКлиенте
Процедура ИТКПослеЗакрытияПриемки(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Прочитать();
	ИТКНастроитьДоступность(ЭтаФорма);
	ОповеститьОбИзменении(Объект.Ссылка);
	ИТКОповеститьЗаявки();

КонецПроцедуры

&НаКлиенте
Процедура ИТКОповеститьЗаявки()

	Для Каждого СтрокаЗаявки Из Объект.Заявки Цикл
		Оповестить("ИТКИзменениеОтгрузки", СтрокаЗаявки.Заявка, ЭтаФорма);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИТКОтменить(Команда)

	ИТКСменитьСостояние(ПредопределенноеЗначение("Перечисление.ИТКСостоянияЗаказов.Отменен"));

КонецПроцедуры

&НаКлиенте
Процедура ИТКСменитьСостояние(НовоеСостояние)

	Предыдущее = Объект.Состояние;
	Объект.Состояние = НовоеСостояние;
	Если Не Записать() Тогда
		Объект.Состояние = Предыдущее;
	КонецЕсли;
	ИТКНастроитьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИТКЗаказПодготовлен(Состояние)

	Возврат Состояние = ПредопределенноеЗначение("Перечисление.ИТКСостоянияЗаказов.Подготовлен");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ИТКНастроитьДоступность(Форма)

	Подготовлен = ИТКЗаказПодготовлен(Форма.Объект.Состояние);
	Активен = Подготовлен Или Форма.Объект.Состояние = ПредопределенноеЗначение("Перечисление.ИТКСостоянияЗаказов.Отправлен");
	Форма.Элементы.Товары.ТолькоПросмотр = Не Подготовлен;
	Форма.Элементы.ИТКОтправитьКнопка.Доступность = Подготовлен;
	Форма.Элементы.ИТКПринятьКнопка.Доступность = Не Подготовлен
		И Форма.Объект.Состояние <> ПредопределенноеЗначение("Перечисление.ИТКСостоянияЗаказов.Отменен");
	Форма.Элементы.ИТКОтменитьКнопка.Доступность = Активен;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
 Если ИмяСобытия = "ИТК03ПриемкаИзменена" И Параметр.Заказ = Объект.Ссылка Тогда
  ПодключитьОбработчикОжидания("ИТК03ПеречитатьЗаказ", 0.1, Истина);
 КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ПеречитатьЗаказ() Экспорт
 Если Модифицированность Тогда
  ПоказатьПредупреждение(, "Приёмка изменила заказ. Сохраните или отмените свои изменения, затем перечитайте заказ.");
  Возврат;
 КонецЕсли;
 Прочитать();
 ИТКНастроитьДоступность(ЭтаФорма);
 ИТКОповеститьЗаявки();
КонецПроцедуры
