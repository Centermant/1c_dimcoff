 &НаСервере
 Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	 ЭтаФорма.АвтоВремя = РежимАвтоВремя.НеИспользовать;
	ЭтаФорма.ИспользоватьРежимПроведения = ИспользованиеРежимаПроведения.Неоперативный;
	ИТК03ТекущийМомент = ТекущаяДатаСеанса();
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
	 И (Не ЗначениеЗаполнено(Объект.Дата)
	  Или Объект.Дата = НачалоДня(ИТК03ТекущийМомент)) Тогда
	 Объект.Дата = ИТК03ТекущийМомент;
	КонецЕсли;
	 ИТК03ДобавитьПоле("ИТК03Номер", "Объект.Номер", "Номер", Истина, ЭтаФорма);
	 ИТК03ДобавитьПоле("ИТК03Дата", "Объект.Дата", "Дата установки цен", Ложь, ЭтаФорма, "ИТК03ИзменениеДаты");
	 ИТК03Таблица = Элементы.Добавить("ИТК03Цены", Тип("ТаблицаФормы"), ЭтаФорма);
	 ИТК03Таблица.ПутьКДанным = "Объект.ТоварыЦены";
	 ИТК03ДобавитьПоле("ИТК03ЦеныТовар", "Объект.ТоварыЦены.Товар", "Товар", Ложь, ИТК03Таблица, "ИТК03ИзменениеТовара");
	 ИТК03ДобавитьПоле("ИТК03ЦеныИТКЕдиницаЦены", "Объект.ТоварыЦены.ИТКЕдиницаЦены", "Единица розничной цены", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныСебестоимость", "Объект.ТоварыЦены.Себестоимость", "Плановая себестоимость, RUB", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныРозничнаяЦена", "Объект.ТоварыЦены.РозничнаяЦена", "Розничная цена, RUB", Ложь, ИТК03Таблица, "ИТК03ИзменениеЦены");
	 ИТК03ДобавитьПоле("ИТК03ЦеныИТКМинимальнаяЦена", "Объект.ТоварыЦены.ИТКМинимальнаяЦена", "Минимальная цена, RUB", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныИТКМаржаПроцент", "Объект.ТоварыЦены.ИТКМаржаПроцент", "Маржинальность, %", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныПлановаяПрибыль", "Объект.ТоварыЦены.ПлановаяПрибыль", "Прибыль на единицу, RUB", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныИТКПоставка", "Объект.ТоварыЦены.ИТКПоставка", "Последняя поставка", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныИТКИмяСогласовавшего", "Объект.ТоварыЦены.ИТКИмяСогласовавшего", "Согласовал", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьПоле("ИТК03ЦеныИТКДатаСогласования", "Объект.ТоварыЦены.ИТКДатаСогласования", "Когда согласовал", Истина, ИТК03Таблица, "");
	 ИТК03ДобавитьКоманду("ИТК03Обновить", "Обновить расчёт");
	 ИТК03ДобавитьКоманду("ИТК03Согласовать", "Согласовать цены ниже себестоимости");
	 Элементы.ИТК03СогласоватьКнопка.Доступность = ИТКМаржаСервер.ЭтоРуководитель();
	 ИТК03ПересчитатьНаСервере(0, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ИзменениеТовара(Элемент)
 ИТК03Строка = Элементы.ИТК03Цены.ТекущиеДанные;
 Если ИТК03Строка <> Неопределено Тогда
  ИТК03ПересчитатьНаСервере(ИТК03Строка.НомерСтроки, Истина);
 КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ИзменениеЦены(Элемент)
 ИТК03Строка = Элементы.ИТК03Цены.ТекущиеДанные;
 Если ИТК03Строка <> Неопределено Тогда
  ИТК03ПересчитатьНаСервере(ИТК03Строка.НомерСтроки, Ложь);
 КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ИзменениеДаты(Элемент)
 ИТК03ПересчитатьНаСервере(0, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИТК03Обновить(Команда)
 ИТК03ПересчитатьНаСервере(0, Ложь);
КонецПроцедуры

&НаСервере
Процедура ИТК03ПересчитатьНаСервере(НомерСтроки, ЗаполнитьМинимальную)
 ИТК03Документ = РеквизитФормыВЗначение("Объект");
 ИТК03Товары = Новый Массив;
 Для Каждого ИТК03Строка Из ИТК03Документ.ТоварыЦены Цикл
  Если ЗначениеЗаполнено(ИТК03Строка.Товар) Тогда
   ИТК03Товары.Добавить(ИТК03Строка.Товар);
  КонецЕсли;
 КонецЦикла;
 ИТК03Стоимости = ИТКМаржаСервер.ПолучитьСебестоимости(ИТК03Товары, ИТК03Документ.Дата);
 ИТК03Цель = ИТКМаржаСервер.ПолучитьЦелевуюМаржу();
 Для Каждого ИТК03Строка Из ИТК03Документ.ТоварыЦены Цикл
  Если НомерСтроки <> 0 И ИТК03Строка.НомерСтроки <> НомерСтроки Тогда
   Продолжить;
  КонецЕсли;
  Если Не ЗначениеЗаполнено(ИТК03Строка.Товар) Тогда
   Продолжить;
  КонецЕсли;
  Попытка
   ИТКМаржаСервер.ОбновитьСтрокуЦены(ИТК03Строка, ИТК03Стоимости.Получить(ИТК03Строка.Товар), ИТК03Цель, ИТК03Документ.Дата);
   Если ЗаполнитьМинимальную Тогда
    ИТК03Строка.РозничнаяЦена = ИТК03Строка.ИТКМинимальнаяЦена;
    ИТКМаржаСервер.ОбновитьСтрокуЦены(ИТК03Строка, ИТК03Стоимости.Получить(ИТК03Строка.Товар), ИТК03Цель, ИТК03Документ.Дата);
   КонецЕсли;
   Если ИТК03Строка.РозничнаяЦена < ИТК03Строка.ИТКМинимальнаяЦена Тогда
    ИТК03Сообщение = Новый СообщениеПользователю;
    ИТК03Сообщение.Текст = СтрШаблон("%1: маржа %2 проц., минимальная цена %3 RUB. Ниже себестоимости требуется согласование руководителя.", ИТК03Строка.Товар, ИТК03Строка.ИТКМаржаПроцент, ИТК03Строка.ИТКМинимальнаяЦена);
    ИТК03Сообщение.Сообщить();
   КонецЕсли;
  Исключение
   ИТК03Строка.Себестоимость = 0;
   ИТК03Строка.ИТКМинимальнаяЦена = 0;
   ИТК03Строка.ИТКМаржаПроцент = 0;
   ИТК03Строка.ПлановаяПрибыль = 0;
   ИТК03Строка.ИТКПоставка = Документы.ИТКПриемкаПартии.ПустаяСсылка();
   ИТКМаржаСервер.СнятьСогласование(ИТК03Строка);
   ИТК03Сообщение = Новый СообщениеПользователю;
   ИТК03Сообщение.Текст = ОписаниеОшибки();
   ИТК03Сообщение.Сообщить();
  КонецПопытки;
 КонецЦикла;
 ЗначениеВРеквизитФормы(ИТК03Документ, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ИТК03Согласовать(Команда)
 ПоказатьВопрос(Новый ОписаниеОповещения("ИТК03ПослеПодтверждения", ЭтаФорма),
  "Подтвердить продажу ниже себестоимости? Согласование будет записано вместе с документом цен.", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт
 Если Ответ = КодВозвратаДиалога.Да Тогда
  ИТК03СогласоватьНаСервере();
  Модифицированность = Истина;
 КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИТК03СогласоватьНаСервере()
 ИТК03Документ = РеквизитФормыВЗначение("Объект");
 ИТКМаржаСервер.СогласоватьНизкиеЦены(ИТК03Документ);
 ЗначениеВРеквизитФормы(ИТК03Документ, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
 ОповеститьОбИзменении(Объект.Ссылка);
 Оповестить("ИТК03ЦеныИзменены", Неопределено, ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ИТК03ДобавитьПоле(Имя, Путь, Заголовок, Просмотр, Родитель, Действие = "")
 ИТК03Поле = Элементы.Найти(Имя);
 Если ИТК03Поле = Неопределено Тогда
  ИТК03Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
 КонецЕсли;
 ИТК03Поле.ПутьКДанным = Путь;
 ИТК03Поле.Вид = ВидПоляФормы.ПолеВвода;
 ИТК03Поле.Заголовок = Заголовок;
 ИТК03Поле.ТолькоПросмотр = Просмотр;
 Если Не ПустаяСтрока(Действие) Тогда
  ИТК03Поле.УстановитьДействие("ПриИзменении", Действие);
 КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИТК03ДобавитьКоманду(Имя, Заголовок)
 ИТК03Команда = Команды.Найти(Имя);
 Если ИТК03Команда = Неопределено Тогда
  ИТК03Команда = Команды.Добавить(Имя);
 КонецЕсли;
 ИТК03Команда.Заголовок = Заголовок;
 ИТК03Команда.Действие = Имя;
 ИТК03Кнопка = Элементы.Добавить(Имя + "Кнопка", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
 ИТК03Кнопка.ИмяКоманды = Имя;
 ИТК03Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
 Если ИмяСобытия <> "ИТК03ПриемкаИзменена" Тогда
  Возврат;
 КонецЕсли;
 Для Каждого ИТК03Строка Из Объект.ТоварыЦены Цикл
  Если ИТК03Строка.Товар = Параметр.Товар Тогда
   ПодключитьОбработчикОжидания("ИТК03ОбновитьПослеОповещения", 0.1, Истина);
   Прервать;
  КонецЕсли;
 КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ОбновитьПослеОповещения() Экспорт
 ИТК03Изменено = Модифицированность;
 ИТК03ПересчитатьНаСервере(0, Ложь);
 Модифицированность = ИТК03Изменено;
КонецПроцедуры
