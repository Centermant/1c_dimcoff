#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьСостояниеЗаявки();
	ИТК01ОбновитьИнтерфейс();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьСостояниеЗаявки();
	ИТК01ОбновитьИнтерфейс();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "ИТКИзменениеОтгрузки" Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Параметр <> Объект.Ссылка Тогда
		Возврат;
	КонецЕсли;
	// ПослеЗаписи ТТН не допускает серверных вызовов: обновляем после выхода из события.
	ЭтаФорма.ПодключитьОбработчикОжидания("ИТКОбновитьОтгрузку", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормы

&НаКлиенте
Процедура ТоварыАссортиментПриИзменении(Элемент)

	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = ПолучитьДанные(СтрокаТовара.Ассортимент);
	СтрокаТовара.ВидАссортимента = Данные.ВидАссортимента;
	СтрокаТовара.ЕдиницыИзмерения = Данные.ЕдиницыИзмерения;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИТКПрименитьЗамены(Команда)

	ПрименитьЗаменыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИТКОбновитьОтгрузку() Экспорт

	ОбновитьСостояниеЗаявки();

КонецПроцедуры

&НаСервере
Процедура ПрименитьЗаменыНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Если Не ДокументОбъект.Проведен Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сначала проведите заявку, чтобы получить резерв и предложения замены.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если Не ИТКРезервыСервер.ПрименитьЗамены(ДокументОбъект) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Доступных предложенных замен нет.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	// Повторно проверяются обязательные позиции №2 и свободные остатки №5.
	// При отказе платформа сохраняет прежний документ и его резерв.
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	ОбновитьСостояниеЗаявки();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеЗаявки()

	Если Не Объект.Проведен Тогда
		Возврат;
	КонецЕсли;
	БылиИзменения = ЭтаФорма.Модифицированность;
	Состояние = ИТКРезервыСервер.ПолучитьСостояниеЗаявки(Объект.Ссылка);
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Строки = Состояние.НайтиСтроки(Новый Структура("Товар,ЕдиницыИзмерения",
			СтрокаТовара.Ассортимент, СтрокаТовара.ЕдиницыИзмерения));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара.ИТКОтгружено = Строки[0].Отгружено;
		СтрокаТовара.ИТКРезерв = Строки[0].Зарезервировано;
		СтрокаТовара.ИТКДефицит = Макс(0, СтрокаТовара.Количество
			- СтрокаТовара.ИТКОтгружено - СтрокаТовара.ИТКРезерв);
		Если СтрокаТовара.ИТКДефицит = 0 Тогда
			СтрокаТовара.ИТКЗамена = Справочники.Ассортимент.ПустаяСсылка();
			СтрокаТовара.ИТККоличествоЗамены = 0;
		КонецЕсли;
	КонецЦикла;
	// Обновление расчётных колонок не записывает документ и не сбрасывает правки пользователя.
	ЭтаФорма.Модифицированность = БылиИзменения;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанные(Знач Ассортимент)

	Данные = Новый Структура("ВидАссортимента,ЕдиницыИзмерения",
		Перечисления.ВидАссортимента.ПустаяСсылка(), Перечисления.ЕдиницыИзмерения.ПустаяСсылка());
	Если Не ЗначениеЗаполнено(Ассортимент) Тогда
		Возврат Данные;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ ПЕРВЫЕ 1 Ассортимент.ВидАссортимента КАК ВидАссортимента,
	    | АссортиментЕдиницы.ВходящиеЕдиницыИзмерения КАК ЕдиницыИзмерения
	    |ИЗ Справочник.Ассортимент КАК Ассортимент
	    | ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ассортимент.Единицы КАК АссортиментЕдиницы
	    | ПО Ассортимент.Ссылка = АссортиментЕдиницы.Ссылка
	    |ГДЕ Ассортимент.Ссылка = &Ассортимент
	    |УПОРЯДОЧИТЬ ПО АссортиментЕдиницы.НомерСтроки";
	Запрос.УстановитьПараметр("Ассортимент", Ассортимент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные.ВидАссортимента = Выборка.ВидАссортимента;
		Если ЗначениеЗаполнено(Выборка.ЕдиницыИзмерения) Тогда
			Данные.ЕдиницыИзмерения = Выборка.ЕдиницыИзмерения;
		КонецЕсли;
	КонецЕсли;
	Возврат Данные;

КонецФункции

#КонецОбласти


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ЭтаФорма.АвтоВремя = РежимАвтоВремя.НеИспользовать;
    ЭтаФорма.ИспользоватьРежимПроведения = ИспользованиеРежимаПроведения.Неоперативный;
    ИТК01Момент = ТекущаяДатаСеанса();
    Если Не ЗначениеЗаполнено(Объект.Ссылка)
        И (Не ЗначениеЗаполнено(Объект.Дата) Или Объект.Дата = НачалоДня(ИТК01Момент)) Тогда
        Объект.Дата = ИТК01Момент;
    КонецЕсли;
    ИТК01ДобавитьПоле("ИТК01Состояние", "Объект.ИТКСостояниеАвтозаявки", "Согласование автозаявки", ЭтаФорма);
    ИТК01ДобавитьПоле("ИТК01ДатаРасчета", "Объект.ИТКДатаАвторасчета", "Расчёт выполнен", ЭтаФорма);
    ИТК01ДобавитьПоле("ИТК01Согласовал", "Объект.ИТКСогласовалАвтозаявку", "Согласовал", ЭтаФорма);
    ИТК01ДобавитьПоле("ИТК01ДатаСогласования", "Объект.ИТКДатаСогласованияЗаявки", "Когда согласовал", ЭтаФорма);
    ИТК01ДобавитьПоле("ИТК01Рекомендовано", "Объект.Товары.ИТКРекомендовано", "Рекомендовано системой", Элементы.Товары);
    ИТК01ДобавитьПоле("ИТК01Остаток", "Объект.Товары.ИТКАвтоОстаток", "Остаток на точке", Элементы.Товары);
    ИТК01ДобавитьПоле("ИТК01ВПути", "Объект.Товары.ИТКАвтоВПути", "Уже заказано", Элементы.Товары);
    ИТК01ДобавитьПоле("ИТК01Прогноз", "Объект.Товары.ИТКАвтоПрогноз", "Прогноз на доставку", Элементы.Товары);
    ИТК01ДобавитьКоманду("ИТК01Отправить", "Отправить на согласование");
    ИТК01ДобавитьКоманду("ИТК01Согласовать", "Согласовать и провести");
    ИТК01ДобавитьКоманду("ИТК01Отклонить", "Отклонить автозаявку");
    ИТК01ДобавитьКоманду("ИТК01Доработать", "Вернуть на доработку");
    ИТК01ОбновитьИнтерфейс();
КонецПроцедуры

&НаСервере
Процедура ИТК01ДобавитьПоле(ИмяПоля, Путь, Заголовок, Родитель)
    Поле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь;
    Поле.Заголовок = Заголовок;
    Поле.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаСервере
Процедура ИТК01ДобавитьКоманду(ИмяКоманды, Заголовок)
    Команда = Команды.Добавить(ИмяКоманды);
    Команда.Заголовок = Заголовок;
    Команда.Действие = ИмяКоманды;
    Кнопка = Элементы.Добавить(ИмяКоманды + "Кнопка", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
    Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
    Кнопка.ИмяКоманды = ИмяКоманды;
КонецПроцедуры

&НаСервере
Процедура ИТК01ОбновитьИнтерфейс()
    Если Элементы.Найти("ИТК01Состояние") = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Автоматическая = Объект.ИТКАвтозаявка;
    Состояние = Объект.ИТКСостояниеАвтозаявки;
    Руководитель = ИТКАвтозаказСервер.ЭтоРуководительЗаявок();
    Подготовлена = Состояние = Перечисления.ИТКСостоянияАвтозаявки.Подготовлена;
    НаСогласовании = Состояние = Перечисления.ИТКСостоянияАвтозаявки.НаСогласовании;
    Элементы.ИТК01ОтправитьКнопка.Видимость = Автоматическая;
    Элементы.ИТК01ОтправитьКнопка.Доступность = Подготовлена;
    Элементы.ИТК01СогласоватьКнопка.Видимость = Автоматическая;
    Элементы.ИТК01СогласоватьКнопка.Доступность = НаСогласовании И Руководитель;
    Элементы.ИТК01ОтклонитьКнопка.Видимость = Автоматическая;
    Элементы.ИТК01ОтклонитьКнопка.Доступность = НаСогласовании И Руководитель;
    Элементы.ИТК01ДоработатьКнопка.Видимость = Автоматическая;
    Элементы.ИТК01ДоработатьКнопка.Доступность = Не Подготовлена И Не Объект.Проведен;
    Элементы.ИТК01Состояние.Видимость = Автоматическая;
    Элементы.ИТК01ДатаРасчета.Видимость = Автоматическая;
    Элементы.ИТК01Согласовал.Видимость = Автоматическая;
    Элементы.ИТК01ДатаСогласования.Видимость = Автоматическая;
    Элементы.ТорговаяТочка.ТолькоПросмотр = Автоматическая;
    Элементы.Продавец.ТолькоПросмотр = Автоматическая;
    Элементы.Дата.ТолькоПросмотр = Автоматическая;
    Элементы.Товары.ТолькоПросмотр = Автоматическая И Не Подготовлена И Не (Объект.Проведен И Руководитель);
КонецПроцедуры

&НаКлиенте
Процедура ИТК01Отправить(Команда)
    ИТК01ВыполнитьПереход("Отправить");
КонецПроцедуры

&НаКлиенте
Процедура ИТК01Согласовать(Команда)
    ИТК01ВыполнитьПереход("Согласовать");
КонецПроцедуры

&НаКлиенте
Процедура ИТК01Отклонить(Команда)
    ИТК01ВыполнитьПереход("Отклонить");
КонецПроцедуры

&НаКлиенте
Процедура ИТК01Доработать(Команда)
    ИТК01ВыполнитьПереход("Доработать");
КонецПроцедуры

&НаКлиенте
Процедура ИТК01ВыполнитьПереход(Действие)
    ИТК01ПереходНаСервере(Действие);
    ОповеститьОбИзменении(Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ИТК01ПереходНаСервере(Действие)
    Если ЭтаФорма.Модифицированность Тогда
        ДокументЗаявки = РеквизитФормыВЗначение("Объект");
        ДокументЗаявки.Записать();
        ЗначениеВРеквизитФормы(ДокументЗаявки, "Объект");
    КонецЕсли;
    ИТКАвтозаказСервер.ИзменитьСостояние(Объект.Ссылка, Действие);
    ДокументЗаявки = Объект.Ссылка.ПолучитьОбъект();
    ЗначениеВРеквизитФормы(ДокументЗаявки, "Объект");
    ЭтаФорма.Модифицированность = Ложь;
    ИТК01ОбновитьИнтерфейс();
    ОбновитьСостояниеЗаявки();
КонецПроцедуры
