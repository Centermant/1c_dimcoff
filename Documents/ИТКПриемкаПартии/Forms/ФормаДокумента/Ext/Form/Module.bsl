&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
 ИТК03Реквизиты = Новый Массив;
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Заявки", Новый ОписаниеТипов("СписокЗначений")));
 ИзменитьРеквизиты(ИТК03Реквизиты);
 ЭтаФорма.ИТК03Заявки = Новый СписокЗначений;
 Если ЗначениеЗаполнено(Объект.ИТКЗаказПоставщику) Тогда
  ИТК03Заказ = Объект.ИТКЗаказПоставщику.ПолучитьОбъект();
  Для Каждого ИТК03Источник Из ИТК03Заказ.Заявки Цикл
   ЭтаФорма.ИТК03Заявки.Добавить(ИТК03Источник.Заявка);
  КонецЦикла;
 КонецЕсли;
 ИТК03ДобавитьПоле("ИТК03Номер", "Объект.Номер", "Номер", Истина, ЭтаФорма, "");
 ИТК03ДобавитьПоле("ИТК03Дата", "Объект.Дата", "Дата приёмки", Ложь, ЭтаФорма, "ИТК03ИзменениеКурса");
 ИТК03ДобавитьПоле("ИТК03ИТКЗаказПоставщику", "Объект.ИТКЗаказПоставщику", "Заказ поставщику", Истина, ЭтаФорма, "");
 ИТК03ДобавитьПоле("ИТК03Товар", "Объект.Товар", "Товар", Ложь, ЭтаФорма, "ИТК03ИзменениеСтоимости");
 ИТК03ДобавитьПоле("ИТК03ЕдиницыИзмерения", "Объект.ЕдиницыИзмерения", "Единица приёмки", Ложь, ЭтаФорма, "ИТК03ИзменениеСтоимости");
 ИТК03ДобавитьПоле("ИТК03НомерПартии", "Объект.НомерПартии", "Фактический номер партии", Ложь, ЭтаФорма, "");
 ИТК03ДобавитьПоле("ИТК03СрокГодности", "Объект.СрокГодности", "Срок годности", Ложь, ЭтаФорма, "");
 ИТК03ДобавитьПоле("ИТК03Количество", "Объект.Количество", "Фактически принято", Ложь, ЭтаФорма, "ИТК03ИзменениеСтоимости");
 ИТК03ДобавитьПоле("ИТК03ИТКВалютаЗакупки", "Объект.ИТКВалютаЗакупки", "Валюта закупки", Ложь, ЭтаФорма, "ИТК03ИзменениеКурса");
 ИТК03ДобавитьПоле("ИТК03ИТКЦенаЗакупки", "Объект.ИТКЦенаЗакупки", "Закупочная цена за единицу приёмки", Ложь, ЭтаФорма, "ИТК03ИзменениеСтоимости");
 ИТК03ДобавитьПоле("ИТК03ИТККурсЗакупки", "Объект.ИТККурсЗакупки", "Курс: RUB за единицу валюты", Истина, ЭтаФорма, "");
 ИТК03ДобавитьПоле("ИТК03ИТКТранспортРуб", "Объект.ИТКТранспортРуб", "Транспортные расходы этой приёмки, RUB", Ложь, ЭтаФорма, "ИТК03ИзменениеСтоимости");
 ИТК03ДобавитьПоле("ИТК03ИТКПотериРуб", "Объект.ИТКПотериРуб", "Дополнительные расходы на потери, RUB", Ложь, ЭтаФорма, "ИТК03ИзменениеСтоимости");
 ИТК03ДобавитьПоле("ИТК03ИТКСебестоимостьПартии", "Объект.ИТКСебестоимостьПартии", "Стоимость партии, RUB", Истина, ЭтаФорма, "");
 ИТК03ДобавитьПоле("ИТК03ИТКСебестоимостьЕдиницы", "Объект.ИТКСебестоимостьЕдиницы", "Себестоимость единицы приёмки, RUB", Истина, ЭтаФорма, "");
 Если ЗначениеЗаполнено(Объект.ИТКЗаказПоставщику) Тогда
  Элементы.ИТК03Товар.ТолькоПросмотр = Истина;
  Элементы.ИТК03ЕдиницыИзмерения.ТолькоПросмотр = Истина;
  Элементы.ИТК03ИТКВалютаЗакупки.ТолькоПросмотр = Истина;
  Элементы.ИТК03ИТКЦенаЗакупки.ТолькоПросмотр = Истина;
 КонецЕсли;
 ИТК03ПересчитатьНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ИзменениеСтоимости(Элемент)
 ИТК03ПересчитатьНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ИзменениеКурса(Элемент)
 ИТК03ПересчитатьНаСервере(Истина);
КонецПроцедуры

&НаСервере
Процедура ИТК03ПересчитатьНаСервере(ОбновлятьКурс)
 Если ОбновлятьКурс Тогда
  Объект.ИТККурсЗакупки = 0;
 КонецЕсли;
 Если Объект.Количество <= 0 Тогда
  Объект.ИТКСебестоимостьПартии = 0;
  Объект.ИТКСебестоимостьЕдиницы = 0;
  Возврат;
 КонецЕсли;
 ИТК03Приемка = РеквизитФормыВЗначение("Объект");
 Попытка
  ИТКМаржаСервер.РассчитатьПриемку(ИТК03Приемка, ОбновлятьКурс);
  ЗначениеВРеквизитФормы(ИТК03Приемка, "Объект");
 Исключение
  Объект.ИТКСебестоимостьПартии = 0;
  Объект.ИТКСебестоимостьЕдиницы = 0;
  ИТК03Сообщение = Новый СообщениеПользователю;
  ИТК03Сообщение.Текст = ОписаниеОшибки();
  ИТК03Сообщение.Сообщить();
 КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
 ОповеститьОбИзменении(Объект.Ссылка);
 Оповестить("ИТК03ПриемкаИзменена", Новый Структура("Товар,Заказ", Объект.Товар, Объект.ИТКЗаказПоставщику), ЭтаФорма);
 Для Каждого ИТК03Заявка Из ЭтаФорма.ИТК03Заявки Цикл
  Оповестить("ИТКИзменениеОтгрузки", ИТК03Заявка.Значение, ЭтаФорма);
 КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ИТК03ДобавитьПоле(Имя, Путь, Заголовок, Просмотр, Родитель, Действие = "")
 ИТК03Поле = Элементы.Найти(Имя);
 Если ИТК03Поле = Неопределено Тогда
  ИТК03Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
 КонецЕсли;
 ИТК03Поле.ПутьКДанным = Путь;
 ИТК03Поле.Вид = ВидПоляФормы.ПолеВвода;
 ИТК03Поле.Заголовок = Заголовок;
 ИТК03Поле.ТолькоПросмотр = Просмотр;
 Если Не ПустаяСтрока(Действие) Тогда
  ИТК03Поле.УстановитьДействие("ПриИзменении", Действие);
 КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИТК03ДобавитьКоманду(Имя, Заголовок)
 ИТК03Команда = Команды.Найти(Имя);
 Если ИТК03Команда = Неопределено Тогда
  ИТК03Команда = Команды.Добавить(Имя);
 КонецЕсли;
 ИТК03Команда.Заголовок = Заголовок;
 ИТК03Команда.Действие = Имя;
 ИТК03Кнопка = Элементы.Добавить(Имя + "Кнопка", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
 ИТК03Кнопка.ИмяКоманды = Имя;
 ИТК03Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
КонецПроцедуры
