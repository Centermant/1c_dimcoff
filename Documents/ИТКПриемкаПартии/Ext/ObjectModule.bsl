// Контроль стоимости, прав или курса обязателен при любом способе записи, включая обмен.
// BSLLS:DataExchangeLoading-off
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Изменённую проведённую приёмку нужно перепровести кнопкой «Провести».";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ИТКПартииСервер.ПроверитьПриемку(ЭтотОбъект, Отказ);
	Если Не Отказ Тогда
		ИТКЗакупкиСервер.ПроверитьПриемкуЗаказа(ЭтотОбъект, РежимЗаписи);
		ИТКМаржаСервер.ПодготовитьСтоимостьПриемки(ЭтотОбъект, РежимЗаписи);
	КонецЕсли;

КонецПроцедуры
// BSLLS:DataExchangeLoading-on

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ИТКЗакупкиСервер.УдалитьРезервыПриемки(ЭтотОбъект);
	ИТКПартииСервер.ПровестиПриемку(ЭтотОбъект, Отказ);
	Если Не Отказ Тогда
		ИТКЗакупкиСервер.ЗарезервироватьПриемку(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ИТКЗакупкиСервер.УдалитьРезервыПриемки(ЭтотОбъект);
	ИТКПартииСервер.ОтменитьДвижения(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ИТКЗакупкиСервер.ОбновитьЗаказПослеПриемки(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка = Истина)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ИТКЗаказПоставщику") Тогда
			СтандартнаяОбработка = Ложь;
			Если ТипЗнч(ТекстЗаполнения) = Тип("Булево") Тогда
				ТекстЗаполнения = Ложь;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения,
				"ИТКЗаказПоставщику,Товар,ЕдиницыИзмерения,Количество,ИТКЦенаЗакупки,ИТКВалютаЗакупки");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
