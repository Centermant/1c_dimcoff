#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	ЭтотОбъект.Дата = ТекущаяДатаСеанса();
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаТорговойТочки") Тогда
		ЭтотОбъект.Заявка = ДанныеЗаполнения;
		ЭтотОбъект.ТорговаяТочка = ДанныеЗаполнения.ТорговаяТочка;
		ИТКПартииСервер.ЗаполнитьИзЗаявки(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Изменённую проведённую ТТН нужно перепровести кнопкой «Провести».";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ИТКПартииСервер.ПодготовитьТТН(ЭтотОбъект, Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ИТКПартииСервер.ПровестиТТН(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ИТКПартииСервер.ОтменитьДвижения(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти
