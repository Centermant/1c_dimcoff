#Область ПрограммныйИнтерфейс

// Вызывается из модуля объекта заявки при проведении.
// Проверяет текущий календарный шаблон, а без него - исходную матрицу.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - проводимая заявка.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Успех - Булево - разрешено ли проведение;
//   * Сообщения - Массив из Строка - причины отказа;
//   * Шаблон - СправочникСсылка.ИТКШаблоныАссортимента - выбранный шаблон.
Функция ПроверитьЗаявку(ДокументОбъект) Экспорт

	Результат = Новый Структура("Успех,Сообщения,Шаблон",
		Истина, Новый Массив, Справочники.ИТКШаблоныАссортимента.ПустаяСсылка());
	ТекущийДень = НачалоДня(ТекущаяДатаСеанса());
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		| Шаблоны.Ссылка КАК Шаблон,
		| Шаблоны.Наименование КАК Наименование,
		| Шаблоны.Приоритет КАК Приоритет
		|ИЗ
		| Справочник.ИТКШаблоныАссортимента КАК Шаблоны
		|ГДЕ
		| НЕ Шаблоны.ПометкаУдаления
		| И Шаблоны.Активен
		| И Шаблоны.ДатаНачала <= &ТекущийДень
		| И Шаблоны.ДатаОкончания >= &ТекущийДень
		| И Шаблоны.ТорговаяТочка В (&ПодходящиеТочки)
		|УПОРЯДОЧИТЬ ПО
		| Приоритет УБЫВ";
	Запрос.УстановитьПараметр("ТекущийДень", ТекущийДень);
	ПодходящиеТочки = Новый Массив;
	ПодходящиеТочки.Добавить(ДокументОбъект.ТорговаяТочка);
	ПодходящиеТочки.Добавить(Справочники.ТочкиПродаж.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПодходящиеТочки", ПодходящиеТочки);
	Шаблоны = Запрос.Выполнить().Выгрузить();

	Если Шаблоны.Количество() = 0 Тогда
		ПроверитьБазовуюМатрицу(ДокументОбъект, Результат);
		Возврат Результат;
	КонецЕсли;

	Если Шаблоны.Количество() > 1
		И Шаблоны[0].Приоритет = Шаблоны[1].Приоритет Тогда
		Результат.Успех = Ложь;
		ТекстОшибки = СтрШаблон(
			"Конфликт шаблонов: «%1» и «%2» действуют сегодня с одинаковым приоритетом. Измените приоритеты.",
			Шаблоны[0].Наименование, Шаблоны[1].Наименование);
		Результат.Сообщения.Добавить(ТекстОшибки);
		Возврат Результат;
	КонецЕсли;

	Результат.Шаблон = Шаблоны[0].Шаблон;
	ПроверитьТоварыШаблона(ДокументОбъект, Результат, Шаблоны[0].Наименование);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьТоварыШаблона(ДокументОбъект, Результат, НазваниеШаблона)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Товары.Товар КАК Товар,
		| Ассортимент.Наименование КАК Наименование
		|ИЗ
		| Справочник.ИТКШаблоныАссортимента.Товары КАК Товары
		|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ассортимент КАК Ассортимент
		|  ПО Товары.Товар = Ассортимент.Ссылка
		|ГДЕ
		| Товары.Ссылка = &Шаблон";
	Запрос.УстановитьПараметр("Шаблон", Результат.Шаблон);
	ОбязательныеТовары = Запрос.Выполнить().Выгрузить();

	Если ОбязательныеТовары.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		ТекстОшибки = СтрШаблон(
			"В шаблоне «%1» не заданы обязательные товары. Исправьте шаблон.", НазваниеШаблона);
		Результат.Сообщения.Добавить(ТекстОшибки);
		Возврат;
	КонецЕсли;

	ТоварыЗаявки = Новый Соответствие;
	Для Каждого СтрокаЗаявки Из ДокументОбъект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаЗаявки.Ассортимент) И СтрокаЗаявки.Количество > 0 Тогда
			ТоварыЗаявки.Вставить(СтрокаЗаявки.Ассортимент, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ОбязательныйТовар Из ОбязательныеТовары Цикл
		Если Не ЗначениеЗаполнено(ОбязательныйТовар.Товар) Тогда
			Результат.Успех = Ложь;
			ТекстОшибки = СтрШаблон(
				"В шаблоне «%1» есть строка без товара. Исправьте шаблон.", НазваниеШаблона);
			Результат.Сообщения.Добавить(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		Если ТоварыЗаявки.Получить(ОбязательныйТовар.Товар) = Неопределено Тогда
			Результат.Успех = Ложь;
			ТекстОшибки = СтрШаблон(
				"Заявка не проведена: по шаблону «%1» обязателен товар «%2» с положительным количеством.",
				НазваниеШаблона, ОбязательныйТовар.Наименование);
			Результат.Сообщения.Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Текст запроса перенесён из исходного модуля заявки.
// В этой ветви действует прежняя проверка количеств по матрице на дату документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - проводимая заявка.
//  Результат - Структура - результат, в который добавляются ошибки матрицы.
Процедура ПроверитьБазовуюМатрицу(ДокументОбъект, Результат)

	Запрос = Новый Запрос;
	// Проверяем весь набор обязательных позиций, поэтому отбор по товару не задаётся.
	// Период среза передан явно, как в исходной конфигурации.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст = "ВЫБРАТЬ
		|	ЗаявкаТорговойТочкиТовары.Ассортимент КАК Ассортимент,
		|	ЗаявкаТорговойТочкиТовары.ВидАссортимента КАК ВидАссортимента,
		|	ЗаявкаТорговойТочкиТовары.Количество КАК Количество,
		|	ЗаявкаТорговойТочкиТовары.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ПОМЕСТИТЬ ВТДок
		|ИЗ
		|	Документ.ЗаявкаТорговойТочки.Товары КАК ЗаявкаТорговойТочкиТовары
		|ГДЕ
		|	ЗаявкаТорговойТочкиТовары.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АссортиментнаяМатрицаСрезПоследних.Ассортимент КАК Ассортимент,
		|	АссортиментнаяМатрицаСрезПоследних.ВидАссортимента КАК ВидАссортимента,
		|	АссортиментнаяМатрицаСрезПоследних.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		|	АссортиментнаяМатрицаСрезПоследних.Количество КАК КоличествоМатрица
		|ПОМЕСТИТЬ ВТМатрица
		|ИЗ
		|	РегистрСведений.АссортиментнаяМатрица.СрезПоследних(&Дата, ) КАК АссортиментнаяМатрицаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТДок.Ассортимент, ВТМатрица.Ассортимент) КАК Ассортимент,
		|	ВТДок.ВидАссортимента КАК ВидАссортимента,
		|	ЕСТЬNULL(ВТДок.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(ВТДок.ЕдиницыИзмерения, ВТМатрица.ЕдиницыИзмерения) КАК ЕдиницыИзмерения,
		|	ЕСТЬNULL(ВТМатрица.КоличествоМатрица, 0) КАК КоличествоМатрица
		|ИЗ
		|	ВТДок КАК ВТДок
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТМатрица КАК ВТМатрица
		|		ПО ВТДок.Ассортимент = ВТМатрица.Ассортимент
		|			И ВТДок.ВидАссортимента = ВТМатрица.ВидАссортимента
		|			И ВТДок.ЕдиницыИзмерения = ВТМатрица.ЕдиницыИзмерения";
	// BSLLS:VirtualTableCallWithoutParameters-on
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество < Выборка.КоличествоМатрица Тогда
			Результат.Успех = Ложь;
			ТекстОшибки = СтрШаблон(
				"Не выполнены требования базовой ассортиментной матрицы для товара «%1». Не хватает %2 %3.",
				Выборка.Ассортимент, Выборка.КоличествоМатрица - Выборка.Количество,
				Выборка.ЕдиницыИзмерения);
			Результат.Сообщения.Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти