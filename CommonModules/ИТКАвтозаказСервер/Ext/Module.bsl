#Область ПрограммныйИнтерфейс

// Единый вход регламентного задания и проверки при запуске приложения.
Процедура ВыполнитьЕжедневныйРасчет() Экспорт
    СформироватьАвтозаявки(ТекущаяДатаСеанса());
КонецПроцедуры

// Возвращает ссылки на новые и ранее подготовленные заявки за сегодняшний день.
Функция РассчитатьЗаСегодня() Экспорт
    Возврат СформироватьАвтозаявки(ТекущаяДатаСеанса());
КонецФункции

Функция РассчитатьКоличество(Минимум, Максимум, Остаток, ВПути, Прогноз) Экспорт
    Если Минимум < 0 Или Максимум < Минимум Или Остаток < 0 Или ВПути < 0 Или Прогноз < 0 Тогда
        ВызватьИсключение "Некорректные исходные данные автозаказа.";
    КонецЕсли;
    Если Остаток > Минимум Тогда
        Возврат 0;
    КонецЕсли;
    Потребность = Макс(0, Максимум - Остаток - ВПути + Прогноз);
    Рекомендация = Окр(Потребность, 2);
    Если Рекомендация < Потребность Тогда
        Рекомендация = Рекомендация + 0.01;
    КонецЕсли;
    Возврат Рекомендация;
КонецФункции

// Расчёт не пишет документы, не резервирует и не списывает товар.
// Прогноз: продажи семи полных предыдущих дней / 7 * срок доставки.
Функция ПолучитьРасчет(МоментРасчета) Экспорт
    Если Не ЗначениеЗаполнено(МоментРасчета) Или МоментРасчета > ТекущаяДатаСеанса() Тогда
        ВызватьИсключение "Дата расчёта должна быть заполнена и не находиться в будущем.";
    КонецЕсли;
    Нормы = ПолучитьНормы();
    Нормы.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
    Нормы.Колонки.Добавить("ВПути", Новый ОписаниеТипов("Число"));
    Нормы.Колонки.Добавить("Прогноз", Новый ОписаниеТипов("Число"));
    Нормы.Колонки.Добавить("Рекомендовано", Новый ОписаниеТипов("Число"));
    Если Нормы.Количество() = 0 Тогда
        Возврат Нормы;
    КонецЕсли;
    Товары = Нормы.ВыгрузитьКолонку("Товар");
    Единицы = ПолучитьЕдиницы(Товары);
    Отгрузки = ПолучитьОтгрузки(МоментРасчета, Товары);
    Продажи = ПолучитьПродажи(МоментРасчета, Товары);
    Заявки = ПолучитьОжидание(МоментРасчета, Товары);
    Для Каждого Норма Из Нормы Цикл
        ПроверитьНорму(Норма);
        Коэффициент = КоэффициентЕдиницы(Единицы, Норма.Товар, Норма.Единица);
        Фильтр = Новый Структура("ТорговаяТочка,Товар", Норма.ТорговаяТочка, Норма.Товар);
        Доставлено = 0;
        Для Каждого Отгрузка Из Отгрузки.НайтиСтроки(Фильтр) Цикл
            Доставлено = Доставлено + Отгрузка.Количество
                * КоэффициентЕдиницы(Единицы, Норма.Товар, Отгрузка.Единица);
        КонецЦикла;
        ВсегоПродано = 0;
        ПроданоЗаНеделю = 0;
        Для Каждого Продажа Из Продажи.НайтиСтроки(Фильтр) Цикл
            ВсегоПродано = ВсегоПродано + Продажа.Количество;
            ПроданоЗаНеделю = ПроданоЗаНеделю + Продажа.ЗаНеделю;
        КонецЦикла;
        ОстатокВРозничных = Доставлено - ВсегоПродано;
        Если ОстатокВРозничных < 0 Тогда
            ВызватьИсключение СтрШаблон("%1 / %2: продажи превышают доставку. Проверьте проведённые ТТН и продажи.",
                Норма.ТорговаяТочка, Норма.Товар);
        КонецЕсли;
        Норма.Остаток = ОстатокВРозничных / Коэффициент;
        Норма.Прогноз = ПроданоЗаНеделю / 7 * Норма.ДнейДоставки / Коэффициент;
        ВПутиВРозничных = 0;
        ОбработанныеЗаявки = Новый Массив;
        Для Каждого Заявка Из Заявки.НайтиСтроки(Фильтр) Цикл
            Если ОбработанныеЗаявки.Найти(Заявка.Заявка) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            ОбработанныеЗаявки.Добавить(Заявка.Заявка);
            Отгружено = 0;
            Для Каждого Отгрузка Из Отгрузки.НайтиСтроки(Новый Структура("Заявка,Товар", Заявка.Заявка, Норма.Товар)) Цикл
                Отгружено = Отгружено + Отгрузка.Количество
                    * КоэффициентЕдиницы(Единицы, Норма.Товар, Отгрузка.Единица);
            КонецЦикла;
            Заказано = 0;
            Для Каждого СтрокаОжидания Из Заявки.НайтиСтроки(Новый Структура("Заявка,Товар", Заявка.Заявка, Норма.Товар)) Цикл
                Заказано = Заказано + СтрокаОжидания.Количество
                    * КоэффициентЕдиницы(Единицы, Норма.Товар, СтрокаОжидания.Единица);
            КонецЦикла;
            ВПутиВРозничных = ВПутиВРозничных + Макс(0, Заказано - Отгружено);
        КонецЦикла;
        Норма.ВПути = ВПутиВРозничных / Коэффициент;
        Норма.Рекомендовано = РассчитатьКоличество(Норма.Минимум, Норма.Максимум,
            Норма.Остаток, Норма.ВПути, Норма.Прогноз);
    КонецЦикла;
    Возврат Нормы;
КонецФункции

Функция СформироватьАвтозаявки(МоментРасчета) Экспорт
    День = НачалоДня(МоментРасчета);
    Если День <> НачалоДня(ТекущаяДатаСеанса()) Тогда
        ВызватьИсключение "Автоматические заявки формируются только за сегодняшний день.";
    КонецЕсли;
    Результат = Новый Структура("Создано,Заявки", 0, Новый Массив);
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("РегистрСведений.ИТКДниАвтозаказа").Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Добавить("РегистрСведений.ИТКНормативыОстатков").Режим = РежимБлокировкиДанных.Разделяемый;
        Блокировка.Заблокировать();
        Дни = ПолучитьДни(День);
        Расчет = ПолучитьРасчет(МоментРасчета);
        Точки = Расчет.Скопировать(, "ТорговаяТочка");
        Точки.Свернуть("ТорговаяТочка");
        Для Каждого СтрокаТочки Из Точки Цикл
            НайденныеДни = Дни.НайтиСтроки(Новый Структура("ТорговаяТочка", СтрокаТочки.ТорговаяТочка));
            Если НайденныеДни.Количество() > 0 Тогда
                Если ЗначениеЗаполнено(НайденныеДни[0].Заявка) Тогда
                    Результат.Заявки.Добавить(НайденныеДни[0].Заявка);
                КонецЕсли;
                Продолжить;
            КонецЕсли;
            СтрокиТочки = Расчет.НайтиСтроки(Новый Структура("ТорговаяТочка", СтрокаТочки.ТорговаяТочка));
            Заявка = Неопределено;
            Для Каждого СтрокаРасчета Из СтрокиТочки Цикл
                Если СтрокаРасчета.Рекомендовано <= 0 Тогда
                    Продолжить;
                КонецЕсли;
                Если Заявка = Неопределено Тогда
                    Заявка = Документы.ЗаявкаТорговойТочки.СоздатьДокумент();
                    Заявка.Дата = МоментРасчета;
                    Заявка.ТорговаяТочка = СтрокаРасчета.ТорговаяТочка;
                    Заявка.Продавец = СтрокаРасчета.Продавец;
                    Заявка.ИТКАвтозаявка = Истина;
                    Заявка.ИТКДатаАвторасчета = МоментРасчета;
                    Заявка.ИТКСостояниеАвтозаявки = Перечисления.ИТКСостоянияАвтозаявки.Подготовлена;
                    Заявка.ДополнительныеСвойства.Вставить("ИТК01Создание", Истина);
                ИначеЕсли Заявка.Продавец <> СтрокаРасчета.Продавец Тогда
                    ВызватьИсключение "В нормативах одной точки укажите одного ответственного продавца.";
                КонецЕсли;
                СтрокаТовара = Заявка.Товары.Добавить();
                СтрокаТовара.Ассортимент = СтрокаРасчета.Товар;
                СтрокаТовара.ВидАссортимента = СтрокаРасчета.ВидАссортимента;
                СтрокаТовара.ЕдиницыИзмерения = СтрокаРасчета.Единица;
                СтрокаТовара.Количество = СтрокаРасчета.Рекомендовано;
                СтрокаТовара.ИТКРекомендовано = СтрокаРасчета.Рекомендовано;
                СтрокаТовара.ИТКАвтоОстаток = Окр(СтрокаРасчета.Остаток, 4);
                СтрокаТовара.ИТКАвтоВПути = Окр(СтрокаРасчета.ВПути, 4);
                СтрокаТовара.ИТКАвтоПрогноз = Окр(СтрокаРасчета.Прогноз, 4);
            КонецЦикла;
            СсылкаЗаявки = Документы.ЗаявкаТорговойТочки.ПустаяСсылка();
            Если Заявка <> Неопределено Тогда
                Заявка.Записать();
                Заявка.ДополнительныеСвойства.Удалить("ИТК01Создание");
                СсылкаЗаявки = Заявка.Ссылка;
                Результат.Создано = Результат.Создано + 1;
                Результат.Заявки.Добавить(СсылкаЗаявки);
            КонецЕсли;
            ЗаписьДня = РегистрыСведений.ИТКДниАвтозаказа.СоздатьМенеджерЗаписи();
            ЗаписьДня.День = День;
            ЗаписьДня.ТорговаяТочка = СтрокаТочки.ТорговаяТочка;
            ЗаписьДня.Заявка = СсылкаЗаявки;
            ЗаписьДня.МоментРасчета = МоментРасчета;
            ЗаписьДня.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЭтоРуководительЗаявок() Экспорт
    Возврат РольДоступна("ИТКРуководительЗаявок") Или РольДоступна("ПолныеПрава");
КонецФункции

Процедура ПроверитьЗаписьНормативов(Нормы) Экспорт
    Если Нормы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    Единицы = ПолучитьЕдиницы(Нормы.ВыгрузитьКолонку("Товар"));
    Запрос = Новый Запрос("ВЫБРАТЬ Продавцы.Ссылка КАК Продавец, Продавцы.ТорговаяТочка КАК ТорговаяТочка
    |ИЗ Справочник.Продавцы КАК Продавцы ГДЕ Продавцы.Ссылка В (&Продавцы) И НЕ Продавцы.ПометкаУдаления");
    Запрос.УстановитьПараметр("Продавцы", Нормы.ВыгрузитьКолонку("Продавец"));
    Продавцы = Запрос.Выполнить().Выгрузить();
    Для Каждого Норма Из Нормы Цикл
        Если Не ЗначениеЗаполнено(Норма.ТорговаяТочка) Или Не ЗначениеЗаполнено(Норма.Товар) Тогда
            ВызватьИсключение "В нормативе заполните торговую точку и товар.";
        КонецЕсли;
        Если Не Норма.Активен Тогда
            Продолжить;
        КонецЕсли;
        Совпадения = Продавцы.НайтиСтроки(Новый Структура("Продавец,ТорговаяТочка", Норма.Продавец, Норма.ТорговаяТочка));
        Если Совпадения.Количество() <> 1 Или Норма.Минимум < 0 Или Норма.Максимум < Норма.Минимум
            Или Норма.Максимум <= 0 Или Норма.ДнейДоставки <= 0 Или Норма.ДнейДоставки > 365 Тогда
            ВызватьИсключение "Норматив: максимум не ниже минимума и больше нуля; доставка 1-365 дней; продавец относится к выбранной точке.";
        КонецЕсли;
        КоэффициентЕдиницы(Единицы, Норма.Товар, Норма.Единица);
    КонецЦикла;
КонецПроцедуры

// Переходы выполняются над записанным документом. Форма сначала сохраняет правки.
Процедура ИзменитьСостояние(СсылкаЗаявки, Действие) Экспорт
    Заявка = СсылкаЗаявки.ПолучитьОбъект();
    Если Заявка = Неопределено Или Не Заявка.ИТКАвтозаявка Тогда
        ВызватьИсключение "Выберите сохранённую автоматическую заявку.";
    КонецЕсли;
    Если Действие = "Отправить" Тогда
        Заявка.ИТКСостояниеАвтозаявки = Перечисления.ИТКСостоянияАвтозаявки.НаСогласовании;
        Заявка.Записать();
    ИначеЕсли Действие = "Согласовать" Тогда
        Если Не ЭтоРуководительЗаявок() Тогда
            ВызватьИсключение "Согласовать автозаявку может руководитель.";
        КонецЕсли;
        Заявка.ИТКСостояниеАвтозаявки = Перечисления.ИТКСостоянияАвтозаявки.Согласована;
        Заявка.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
    ИначеЕсли Действие = "Отклонить" Тогда
        Если Не ЭтоРуководительЗаявок() Тогда
            ВызватьИсключение "Отклонить автозаявку может руководитель.";
        КонецЕсли;
        Заявка.ИТКСостояниеАвтозаявки = Перечисления.ИТКСостоянияАвтозаявки.Отклонена;
        Заявка.Записать();
    ИначеЕсли Действие = "Доработать" Тогда
        Заявка.ИТКСостояниеАвтозаявки = Перечисления.ИТКСостоянияАвтозаявки.Подготовлена;
        Заявка.Записать();
    Иначе
        ВызватьИсключение "Неизвестная команда согласования заявки.";
    КонецЕсли;
КонецПроцедуры

// Вызывается до прежней подготовки/резервирования №5.
Процедура ПроверитьПередЗаписью(Заявка, РежимЗаписи) Экспорт
    Если Заявка.ЭтоНовый() Тогда
        Создание = Ложь;
        Если Не Заявка.ДополнительныеСвойства.Свойство("ИТК01Создание", Создание) Тогда
            Создание = Ложь;
        КонецЕсли;
        Если Не Заявка.ИТКАвтозаявка Или Не Создание Тогда
            // Копия автозаявки становится обычной заявкой без чужого согласования.
            Заявка.ИТКАвтозаявка = Ложь;
            Заявка.ИТКСостояниеАвтозаявки = Перечисления.ИТКСостоянияАвтозаявки.ПустаяСсылка();
            Заявка.ИТКДатаАвторасчета = Дата(1, 1, 1);
            Заявка.ИТКСогласовалАвтозаявку = "";
            Заявка.ИТКДатаСогласованияЗаявки = Дата(1, 1, 1);
            Для Каждого СтрокаТовара Из Заявка.Товары Цикл
                СтрокаТовара.ИТКРекомендовано = 0;
                СтрокаТовара.ИТКАвтоОстаток = 0;
                СтрокаТовара.ИТКАвтоВПути = 0;
                СтрокаТовара.ИТКАвтоПрогноз = 0;
            КонецЦикла;
            Возврат;
        КонецЕсли;
        Если РежимЗаписи <> РежимЗаписиДокумента.Запись
            Или Заявка.ИТКСостояниеАвтозаявки <> Перечисления.ИТКСостоянияАвтозаявки.Подготовлена Тогда
            ВызватьИсключение "Новая автозаявка сохраняется только как неподтверждённый черновик.";
        КонецЕсли;
        Возврат;
    КонецЕсли;
    Предыдущая = Заявка.Ссылка.ПолучитьОбъект();
    Если Не Предыдущая.ИТКАвтозаявка Тогда
        Если Заявка.ИТКАвтозаявка Тогда
            ВызватьИсключение "Обычная заявка не превращается в автоматическую вручную.";
        КонецЕсли;
        Возврат;
    КонецЕсли;
    Заявка.ИТКАвтозаявка = Истина;
    Если Заявка.ТорговаяТочка <> Предыдущая.ТорговаяТочка Или Заявка.Продавец <> Предыдущая.Продавец
        Или Заявка.Дата <> Предыдущая.Дата Тогда
        ВызватьИсключение "Точка, продавец и дата сформированной автозаявки сохраняются.";
    КонецЕсли;
    Заявка.ИТКДатаАвторасчета = Предыдущая.ИТКДатаАвторасчета;
    Заявка.ИТКСогласовалАвтозаявку = Предыдущая.ИТКСогласовалАвтозаявку;
    Заявка.ИТКДатаСогласованияЗаявки = Предыдущая.ИТКДатаСогласованияЗаявки;
    Старое = Предыдущая.ИТКСостояниеАвтозаявки;
    Новое = Заявка.ИТКСостояниеАвтозаявки;
    Подготовлена = Перечисления.ИТКСостоянияАвтозаявки.Подготовлена;
    НаСогласовании = Перечисления.ИТКСостоянияАвтозаявки.НаСогласовании;
    Согласована = Перечисления.ИТКСостоянияАвтозаявки.Согласована;
    Отклонена = Перечисления.ИТКСостоянияАвтозаявки.Отклонена;
    Если Старое <> Подготовлена Тогда
        Если Не ОдинаковыйСостав(Заявка, Предыдущая) Тогда
            Если Старое = Согласована И РежимЗаписи = РежимЗаписиДокумента.Проведение И ЭтоРуководительЗаявок() Тогда
                // Руководитель повторно подтверждает изменённую заявку, в том числе замену №5.
                Заявка.ИТКСогласовалАвтозаявку = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
                Заявка.ИТКДатаСогласованияЗаявки = ТекущаяДатаСеанса();
            Иначе
                ВызватьИсключение "Верните автозаявку на доработку; изменение согласованной заявки при перепроведении подтверждает руководитель.";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    ВосстановитьРекомендации(Заявка, Предыдущая);
    Если Новое <> Старое Тогда
        Допустимо = Старое = Подготовлена И Новое = НаСогласовании
            Или Старое = НаСогласовании И (Новое = Согласована Или Новое = Отклонена)
            Или (Старое = НаСогласовании Или Старое = Отклонена) И Новое = Подготовлена
            Или Старое = Согласована И Не Предыдущая.Проведен И Новое = Подготовлена;
        Если Не Допустимо Тогда
            ВызватьИсключение "Недопустимое изменение состояния автозаявки.";
        КонецЕсли;
        Если Новое = Согласована Или Новое = Отклонена Тогда
            Если Не ЭтоРуководительЗаявок() Тогда
                ВызватьИсключение "Подтверждение и отклонение доступны руководителю.";
            КонецЕсли;
            Заявка.ИТКСогласовалАвтозаявку = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
            Заявка.ИТКДатаСогласованияЗаявки = ТекущаяДатаСеанса();
        Иначе
            Заявка.ИТКСогласовалАвтозаявку = "";
            Заявка.ИТКДатаСогласованияЗаявки = Дата(1, 1, 1);
        КонецЕсли;
        Если Новое = НаСогласовании Тогда
            Проверка = ИТКАссортиментСервер.ПроверитьЗаявку(Заявка);
            Если Не Проверка.Успех Тогда
                ВызватьИсключение СтрСоединить(Проверка.Сообщения, Символы.ПС);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Если Новое = Согласована И Не Заявка.Проведен И РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
        Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
            ВызватьИсключение "Согласование автозаявки выполняется вместе с её проведением.";
        КонецЕсли;
    КонецЕсли;
    Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Новое <> Согласована Тогда
        ВызватьИсключение "Перед проведением автозаявку должен согласовать руководитель.";
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьНормы()
    Запрос = Новый Запрос("ВЫБРАТЬ Нормы.ТорговаяТочка КАК ТорговаяТочка, Нормы.Товар КАК Товар,
    | Нормы.Единица КАК Единица, Нормы.Минимум КАК Минимум, Нормы.Максимум КАК Максимум,
    | Нормы.ДнейДоставки КАК ДнейДоставки, Нормы.Продавец КАК Продавец,
    | Нормы.Продавец.ТорговаяТочка КАК ТочкаПродавца, Нормы.Товар.ВидАссортимента КАК ВидАссортимента
    |ИЗ РегистрСведений.ИТКНормативыОстатков КАК Нормы
    |ГДЕ Нормы.Активен И НЕ Нормы.ТорговаяТочка.ПометкаУдаления
    | И НЕ Нормы.Товар.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО ТорговаяТочка, Товар");
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьЕдиницы(Товары)
    Запрос = Новый Запрос("ВЫБРАТЬ Единицы.Ссылка КАК Товар,
    | Единицы.ВходящиеЕдиницыИзмерения КАК Входящая,
    | Единицы.ВнутренниеЕдиницыИзмерения КАК Розничная, Единицы.Коэффициент КАК Коэффициент
    |ИЗ Справочник.Ассортимент.Единицы КАК Единицы ГДЕ Единицы.Ссылка В (&Товары)");
    Запрос.УстановитьПараметр("Товары", Товары);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция КоэффициентЕдиницы(ТаблицаЕдиниц, Товар, Единица)
    Строки = ТаблицаЕдиниц.НайтиСтроки(Новый Структура("Товар", Товар));
    Если Строки.Количество() = 0 Тогда
        ВызватьИсключение СтрШаблон("%1: заполните единицы закупки и розничной продажи.", Товар);
    КонецЕсли;
    Розничная = Строки[0].Розничная;
    Коэффициент = Неопределено;
    Для Каждого СтрокаЕдиниц Из Строки Цикл
        Если Не ЗначениеЗаполнено(СтрокаЕдиниц.Входящая) Или Не ЗначениеЗаполнено(Розничная)
            Или СтрокаЕдиниц.Розничная <> Розничная Или СтрокаЕдиниц.Коэффициент <= 0 Тогда
            ВызватьИсключение СтрШаблон("%1: нужна одна розничная единица и положительные коэффициенты.", Товар);
        КонецЕсли;
        Если СтрокаЕдиниц.Входящая = Единица Тогда
            Если Коэффициент <> Неопределено И Коэффициент <> СтрокаЕдиниц.Коэффициент Тогда
                ВызватьИсключение СтрШаблон("%1: неоднозначный пересчёт единицы %2.", Товар, Единица);
            КонецЕсли;
            Коэффициент = СтрокаЕдиниц.Коэффициент;
        КонецЕсли;
    КонецЦикла;
    Если Коэффициент = Неопределено Тогда
        ВызватьИсключение СтрШаблон("%1: единица %2 должна быть указана в колонке «Единица закупки».", Товар, Единица);
    КонецЕсли;
    Возврат Коэффициент;
КонецФункции

Функция ПолучитьОтгрузки(Момент, Товары)
    Запрос = Новый Запрос("ВЫБРАТЬ Товары.Ссылка.Заявка КАК Заявка,
    | Товары.Ссылка.ТорговаяТочка КАК ТорговаяТочка, Товары.Товар КАК Товар,
    | Товары.ЕдиницыИзмерения КАК Единица, СУММА(Товары.Количество) КАК Количество
    |ИЗ Документ.ТоварноТранспортнаяНакладная.Товары КАК Товары
    |ГДЕ Товары.Ссылка.Проведен И НЕ Товары.Ссылка.ПометкаУдаления
    | И Товары.Ссылка.Дата <= &Момент И Товары.Товар В (&Товары)
    |СГРУППИРОВАТЬ ПО Товары.Ссылка.Заявка, Товары.Ссылка.ТорговаяТочка,
    | Товары.Товар, Товары.ЕдиницыИзмерения");
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Товары", Товары);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьПродажи(Момент, Товары)
    Запрос = Новый Запрос("ВЫБРАТЬ Товары.Ссылка.ТочкаПродажи КАК ТорговаяТочка, Товары.Товар КАК Товар,
    | СУММА(Товары.Количество) КАК Количество,
    | СУММА(ВЫБОР КОГДА Товары.Ссылка.Дата >= &НачалоИстории И Товары.Ссылка.Дата < &КонецИстории
    | ТОГДА Товары.Количество ИНАЧЕ 0 КОНЕЦ) КАК ЗаНеделю
    |ИЗ Документ.РозничнаяПродажа.Товары КАК Товары
    |ГДЕ Товары.Ссылка.Проведен И НЕ Товары.Ссылка.ПометкаУдаления
    | И Товары.Ссылка.Дата <= &Момент И Товары.Товар В (&Товары)
    |СГРУППИРОВАТЬ ПО Товары.Ссылка.ТочкаПродажи, Товары.Товар");
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Товары", Товары);
    Запрос.УстановитьПараметр("КонецИстории", НачалоДня(Момент));
    Запрос.УстановитьПараметр("НачалоИстории", НачалоДня(Момент) - 7 * 86400);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьОжидание(Момент, Товары)
    Запрос = Новый Запрос("ВЫБРАТЬ Товары.Ссылка КАК Заявка, Товары.Ссылка.ТорговаяТочка КАК ТорговаяТочка,
    | Товары.Ассортимент КАК Товар, Товары.ЕдиницыИзмерения КАК Единица, СУММА(Товары.Количество) КАК Количество
    |ИЗ Документ.ЗаявкаТорговойТочки.Товары КАК Товары
    |ГДЕ НЕ Товары.Ссылка.ПометкаУдаления И Товары.Ссылка.Дата <= &Момент
    | И Товары.Ассортимент В (&Товары)
    | И (Товары.Ссылка.Проведен ИЛИ Товары.Ссылка.ИТКАвтозаявка
    | И Товары.Ссылка.ИТКСостояниеАвтозаявки В (&Подготовлена, &НаСогласовании))
    |СГРУППИРОВАТЬ ПО Товары.Ссылка, Товары.Ссылка.ТорговаяТочка, Товары.Ассортимент, Товары.ЕдиницыИзмерения");
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Товары", Товары);
    Запрос.УстановитьПараметр("Подготовлена", Перечисления.ИТКСостоянияАвтозаявки.Подготовлена);
    Запрос.УстановитьПараметр("НаСогласовании", Перечисления.ИТКСостоянияАвтозаявки.НаСогласовании);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьДни(День)
    Запрос = Новый Запрос("ВЫБРАТЬ Дни.ТорговаяТочка КАК ТорговаяТочка, Дни.Заявка КАК Заявка
    |ИЗ РегистрСведений.ИТКДниАвтозаказа КАК Дни ГДЕ Дни.День = &День");
    Запрос.УстановитьПараметр("День", День);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПроверитьНорму(Норма)
    Если Не ЗначениеЗаполнено(Норма.ТорговаяТочка) Или Не ЗначениеЗаполнено(Норма.Товар)
        Или Не ЗначениеЗаполнено(Норма.Единица) Или Не ЗначениеЗаполнено(Норма.Продавец)
        Или Норма.ТочкаПродавца <> Норма.ТорговаяТочка
        Или Норма.Минимум < 0 Или Норма.Максимум < Норма.Минимум Или Норма.Максимум <= 0
        Или Норма.ДнейДоставки <= 0 Или Норма.ДнейДоставки > 365 Тогда
        ВызватьИсключение "Проверьте активный норматив: точку, товар, единицу, продавца, минимум/максимум и срок доставки.";
    КонецЕсли;
КонецПроцедуры

Функция ОдинаковыйСостав(Текущая, Предыдущая)
    Если Текущая.Товары.Количество() <> Предыдущая.Товары.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;
    СтарыеСтроки = Предыдущая.Товары.Выгрузить();
    Для Каждого СтрокаТовара Из Текущая.Товары Цикл
        Строки = СтарыеСтроки.НайтиСтроки(Новый Структура("Ассортимент,ЕдиницыИзмерения", СтрокаТовара.Ассортимент, СтрокаТовара.ЕдиницыИзмерения));
        Если Строки.Количество() <> 1 Или Строки[0].Количество <> СтрокаТовара.Количество
            Или Строки[0].ВидАссортимента <> СтрокаТовара.ВидАссортимента Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Процедура ВосстановитьРекомендации(Заявка, Предыдущая)
    СтарыеСтроки = Предыдущая.Товары.Выгрузить();
    НовыеСтроки = Заявка.Товары.Выгрузить();
    Для Каждого СтрокаТовара Из Заявка.Товары Цикл
        Если НовыеСтроки.НайтиСтроки(Новый Структура("Ассортимент,ЕдиницыИзмерения", СтрокаТовара.Ассортимент, СтрокаТовара.ЕдиницыИзмерения)).Количество() > 1 Тогда
            ВызватьИсключение "В автозаявке товар в одной единице укажите одной строкой.";
        КонецЕсли;
        Строки = СтарыеСтроки.НайтиСтроки(Новый Структура("Ассортимент,ЕдиницыИзмерения", СтрокаТовара.Ассортимент, СтрокаТовара.ЕдиницыИзмерения));
        Если Строки.Количество() = 1 Тогда
            ЗаполнитьЗначенияСвойств(СтрокаТовара, Строки[0], "ИТКРекомендовано,ИТКАвтоОстаток,ИТКАвтоВПути,ИТКАвтоПрогноз");
        Иначе
            СтрокаТовара.ИТКРекомендовано = 0;
            СтрокаТовара.ИТКАвтоОстаток = 0;
            СтрокаТовара.ИТКАвтоВПути = 0;
            СтрокаТовара.ИТКАвтоПрогноз = 0;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

#КонецОбласти
