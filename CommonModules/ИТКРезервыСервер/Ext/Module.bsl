	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Товары.Товар КАК Товар, Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| СУММА(Товары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТОтгружено
		|ИЗ Документ.ТоварноТранспортнаяНакладная.Товары КАК Товары
		|ГДЕ Товары.Ссылка.Заявка = &Заявка И Товары.Ссылка.Проведен И Товары.Ссылка <> &ТТН
		|СГРУППИРОВАТЬ ПО Товары.Товар, Товары.ЕдиницыИзмерения
		|;
		|ВЫБРАТЬ Товары.Ассортимент КАК Товар, Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| СУММА(Товары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТЗаявка
		|ИЗ Документ.ЗаявкаТорговойТочки.Товары КАК Товары ГДЕ Товары.Ссылка = &Заявка
		|СГРУППИРОВАТЬ ПО Товары.Ассортимент, Товары.ЕдиницыИзмерения
		|;
		|ВЫБРАТЬ Заявка.Товар КАК Товар, Заявка.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Заявка.Количество - ЕСТЬNULL(Отгрузка.Количество, 0) КАК Количество
		|ИЗ ВТЗаявка КАК Заявка ЛЕВОЕ СОЕДИНЕНИЕ ВТОтгружено КАК Отгрузка
		| ПО Заявка.Товар = Отгрузка.Товар И Заявка.ЕдиницыИзмерения = Отгрузка.ЕдиницыИзмерения
		|ГДЕ Заявка.Количество - ЕСТЬNULL(Отгрузка.Количество, 0) > 0";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("ТТН", ТТН);
	Возврат Запрос.Выполнить().Выгрузить();

