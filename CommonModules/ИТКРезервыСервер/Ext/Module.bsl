#Область ПрограммныйИнтерфейс

// Единый порядок блокировок для заявки, отгрузки и изменения физического остатка.
Процедура ЗаблокироватьУчет() Экспорт

	// Запись документа уже выполняется в транзакции платформы.
	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ИТКОстаткиПартий,ИТКРезервыТоваров", ",") Цикл
		Элемент = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Рассчитывает план резерва и предложения замены до записи заявки.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - проводимая заявка.
//  Отказ - Булево - отказ в записи.
Процедура ПодготовитьЗаявку(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьУчет();
	Если ЕстьОтгрузки(ДокументОбъект.Ссылка) Тогда
		Отказать(Отказ, "По заявке есть проведённые ТТН. Сначала отмените их проведение.");
		Возврат;
	КонецЕсли;
	Если Не ПроверитьЗаявку(ДокументОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	ТаблицаТоваров = ДокументОбъект.Товары.Выгрузить();
	ТаблицаТоваров.Свернуть("Ассортимент,ВидАссортимента,ЕдиницыИзмерения,ИТКАвтоОстаток,ИТКАвтоВПути,ИТКАвтоПрогноз", "Количество,ИТКРекомендовано");
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	ОчиститьДвиженияРезерва(ДокументОбъект);
	ОчиститьРасчетЗаявки(ДокументОбъект);
	Товары = ДокументОбъект.Товары.Выгрузить().ВыгрузитьКолонку("Ассортимент");
	Правила = ПолучитьПравилаЗамены(Товары);
	Для Каждого Правило Из Правила Цикл
		Товары.Добавить(Правило.Замена);
	КонецЦикла;
	Партии = ПолучитьСвободныеПартии(Товары);
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		РаспределитьРезерв(ДокументОбъект, СтрокаТовара, Партии);
	КонецЦикла;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		Если СтрокаТовара.ИТКДефицит > 0 Тогда
			ПредложитьЗамену(СтрокаТовара, Правила, Партии);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает рассчитанные приходы резерва; физический товар остаётся на складе.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - проводимая заявка.
//  Отказ - Булево - отказ в проведении.
Процедура ПровестиЗаявку(ДокументОбъект, Отказ) Экспорт

	Движения = ДокументОбъект.Движения.ИТКРезервыТоваров;
	Движения.Очистить();
	Движения.Записывать = Истина;
	Для Каждого СтрокаПартии Из ДокументОбъект.ИТКРезервы Цикл
		ДобавитьДвижение(Движения, ДокументОбъект, ДокументОбъект.Ссылка,
			СтрокаПартии, ВидДвиженияНакопления.Приход);
	КонецЦикла;
	Движения.Записать();
	ПроверитьОстаткиРезервов(Отказ);

КонецПроцедуры

// Освобождает резерв заявки при отмене проведения.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - отменяемая заявка.
//  Отказ - Булево - отказ в отмене.
Процедура ОтменитьЗаявку(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьУчет();
	Если ЕстьОтгрузки(ДокументОбъект.Ссылка) Тогда
		Отказать(Отказ, "Сначала отмените проведение ТТН этой заявки. После этого её резерв освобождается автоматически.");
		Возврат;
	КонецЕсли;
	ОчиститьДвиженияРезерва(ДокументОбъект);
	ПроверитьОстаткиРезервов(Отказ);

КонецПроцедуры

// Удаляет старый расход резерва своей ТТН и проверяет заявку-основание.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - проводимая ТТН.
//  Отказ - Булево - отказ в записи.
Процедура ПодготовитьТТН(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьУчет();
	Если Не ЗначениеЗаполнено(ДокументОбъект.Заявка) Тогда
		Отказать(Отказ, "Создайте ТТН на основании проведённой заявки торговой точки.");
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Заявка.ТорговаяТочка КАК ТорговаяТочка
		|ИЗ Документ.ЗаявкаТорговойТочки КАК Заявка
		|ГДЕ Заявка.Ссылка = &Заявка И Заявка.Проведен
		| И Заявка.Дата <= &Дата";
	Запрос.УстановитьПараметр("Заявка", ДокументОбъект.Заявка);
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или ДокументОбъект.Дата > ТекущаяДатаСеанса() Тогда
		Отказать(Отказ, "Заявка должна быть проведена; дата ТТН - не раньше заявки и не позже текущего времени.");
		Возврат;
	КонецЕсли;
	ДокументОбъект.ТорговаяТочка = Выборка.ТорговаяТочка;
	ОчиститьДвиженияРезерва(ДокументОбъект);
	Потребность = ПолучитьПотребность(ДокументОбъект.Заявка, ДокументОбъект.Ссылка);
	Товары = ДокументОбъект.Товары.Выгрузить();
	Товары.Свернуть("Товар,ЕдиницыИзмерения", "Количество");
	Для Каждого СтрокаТовара Из Товары Цикл
		СтрокаПотребности = Потребность.НайтиСтроки(Новый Структура("Товар,ЕдиницыИзмерения",
			СтрокаТовара.Товар, СтрокаТовара.ЕдиницыИзмерения));
		Если СтрокаПотребности.Количество() = 0 Тогда
			Отказать(Отказ, "В ТТН есть товар, который отсутствует в неотгруженном остатке заявки.");
			Возврат;
		КонецЕсли;
		Если СтрокаТовара.Количество > СтрокаПотребности[0].Количество Тогда
			Отказать(Отказ, "Количество в ТТН превышает неотгруженный остаток заявки.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает только действующий резерв своей заявки в порядке сроков годности.
// Параметры:
//  МоментОтгрузки - Дата, МоментВремени - граница физических остатков.
//  Товары - Массив - товары ТТН.
//  Заявка - ДокументСсылка.ЗаявкаТорговойТочки - владелец резерва.
// Возвращаемое значение:
//  ТаблицаЗначений - партии и доступное зарезервированное количество.
Функция ПолучитьПартииТТН(МоментОтгрузки, Товары, Заявка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Резервы.Товар КАК Товар, Резервы.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Резервы.Партия КАК Партия, Резервы.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТРезерв
		|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(
		| , Заявка = &Заявка И Товар В (&Товары)) КАК Резервы
		|ГДЕ Резервы.КоличествоОстаток > 0
		|;
		|ВЫБРАТЬ Остатки.Товар КАК Товар, Остатки.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Остатки.Партия КАК Партия, Остатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТФизическийОстаток
		|ИЗ РегистрНакопления.ИТКОстаткиПартий.Остатки(&Граница, Товар В (&Товары)) КАК Остатки
		|;
		|ВЫБРАТЬ Резерв.Товар КАК Товар, Резерв.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Резерв.Партия КАК Партия, Резерв.Партия.НомерПартии КАК НомерПартии,
		| Резерв.Партия.СрокГодности КАК СрокГодности,
		| ВЫБОР КОГДА Резерв.Количество < Остатки.Количество
		|  ТОГДА Резерв.Количество ИНАЧЕ Остатки.Количество КОНЕЦ КАК Количество
		|ИЗ ВТРезерв КАК Резерв
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТФизическийОстаток КАК Остатки
		| ПО Резерв.Товар = Остатки.Товар И Резерв.ЕдиницыИзмерения = Остатки.ЕдиницыИзмерения
		|  И Резерв.Партия = Остатки.Партия
		|ГДЕ Остатки.Количество > 0 И Резерв.Партия.СрокГодности >= &Сегодня
		|УПОРЯДОЧИТЬ ПО СрокГодности, Резерв.Партия.Дата, Партия";
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментОтгрузки, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Снимает резерв ровно по отгруженным партиям; вызывается перед расходом склада.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - проводимая ТТН.
Процедура СнятьРезервТТН(ДокументОбъект) Экспорт

	Движения = ДокументОбъект.Движения.ИТКРезервыТоваров;
	Движения.Очистить();
	Движения.Записывать = Истина;
	Для Каждого СтрокаПартии Из ДокументОбъект.Партии Цикл
		ДобавитьДвижение(Движения, ДокументОбъект, ДокументОбъект.Заявка,
			СтрокаПартии, ВидДвиженияНакопления.Расход);
	КонецЦикла;
	Движения.Записать();

КонецПроцедуры

// Восстанавливает резерв отменяемой ТТН удалением её собственных расходов.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - отменяемая ТТН.
Процедура ВосстановитьРезервТТН(ДокументОбъект) Экспорт

	ОчиститьДвиженияРезерва(ДокументОбъект);

КонецПроцедуры

// Проверяет отсутствие отрицательных резервов и защиты чужих партий.
// Параметры:
//  Отказ - Булево - отказ в изменении документов.
Процедура ПроверитьОстаткиРезервов(Отказ) Экспорт

	Запрос = Новый Запрос;
	// Нужен текущий итог, включая отгрузки, сделанные позже даты изменяемого документа.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Резервы.Партия КАК Партия
		|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(, ) КАК Резервы
		|ГДЕ Резервы.КоличествоОстаток < 0";
	// BSLLS:VirtualTableCallWithoutParameters-on
	Если Не Запрос.Выполнить().Пустой() Тогда
		Отказать(Отказ, "Нельзя отгрузить больше зарезервированного количества. Изменение отменено.");
		Возврат;
	КонецЕсли;
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
		"ВЫБРАТЬ Резервы.Товар КАК Товар, Резервы.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Резервы.Партия КАК Партия, СУММА(Резервы.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ ВТРезервы
		|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(,
		| Партия В (ВЫБРАТЬ Приемка.Ссылка КАК Партия ИЗ Документ.ИТКПриемкаПартии КАК Приемка
		|  ГДЕ Приемка.СрокГодности >= &Сегодня)) КАК Резервы
		|СГРУППИРОВАТЬ ПО Резервы.Товар, Резервы.ЕдиницыИзмерения, Резервы.Партия
		|;
		|ВЫБРАТЬ Остатки.Товар КАК Товар, Остатки.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Остатки.Партия КАК Партия, Остатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ РегистрНакопления.ИТКОстаткиПартий.Остатки(, ) КАК Остатки
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 1 Резервы.Партия КАК Партия
		|ИЗ ВТРезервы КАК Резервы
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Остатки
		| ПО Резервы.Товар = Остатки.Товар И Резервы.ЕдиницыИзмерения = Остатки.ЕдиницыИзмерения
		|  И Резервы.Партия = Остатки.Партия
		|ГДЕ Резервы.Количество > ЕСТЬNULL(Остатки.Количество, 0)";
	// BSLLS:VirtualTableCallWithoutParameters-on
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Если Не Запрос.Выполнить().Пустой() Тогда
		Отказать(Отказ, "Количество партии уже зарезервировано. Сначала освободите резерв соответствующей заявки.");
	КонецЕсли;

КонецПроцедуры

// Заполняет новую ТТН оставшимся действующим резервом и отпускными ценами.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - новая ТТН.
//  Заявка - ДокументСсылка.ЗаявкаТорговойТочки - заявка-основание.
Процедура ЗаполнитьТТН(ДокументОбъект, Заявка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Резервы.Товар КАК Товар, Резервы.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| СУММА(Резервы.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ ВТТовары
		|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(, Заявка = &Заявка) КАК Резервы
		|ГДЕ Резервы.КоличествоОстаток > 0 И Резервы.Партия.СрокГодности >= &Сегодня
		|СГРУППИРОВАТЬ ПО Резервы.Товар, Резервы.ЕдиницыИзмерения
		|;
		|ВЫБРАТЬ Цены.Товар КАК Товар, Цены.Цена КАК Цена
		|ПОМЕСТИТЬ ВТЦены
		|ИЗ РегистрСведений.ОтпускныеЦены.СрезПоследних(
		| &Дата, Товар В (ВЫБРАТЬ Товар КАК Товар ИЗ ВТТовары)) КАК Цены
		|;
		|ВЫБРАТЬ Товары.Товар КАК Товар, Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Товары.Количество КАК Количество, ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
		| Товары.Количество * ЕСТЬNULL(Цены.Цена, 0) КАК Сумма
		|ИЗ ВТТовары КАК Товары ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Цены ПО Товары.Товар = Цены.Товар";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	ДокументОбъект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	ИТКМаржаСервер.ПересчитатьЦеныТТН(ДокументОбъект);
	Если ДокументОбъект.Товары.Количество() = 0 Тогда
		ПоказатьСообщениеРезерва("У заявки нет действующего неотгруженного резерва. Проверьте отчёт и перепроведите заявку без ТТН для нового расчёта.");
	КонецЕсли;

КонецПроцедуры

// Применяет предложенные количества замен в памяти; запись остаётся за формой.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - изменяемая заявка.
// Возвращаемое значение:
//  Булево - есть изменения для повторного проведения.
Функция ПрименитьЗамены(ДокументОбъект) Экспорт

	Замены = ДокументОбъект.Товары.Выгрузить().ВыгрузитьКолонку("ИТКЗамена");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Товары.Ссылка КАК Ссылка, Товары.ВидАссортимента КАК ВидАссортимента
		|ИЗ Справочник.Ассортимент КАК Товары ГДЕ Товары.Ссылка В (&Замены)";
	Запрос.УстановитьПараметр("Замены", Замены);
	ДанныеЗамен = Запрос.Выполнить().Выгрузить();
	НовыеТовары = ДокументОбъект.Товары.Выгрузить();
	НовыеТовары.Очистить();
	Изменено = Ложь;
	Для Каждого ИсходнаяСтрока Из ДокументОбъект.Товары Цикл
		КоличествоЗамены = Мин(ИсходнаяСтрока.ИТККоличествоЗамены, ИсходнаяСтрока.ИТКДефицит);
		ОписаниеЗамены = ДанныеЗамен.Найти(ИсходнаяСтрока.ИТКЗамена, "Ссылка");
		Если ОписаниеЗамены = Неопределено Тогда
			КоличествоЗамены = 0;
		КонецЕсли;
		Если ИсходнаяСтрока.Количество - КоличествоЗамены > 0 Тогда
			СтрокаТовара = НовыеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходнаяСтрока);
			СтрокаТовара.Количество = ИсходнаяСтрока.Количество - КоличествоЗамены;
		КонецЕсли;
		Если КоличествоЗамены > 0 Тогда
			СтрокаТовара = НовыеТовары.Добавить();
			СтрокаТовара.Ассортимент = ИсходнаяСтрока.ИТКЗамена;
			СтрокаТовара.ВидАссортимента = ОписаниеЗамены.ВидАссортимента;
			СтрокаТовара.ЕдиницыИзмерения = ИсходнаяСтрока.ЕдиницыИзмерения;
			СтрокаТовара.Количество = КоличествоЗамены;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Изменено Тогда
		ДокументОбъект.Товары.Загрузить(НовыеТовары);
	КонецЕсли;
	Возврат Изменено;

КонецФункции

// Очищает отображаемые расчёты при сохранении непроведённой заявки или отмене.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаявкаТорговойТочки - заявка.
Процедура ОчиститьРасчетЗаявки(ДокументОбъект) Экспорт

	ДокументОбъект.ИТКРезервы.Очистить();
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		СтрокаТовара.ИТКРезерв = 0;
		СтрокаТовара.ИТКОтгружено = 0;
		СтрокаТовара.ИТКДефицит = 0;
		СтрокаТовара.ИТКЗамена = Справочники.Ассортимент.ПустаяСсылка();
		СтрокаТовара.ИТККоличествоЗамены = 0;
	КонецЦикла;

КонецПроцедуры

// Текущее состояние для формы; не изменяет документ и движения.
// Параметры:
//  Заявка - ДокументСсылка.ЗаявкаТорговойТочки - открываемая заявка.
// Возвращаемое значение:
//  ТаблицаЗначений - товар, единица, отгружено и зарезервировано.
Функция ПолучитьСостояниеЗаявки(Заявка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Товары.Товар КАК Товар, Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| СУММА(Товары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТОтгружено
		|ИЗ Документ.ТоварноТранспортнаяНакладная.Товары КАК Товары
		|ГДЕ Товары.Ссылка.Заявка = &Заявка И Товары.Ссылка.Проведен
		|СГРУППИРОВАТЬ ПО Товары.Товар, Товары.ЕдиницыИзмерения
		|;
		|ВЫБРАТЬ Резервы.Товар КАК Товар, Резервы.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| СУММА(Резервы.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ ВТРезерв
		|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(, Заявка = &Заявка) КАК Резервы
		|ГДЕ Резервы.Партия.СрокГодности >= &Сегодня
		|СГРУППИРОВАТЬ ПО Резервы.Товар, Резервы.ЕдиницыИзмерения
		|;
		|ВЫБРАТЬ Товары.Ассортимент КАК Товар, Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| ЕСТЬNULL(Отгружено.Количество, 0) КАК Отгружено,
		| ЕСТЬNULL(Резерв.Количество, 0) КАК Зарезервировано
		|ИЗ Документ.ЗаявкаТорговойТочки.Товары КАК Товары
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТОтгружено КАК Отгружено
		| ПО Товары.Ассортимент = Отгружено.Товар И Товары.ЕдиницыИзмерения = Отгружено.ЕдиницыИзмерения
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТРезерв КАК Резерв
		| ПО Товары.Ассортимент = Резерв.Товар И Товары.ЕдиницыИзмерения = Резерв.ЕдиницыИзмерения
		|ГДЕ Товары.Ссылка = &Заявка";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьЗаявку(ДокументОбъект, Отказ)

	Если Не ЗначениеЗаполнено(ДокументОбъект.ТорговаяТочка)
		Или Не ЗначениеЗаполнено(ДокументОбъект.Продавец)
		Или ДокументОбъект.Товары.Количество() = 0
		Или ДокументОбъект.Дата > ТекущаяДатаСеанса() Тогда
		Отказать(Отказ, "Заполните точку, продавца и товары. Дата заявки не должна быть позже текущего времени.");
		Возврат Ложь;
	КонецЕсли;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Ассортимент)
			Или Не ЗначениеЗаполнено(СтрокаТовара.ЕдиницыИзмерения)
			Или СтрокаТовара.Количество <= 0 Тогда
			Отказать(Отказ, "Укажите в каждой строке товар, единицу и положительное количество.");
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Результат = ИТКАссортиментСервер.ПроверитьЗаявку(ДокументОбъект);
	Для Каждого ТекстСообщения Из Результат.Сообщения Цикл
		ПоказатьСообщениеРезерва(ТекстСообщения);
	КонецЦикла;
	Если Не Результат.Успех Тогда
		Отказ = Истина;
	КонецЕсли;
	Возврат Результат.Успех;

КонецФункции

Функция ЕстьОтгрузки(Заявка)

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ТТН.Ссылка КАК Ссылка
		|ИЗ Документ.ТоварноТранспортнаяНакладная КАК ТТН ГДЕ ТТН.Заявка = &Заявка И ТТН.Проведен";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Возврат Не Запрос.Выполнить().Пустой();

