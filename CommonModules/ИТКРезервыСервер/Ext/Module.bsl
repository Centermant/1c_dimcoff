Процедура ДобавитьДвижение(Движения, ДокументОбъект, Заявка, СтрокаПартии, ВидДвижения)

	Движение = Движения.Добавить();
	Движение.Период = ДокументОбъект.Дата;
	Движение.ВидДвижения = ВидДвижения;
	Движение.Заявка = Заявка;
	Движение.Товар = СтрокаПартии.Товар;
	Движение.ЕдиницыИзмерения = СтрокаПартии.ЕдиницыИзмерения;
	Движение.Партия = СтрокаПартии.Партия;
	Движение.Количество = СтрокаПартии.Количество;

КонецПроцедуры

Функция ПолучитьПравилаЗамены(Товары)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Правила.Товар КАК Товар, Правила.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Правила.Замена КАК Замена, Правила.Приоритет КАК Приоритет
		|ИЗ РегистрСведений.ИТКЗаменыАссортимента КАК Правила
		|ГДЕ Правила.Товар В (&Товары) И Правила.Товар <> Правила.Замена
		|УПОРЯДОЧИТЬ ПО Приоритет, Замена";
	Запрос.УстановитьПараметр("Товары", Товары);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьСвободныеПартии(Товары)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Резервы.Товар КАК Товар, Резервы.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Резервы.Партия КАК Партия, СУММА(Резервы.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ ВТРезервы
		|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(, Товар В (&Товары)) КАК Резервы
		|СГРУППИРОВАТЬ ПО Резервы.Товар, Резервы.ЕдиницыИзмерения, Резервы.Партия
		|;
		|ВЫБРАТЬ Остатки.Товар КАК Товар, Остатки.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Остатки.Партия КАК Партия, Остатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ РегистрНакопления.ИТКОстаткиПартий.Остатки(&Момент, Товар В (&Товары)) КАК Остатки
		|;
		|ВЫБРАТЬ Остатки.Товар КАК Товар, Остатки.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Остатки.Партия КАК Партия, Остатки.Партия.НомерПартии КАК НомерПартии,
		| Остатки.Партия.СрокГодности КАК СрокГодности,
		| Остатки.Количество - ЕСТЬNULL(Резервы.Количество, 0) КАК Количество
		|ИЗ ВТОстатки КАК Остатки ЛЕВОЕ СОЕДИНЕНИЕ ВТРезервы КАК Резервы
		| ПО Остатки.Товар = Резервы.Товар И Остатки.ЕдиницыИзмерения = Резервы.ЕдиницыИзмерения
		|  И Остатки.Партия = Резервы.Партия
		|ГДЕ Остатки.Количество - ЕСТЬNULL(Резервы.Количество, 0) > 0
		| И Остатки.Партия.СрокГодности >= &Сегодня И Остатки.Партия.Проведен
		|УПОРЯДОЧИТЬ ПО СрокГодности, Остатки.Партия.Дата, Партия";
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Момент", Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура РаспределитьРезерв(ДокументОбъект, СтрокаТовара, Партии)

	Нужно = СтрокаТовара.Количество;
	Отбор = Новый Структура("Товар,ЕдиницыИзмерения", СтрокаТовара.Ассортимент, СтрокаТовара.ЕдиницыИзмерения);
	Для Каждого Партия Из Партии.НайтиСтроки(Отбор) Цикл
		Если Нужно = 0 Тогда
			Прервать;
		КонецЕсли;
		Количество = Мин(Нужно, Партия.Количество);
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРезерва = ДокументОбъект.ИТКРезервы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезерва, Партия);
		СтрокаРезерва.Количество = Количество;
		Партия.Количество = Партия.Количество - Количество;
		Нужно = Нужно - Количество;
	КонецЦикла;
	СтрокаТовара.ИТКРезерв = СтрокаТовара.Количество - Нужно;
	СтрокаТовара.ИТКДефицит = Нужно;

КонецПроцедуры

Процедура ПредложитьЗамену(СтрокаТовара, Правила, Партии)

	Отбор = Новый Структура("Товар,ЕдиницыИзмерения", СтрокаТовара.Ассортимент, СтрокаТовара.ЕдиницыИзмерения);
	Для Каждого Правило Из Правила.НайтиСтроки(Отбор) Цикл
		ОтборПартий = Новый Структура("Товар,ЕдиницыИзмерения", Правило.Замена, Правило.ЕдиницыИзмерения);
		СвободныеПартии = Партии.НайтиСтроки(ОтборПартий);
		Количество = 0;
		Для Каждого Партия Из СвободныеПартии Цикл
			Количество = Количество + Партия.Количество;
		КонецЦикла;
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара.ИТКЗамена = Правило.Замена;
		СтрокаТовара.ИТККоличествоЗамены = Мин(Количество, СтрокаТовара.ИТКДефицит);
		// Предложение не является резервом, но один остаток не предлагаем дважды в одной заявке.
		Нужно = СтрокаТовара.ИТККоличествоЗамены;
		Для Каждого Партия Из СвободныеПартии Цикл
			Количество = Мин(Нужно, Партия.Количество);
			Партия.Количество = Партия.Количество - Количество;
			Нужно = Нужно - Количество;
		КонецЦикла;
		Прервать;
	КонецЦикла;
	Текст = СтрШаблон("%1: зарезервировано %2 из %3; дефицит %4 %5.",
		СтрокаТовара.Ассортимент, СтрокаТовара.ИТКРезерв, СтрокаТовара.Количество,
		СтрокаТовара.ИТКДефицит, СтрокаТовара.ЕдиницыИзмерения);
	Если ЗначениеЗаполнено(СтрокаТовара.ИТКЗамена) Тогда
		Текст = Текст + СтрШаблон(" Предложена замена: %1, количество %2. Нажмите «Применить предложенные замены».",
			СтрокаТовара.ИТКЗамена, СтрокаТовара.ИТККоличествоЗамены);
	Иначе
		Текст = Текст + " Доступная допустимая замена не найдена; скорректируйте заявку или ожидайте поступления.";
	КонецЕсли;
	ПоказатьСообщениеРезерва(Текст);

КонецПроцедуры

