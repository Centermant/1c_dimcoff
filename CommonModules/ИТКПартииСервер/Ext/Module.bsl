#Область ПрограммныйИнтерфейс

// Проверяет реквизиты приёмки и запрещает изменение описания использованной партии.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ИТКПриемкаПартии - проверяемая приёмка.
//  Отказ - Булево - признак отказа в записи.
Процедура ПроверитьПриемку(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьОстатки();

	Если Не ЗначениеЗаполнено(ДокументОбъект.Товар)
		Или Не ЗначениеЗаполнено(ДокументОбъект.ЕдиницыИзмерения)
		Или ПустаяСтрока(ДокументОбъект.НомерПартии)
		Или Не ЗначениеЗаполнено(ДокументОбъект.СрокГодности)
		Или ДокументОбъект.Количество <= 0 Тогда
		Отказ = Истина;
		СообщитьПричину("Заполните товар, единицу измерения, номер и срок годности партии; количество должно быть больше нуля.");
		Возврат;
	КонецЕсли;

	ДокументОбъект.СрокГодности = НачалоДня(ДокументОбъект.СрокГодности);
	Если ДокументОбъект.СрокГодности < НачалоДня(ДокументОбъект.Дата) Тогда
		Отказ = Истина;
		СообщитьПричину("Срок годности не может быть раньше даты приёмки.");
		Возврат;
	КонецЕсли;
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Приемка.Товар КАК Товар,
		| Приемка.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
		| Приемка.Дата КАК Дата,
		| Приемка.НомерПартии КАК НомерПартии,
		| Приемка.СрокГодности КАК СрокГодности
		|ИЗ
		| Документ.ИТКПриемкаПартии КАК Приемка
		|ГДЕ
		| Приемка.Ссылка = &Ссылка
		| И (Приемка.Ссылка В
		|  (ВЫБРАТЬ Движения.Партия КАК Партия
		|   ИЗ РегистрНакопления.ИТКОстаткиПартий КАК Движения
		|   ГДЕ Движения.Партия = &Ссылка
		|    И Движения.Активность
		|    И Движения.ВидДвижения = &Расход)
		|  ИЛИ Приемка.Ссылка В
		|   (ВЫБРАТЬ Резервы.Партия КАК Партия
		|    ИЗ РегистрНакопления.ИТКРезервыТоваров КАК Резервы
		|    ГДЕ Резервы.Партия = &Ссылка И Резервы.Активность))";
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Товар <> ДокументОбъект.Товар
			Или Выборка.ЕдиницыИзмерения <> ДокументОбъект.ЕдиницыИзмерения
			Или Выборка.Дата <> ДокументОбъект.Дата
			Или Выборка.НомерПартии <> ДокументОбъект.НомерПартии
			Или Выборка.СрокГодности <> ДокументОбъект.СрокГодности Тогда
			Отказ = Истина;
			СообщитьПричину("Партия уже использована. Изменять её товар, единицу, дату, номер и срок годности нельзя.");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Подбирает партии перед записью проводимой ТТН.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - проводимая ТТН.
//  Отказ - Булево - признак отказа в записи.
Процедура ПодготовитьТТН(ДокументОбъект, Отказ) Экспорт

	ИТКРезервыСервер.ПодготовитьТТН(ДокументОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьОстатки();
	УдалитьСтарыеДвижения(ДокументОбъект);
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
	КонецЦикла;
	План = ПодобратьПартии(ДокументОбъект);
	Если Не План.Успех Тогда
		Отказ = Истина;
		Для Каждого ТекстСообщения Из План.Сообщения Цикл
			СообщитьПричину(ТекстСообщения);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	ДокументОбъект.Партии.Загрузить(План.Партии);
	Для Каждого ТекстСообщения Из План.Сообщения Цикл
		СообщитьПричину(ТекстСообщения);
	КонецЦикла;

КонецПроцедуры

// Записывает приход одной партии.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ИТКПриемкаПартии - проводимая приёмка.
//  Отказ - Булево - признак отказа в проведении.
Процедура ПровестиПриемку(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьОстатки();
	Движения = ДокументОбъект.Движения.ИТКОстаткиПартий;
	Движения.Очистить();
	Движения.Записывать = Истина;
	Движение = Движения.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = ДокументОбъект.Дата;
	Движение.Товар = ДокументОбъект.Товар;
	Движение.ЕдиницыИзмерения = ДокументОбъект.ЕдиницыИзмерения;
	Движение.Партия = ДокументОбъект.Ссылка;
	Движение.Количество = ДокументОбъект.Количество;
	Движения.Записать();
	ПроверитьНеотрицательныеОстатки(Отказ);

КонецПроцедуры

// Записывает расход подобранных партий при проведении ТТН.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - проводимая ТТН.
//  Отказ - Булево - признак отказа в проведении.
Процедура ПровестиТТН(ДокументОбъект, Отказ) Экспорт

	ИТКРезервыСервер.СнятьРезервТТН(ДокументОбъект);
	Движения = ДокументОбъект.Движения.ИТКОстаткиПартий;
	Движения.Очистить();
	Движения.Записывать = Истина;
	Для Каждого СтрокаПартии Из ДокументОбъект.Партии Цикл
		Движение = Движения.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ДокументОбъект.Дата;
		Движение.Товар = СтрокаПартии.Товар;
		Движение.ЕдиницыИзмерения = СтрокаПартии.ЕдиницыИзмерения;
		Движение.Партия = СтрокаПартии.Партия;
		Движение.Количество = СтрокаПартии.Количество;
	КонецЦикла;
	Движения.Записать();
	ПроверитьНеотрицательныеОстатки(Отказ);

КонецПроцедуры

// Проверяет списание и рассчитывает оценку по отпускной цене на дату документа.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ИТКСписаниеПартий - проверяемое списание.
//  Отказ - Булево - признак отказа в записи.
Процедура ПроверитьСписание(ДокументОбъект, Отказ) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.Партия)
		Или ДокументОбъект.Количество <= 0
		Или ПустаяСтрока(ДокументОбъект.Причина)
		Или ДокументОбъект.ПроцентУценки < 0
		Или ДокументОбъект.ПроцентУценки > 100 Тогда
		Отказ = Истина;
		СообщитьПричину("Укажите партию, положительное количество и причину. Уценка должна быть от 0 до 100%.");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Цены.Товар КАК Товар, Цены.Цена КАК Цена
		|ПОМЕСТИТЬ ВТЦенаСписания
		|ИЗ РегистрСведений.ОтпускныеЦены.СрезПоследних(
		|  &Дата, Товар В
		|   (ВЫБРАТЬ Партия.Товар КАК Товар
		|    ИЗ Документ.ИТКПриемкаПартии КАК Партия
		|    ГДЕ Партия.Ссылка = &Партия)) КАК Цены
		|;
		|ВЫБРАТЬ Приемка.Товар КАК Товар, Цены.Цена КАК Цена
		|ИЗ Документ.ИТКПриемкаПартии КАК Приемка
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТЦенаСписания КАК Цены
		| ПО Приемка.Товар = Цены.Товар
		|ГДЕ Приемка.Ссылка = &Партия И Приемка.Проведен
		| И Приемка.Дата <= &Дата";
	Запрос.УстановитьПараметр("Партия", ДокументОбъект.Партия);
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Отказ = Истина;
		СообщитьПричину("Выберите проведённую приёмку с датой не позже даты списания.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Цена) Тогда
		Отказ = Истина;
		СообщитьПричину("Для товара " + Строка(Выборка.Товар)
			+ " нет положительной отпускной цены на дату списания. Установите её документом «Ценообразование».");
		Возврат;
	КонецЕсли;
	Если Выборка.Цена <= 0 Тогда
		Отказ = Истина;
		СообщитьПричину("Отпускная цена товара на дату списания должна быть больше нуля.");
		Возврат;
	КонецЕсли;
	ДокументОбъект.ОценочнаяЦена = ИТКМаржаСервер.ПолучитьЦенуДляЕдиницы(
		ДокументОбъект.Партия.Товар, ДокументОбъект.Партия.ЕдиницыИзмерения, ДокументОбъект.Дата);
	ДокументОбъект.СуммаПослеУценки = Окр(ДокументОбъект.Количество
		* ДокументОбъект.ОценочнаяЦена * (100 - ДокументОбъект.ПроцентУценки) / 100, 2);

КонецПроцедуры

// Списывает количество из указанной партии.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ИТКСписаниеПартий - проводимое списание.
//  Отказ - Булево - признак отказа в проведении.
Процедура ПровестиСписание(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьОстатки();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Приемка.Товар КАК Товар,
		| Приемка.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ИЗ Документ.ИТКПриемкаПартии КАК Приемка
		|ГДЕ Приемка.Ссылка = &Партия И Приемка.Проведен
		| И Приемка.Дата <= &Дата";
	Запрос.УстановитьПараметр("Партия", ДокументОбъект.Партия);
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Отказ = Истина;
		СообщитьПричину("Выберите проведённую приёмку с датой не позже даты списания.");
		Возврат;
	КонецЕсли;
	Движения = ДокументОбъект.Движения.ИТКОстаткиПартий;
	Движения.Очистить();
	Движения.Записывать = Истина;
	Движение = Движения.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = ДокументОбъект.Дата;
	Движение.Товар = Выборка.Товар;
	Движение.ЕдиницыИзмерения = Выборка.ЕдиницыИзмерения;
	Движение.Партия = ДокументОбъект.Партия;
	Движение.Количество = ДокументОбъект.Количество;
	Движения.Записать();
	ПроверитьНеотрицательныеОстатки(Отказ);

КонецПроцедуры

// Удаляет движения в транзакции отмены проведения и проверяет остатки.
// Параметры:
//  ДокументОбъект - ДокументОбъект - один из трёх регистраторов партий.
//  Отказ - Булево - признак отказа в отмене проведения.
Процедура ОтменитьДвижения(ДокументОбъект, Отказ) Экспорт

	ЗаблокироватьОстатки();
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ТоварноТранспортнаяНакладная") Тогда
		ИТКРезервыСервер.ВосстановитьРезервТТН(ДокументОбъект);
	КонецЕсли;
	УдалитьСтарыеДвижения(ДокументОбъект);
	ПроверитьНеотрицательныеОстатки(Отказ);

КонецПроцедуры

// Заполняет ТТН товарами заявки и действующими отпускными ценами.
// Параметры:
//  ДокументОбъект - ДокументОбъект.ТоварноТранспортнаяНакладная - заполняемая ТТН.
//  Заявка - ДокументСсылка.ЗаявкаТорговойТочки - документ-основание.
Процедура ЗаполнитьИзЗаявки(ДокументОбъект, Заявка) Экспорт

	ИТКРезервыСервер.ЗаполнитьТТН(ДокументОбъект, Заявка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодобратьПартии(ДокументОбъект)

	Партии = ДокументОбъект.Партии.Выгрузить();
	Партии.Очистить();
	Результат = Новый Структура("Успех,Партии,Сообщения", Истина, Партии, Новый Массив);
	Потребность = ДокументОбъект.Товары.Выгрузить();
	Если Не ПроверитьТоварыТТН(Потребность, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	Товары = Новый Массив;
	Для Каждого СтрокаТовара Из Потребность Цикл
		Товары.Добавить(СтрокаТовара.Товар);
	КонецЦикла;
	Потребность.Свернуть("Товар,ЕдиницыИзмерения", "Количество");
	МоментОтгрузки = ДокументОбъект.Дата;
	Если Не ДокументОбъект.ЭтоНовый() Тогда
		МоментОтгрузки = ДокументОбъект.МоментВремени();
	КонецЕсли;
	Остатки = ПолучитьОстаткиПартий(МоментОтгрузки, Товары, ДокументОбъект.Заявка);
	ДеньОтгрузки = НачалоДня(ДокументОбъект.Дата);
	ГраницаПредупреждения = ДеньОтгрузки + 7 * 24 * 60 * 60;
	Для Каждого СтрокаПотребности Из Потребность Цикл
		Нужно = СтрокаПотребности.Количество;
		Отбор = Новый Структура("Товар,ЕдиницыИзмерения",
			СтрокаПотребности.Товар, СтрокаПотребности.ЕдиницыИзмерения);
		Для Каждого Остаток Из Остатки.НайтиСтроки(Отбор) Цикл
			Если Остаток.СрокГодности < ДеньОтгрузки Тогда
				Продолжить;
			КонецЕсли;
			Количество = Мин(Нужно, Остаток.Количество);
			СтрокаПартии = Партии.Добавить();
			СтрокаПартии.Товар = Остаток.Товар;
			СтрокаПартии.ЕдиницыИзмерения = Остаток.ЕдиницыИзмерения;
			СтрокаПартии.Партия = Остаток.Партия;
			СтрокаПартии.НомерПартии = Остаток.НомерПартии;
			СтрокаПартии.СрокГодности = Остаток.СрокГодности;
			СтрокаПартии.Количество = Количество;
			ПредупредитьОСроке(Результат, Остаток, ГраницаПредупреждения);
			Нужно = Нужно - Количество;
			Если Нужно = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Нужно > 0 Тогда
			Результат.Успех = Ложь;
			Результат.Сообщения.Добавить(СтрШаблон(
				"Для товара %1 не хватает %2 %3 действующего резерва этой заявки. Чужие и просроченные партии не используются.",
				СтрокаПотребности.Товар, Нужно, СтрокаПотребности.ЕдиницыИзмерения));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПредупредитьОСроке(Результат, Остаток, ГраницаПредупреждения)

	Если Остаток.СрокГодности <= ГраницаПредупреждения Тогда
		Текст = СтрШаблон("Партия %1: срок годности до %2. Она отгружается первой. "
			+ "Альтернатива: оформите «Списание партий» с уценкой.",
			Остаток.НомерПартии, Формат(Остаток.СрокГодности, "ДФ=dd.MM.yyyy"));
		Результат.Сообщения.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьТоварыТТН(Товары, Результат)

	Если Товары.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить("Добавьте товары в ТТН.");
		Возврат Ложь;
	КонецЕсли;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если СтрокаТовара.Цена <= 0 Тогда
			Результат.Успех = Ложь;
			Результат.Сообщения.Добавить("Для товара ТТН не задана положительная цена. Установите её документом «Ценообразование».");
			Возврат Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар)
			Или Не ЗначениеЗаполнено(СтрокаТовара.ЕдиницыИзмерения)
			Или СтрокаТовара.Количество <= 0 Тогда
			Результат.Успех = Ложь;
			Результат.Сообщения.Добавить("В каждой строке ТТН укажите товар, единицу и количество больше нуля.");
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПолучитьОстаткиПартий(МоментОтгрузки, Товары, Заявка)

	Возврат ИТКРезервыСервер.ПолучитьПартииТТН(МоментОтгрузки, Товары, Заявка);

КонецФункции

Процедура ЗаблокироватьОстатки()

	ИТКРезервыСервер.ЗаблокироватьУчет();

КонецПроцедуры

Процедура УдалитьСтарыеДвижения(ДокументОбъект)

	// До первой записи у документа нет прежних движений.
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	// При отказе платформа откатывает эту запись вместе со всей транзакцией.
	Движения = ДокументОбъект.Движения.ИТКОстаткиПартий;
	Движения.Очистить();
	Движения.Записывать = Истина;
	Движения.Записать();

КонецПроцедуры

Процедура ПроверитьНеотрицательныеОстатки(Отказ)

	Запрос = Новый Запрос;
	// Проверяется общий итог регистра после записи движений, без ограничения даты.
	// BSLLS:VirtualTableCallWithoutParameters-off
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Партия.НомерПартии КАК НомерПартии
		|ИЗ РегистрНакопления.ИТКОстаткиПартий.Остатки(, ) КАК Остатки
		|ГДЕ Остатки.КоличествоОстаток < 0";
	// BSLLS:VirtualTableCallWithoutParameters-on
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отказ = Истина;
		СообщитьПричину(СтрШаблон("Недостаточно остатка партии %1. Изменение отменено.", Выборка.НомерПартии));
	КонецЕсли;

	Если Не Отказ Тогда
		ИТКРезервыСервер.ПроверитьОстаткиРезервов(Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьПричину(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
