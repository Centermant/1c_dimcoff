#Область ПрограммныйИнтерфейс

// Создаёт редактируемые заказы по строкам текущего отчёта.
// Параметры:
//  ВыбранныеСтроки - ТаблицаЗначений - Заявка, Ассортимент, ЕдиницыИзмерения.
// Возвращаемое значение:
//  Массив из ДокументСсылка.ИТКЗаказПоставщику - новые заказы.
Функция СформироватьЗаказы(ВыбранныеСтроки) Экспорт

	Результат = Новый Массив;
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗакупки();
		Момент = ТекущаяДатаСеанса();
		Потребности = ПолучитьПотребности(Момент, Документы.ИТКЗаказПоставщику.ПустаяСсылка());
		Отбор = Новый Структура("Заявка,Ассортимент,ЕдиницыИзмерения");
		План = Потребности.СкопироватьКолонки();
		Для Каждого СтрокаПотребности Из Потребности Цикл
			Отбор.Заявка = СтрокаПотребности.Заявка;
			Отбор.Ассортимент = СтрокаПотребности.Товар;
			Отбор.ЕдиницыИзмерения = СтрокаПотребности.ЕдиницыИзмерения;
			Если СтрокаПотребности.КЗакупке > 0 И ВыбранныеСтроки.НайтиСтроки(Отбор).Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(План.Добавить(), СтрокаПотребности);
			КонецЕсли;
		КонецЦикла;
		Если План.Количество() > 0 Тогда
			Условия = ПолучитьУсловия(Момент);
			Заказы = ПостроитьЗаказы(План, Условия, Момент);
			// Все условия проверены до первой записи; транзакция защищает весь пакет.
			Для Каждого Заказ Из Заказы Цикл
				Заказ.Записать();
				Результат.Добавить(Заказ.Ссылка);
			КонецЦикла;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Пересчитывает суммы и распределение при любой записи, включая программную.
// Параметры:
//  Заказ - ДокументОбъект.ИТКЗаказПоставщику - записываемый заказ.
Процедура ПодготовитьЗаказ(Заказ) Экспорт

	ЗаблокироватьЗакупки();
	Если Не ЗначениеЗаполнено(Заказ.Состояние) Тогда
		Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Подготовлен;
	КонецЕсли;
	ПроверитьРедактированиеЗаказа(Заказ);
	ВосстановитьИсториюРаспределения(Заказ);
	Если Не ЗначениеЗаполнено(Заказ.Поставщик) Или Не ЗначениеЗаполнено(Заказ.Валюта) Тогда
		ВызватьИсключение "В заказе должны быть заполнены поставщик и валюта закупки.";
	КонецЕсли;
	Если Заказ.Товары.Количество() = 0 Тогда
		ВызватьИсключение "В заказе нет товаров.";
	КонецЕсли;
	Заказ.СуммаДокумента = 0;
	Для Каждого СтрокаТовара Из Заказ.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар)
			Или Не ЗначениеЗаполнено(СтрокаТовара.ЕдиницыИзмерения)
			Или СтрокаТовара.Количество <= 0 Или СтрокаТовара.Цена <= 0 Тогда
			ВызватьИсключение "Заполните товар и единицу; количество и закупочная цена должны быть больше нуля.";
		КонецЕсли;
		СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
		Заказ.СуммаДокумента = Заказ.СуммаДокумента + СтрокаТовара.Сумма;
	КонецЦикла;
	Товары = Заказ.Товары.Выгрузить();
	Товары.Свернуть("Товар,ЕдиницыИзмерения", "Количество");
	Если Товары.Количество() <> Заказ.Товары.Количество() Тогда
		ВызватьИсключение "Один товар в одной единице должен занимать одну строку заказа.";
	КонецЕсли;
	Если Заказ.ПометкаУдаления Или Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Отменен
		Или Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Завершен Тогда
		Если Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Завершен Тогда
			Заказ.Распределение.Очистить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Заказ.Заявки.Количество() = 0 Тогда
		ВызватьИсключение "Заказ создаётся кнопкой «Сформировать заказы поставщикам» в консолидированном отчёте.";
	КонецЕсли;
	Потребности = ПолучитьПотребности(ТекущаяДатаСеанса(), Заказ.Ссылка);
	НовоеРаспределение = Заказ.Распределение.Выгрузить();
	НовоеРаспределение.Очистить();
	Принято = ПолучитьПриемкиЗаказа(Заказ.Ссылка);
	ОтборТовара = Новый Структура("Товар,ЕдиницыИзмерения");
	ОтборЗаявки = Новый Структура("Заявка");
	Для Каждого СтрокаТовара Из Заказ.Товары Цикл
		ОтборТовара.Товар = СтрокаТовара.Товар;
		ОтборТовара.ЕдиницыИзмерения = СтрокаТовара.ЕдиницыИзмерения;
		Осталось = СтрокаТовара.Количество - КоличествоПринято(Принято, СтрокаТовара.Товар, СтрокаТовара.ЕдиницыИзмерения);
		Для Каждого Потребность Из Потребности.НайтиСтроки(ОтборТовара) Цикл
			ОтборЗаявки.Заявка = Потребность.Заявка;
			Если Заказ.Заявки.НайтиСтроки(ОтборЗаявки).Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Количество = Мин(Осталось, Потребность.КЗакупке);
			Если Количество > 0 Тогда
				СтрокаРаспределения = НовоеРаспределение.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Потребность, "Заявка,Товар,ЕдиницыИзмерения");
				СтрокаРаспределения.Количество = Количество;
				Осталось = Осталось - Количество;
			КонецЕсли;
		КонецЦикла;
		// Дополнительное количество допускается: оно учитывается как свободное ожидаемое поступление.
	КонецЦикла;
	Заказ.Распределение.Загрузить(НовоеРаспределение);
	ЗафиксироватьИсториюРаспределения(Заказ);

КонецПроцедуры


// Возвращает остаток выбранной строки для стандартной формы приёмки.
Функция ЗаполнениеПриемки(СсылкаЗаказа, Товар, ЕдиницыИзмерения) Экспорт

	Заказ = СсылкаЗаказа.ПолучитьОбъект();
	Если Заказ.ПометкаУдаления Или (Заказ.Состояние <> Перечисления.ИТКСостоянияЗаказов.Отправлен
		И Заказ.Состояние <> Перечисления.ИТКСостоянияЗаказов.Завершен) Тогда
		ВызватьИсключение "Сначала отметьте заказ отправленным.";
	КонецЕсли;
	Строки = Заказ.Товары.НайтиСтроки(Новый Структура("Товар,ЕдиницыИзмерения", Товар, ЕдиницыИзмерения));
	Если Строки.Количество() <> 1 Тогда
		ВызватьИсключение "Выберите строку товара заказа.";
	КонецЕсли;
	Принято = ПолучитьПриемкиЗаказа(СсылкаЗаказа);
	Количество = Строки[0].Количество - КоличествоПринято(Принято, Товар, ЕдиницыИзмерения);
	Если Количество <= 0 Тогда
		ВызватьИсключение "Этот товар по заказу уже принят полностью.";
	КонецЕсли;
	Возврат Новый Структура("ИТКЗаказПоставщику,Товар,ЕдиницыИзмерения,Количество,ИТКЦенаЗакупки,ИТКВалютаЗакупки",
		СсылкаЗаказа, Товар, ЕдиницыИзмерения, Количество, Строки[0].Цена, Заказ.Валюта);

КонецФункции

Процедура ПроверитьПриемкуЗаказа(Приемка, РежимЗаписи) Экспорт

	ЗаблокироватьЗакупки();
	Если Не Приемка.ЭтоНовый() Тогда
		Предыдущая = Приемка.Ссылка.ПолучитьОбъект();
		Если Предыдущая.ИТКЗаказПоставщику <> Приемка.ИТКЗаказПоставщику Тогда
			ВызватьИсключение "Изменять заказ у записанной приёмки нельзя.";
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Приемка.ИТКЗаказПоставщику)
		Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	Заказ = Приемка.ИТКЗаказПоставщику.ПолучитьОбъект();
	Если Заказ.ПометкаУдаления Или Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Отменен
		Или Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Подготовлен Тогда
		ВызватьИсключение "Приёмка возможна по отправленному заказу.";
	КонецЕсли;
	Если Приемка.Дата < Заказ.Дата Или Приемка.Дата > ТекущаяДатаСеанса() Тогда
		ВызватьИсключение "Дата приёмки должна быть не раньше заказа и не позже текущего времени.";
	КонецЕсли;
	Строки = Заказ.Товары.НайтиСтроки(Новый Структура("Товар,ЕдиницыИзмерения", Приемка.Товар, Приемка.ЕдиницыИзмерения));
	Если Строки.Количество() <> 1 Тогда
		ВызватьИсключение "Товар и единица приёмки должны соответствовать строке заказа.";
	КонецЕсли;
	Принято = ПолучитьПриемкиЗаказа(Заказ.Ссылка, Приемка.Ссылка);
	Если Приемка.Количество > Строки[0].Количество - КоличествоПринято(Принято, Приемка.Товар, Приемка.ЕдиницыИзмерения) Тогда
		ВызватьИсключение "Количество приёмки превышает неполученный остаток заказа.";
	КонецЕсли;
	Если Приемка.ИТКВалютаЗакупки <> Заказ.Валюта Или Приемка.ИТКЦенаЗакупки <> Строки[0].Цена Тогда
		ВызватьИсключение "Валюта и закупочная цена приёмки должны соответствовать заказу.";
	КонецЕсли;

КонецПроцедуры

// Снимает только резерв данной входящей партии; расходы ТТН сохраняются.
Процедура УдалитьРезервыПриемки(Приемка) Экспорт

	Если Не ЗначениеЗаполнено(Приемка.ИТКЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьЗакупки();
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Резервы.Регистратор КАК Регистратор
	|ИЗ РегистрНакопления.ИТКРезервыТоваров КАК Резервы
	|ГДЕ Резервы.Партия = &Партия
	| И Резервы.Регистратор ССЫЛКА Документ.ЗаявкаТорговойТочки");
	Запрос.УстановитьПараметр("Партия", Приемка.Ссылка);
	Регистраторы = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Регистраторы Цикл
		ИзменитьРезервПриемки(Строка.Регистратор, Приемка, 0);
	КонецЦикла;

КонецПроцедуры

Процедура ЗарезервироватьПриемку(Приемка) Экспорт

	Если Не ЗначениеЗаполнено(Приемка.ИТКЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	Заказ = Приемка.ИТКЗаказПоставщику.ПолучитьОбъект();
	Потребности = ПолучитьПотребности(ТекущаяДатаСеанса(), Заказ.Ссылка);
	Осталось = Приемка.Количество;
	Для Каждого Потребность Из Потребности Цикл
		Если Потребность.Товар <> Приемка.Товар Или Потребность.ЕдиницыИзмерения <> Приемка.ЕдиницыИзмерения
			Или Заказ.Заявки.Найти(Потребность.Заявка, "Заявка") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Количество = Мин(Осталось, Макс(0, Потребность.Количество - Потребность.Зарезервировано - Потребность.Заказано));
		Если Количество > 0 Тогда
			ИзменитьРезервПриемки(Потребность.Заявка, Приемка, Количество);
			Осталось = Осталось - Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьЗаказПослеПриемки(Приемка) Экспорт

	Если Не ЗначениеЗаполнено(Приемка.ИТКЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	ЗаблокироватьЗакупки();
	Заказ = Приемка.ИТКЗаказПоставщику.ПолучитьОбъект();
	Если ЗаказПолученПолностью(Заказ, ПолучитьПриемкиЗаказа(Заказ.Ссылка)) Тогда
		Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Завершен;
	Иначе
		Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Отправлен;
	КонецЕсли;
	Заказ.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


// История отделена от текущего распределения неполученного остатка.
// После отправки нельзя заменить снимок при повторной записи или приёмке.
Процедура ВосстановитьИсториюРаспределения(Заказ)

	Если Заказ.ЭтоНовый() Тогда
		Заказ.ИТКИсторияРаспределения = Неопределено;
		Возврат;
	КонецЕсли;
	Предыдущий = Заказ.Ссылка.ПолучитьОбъект();
	Если Предыдущий.Состояние = Перечисления.ИТКСостоянияЗаказов.Подготовлен Тогда
		Заказ.ИТКИсторияРаспределения = Неопределено;
	Иначе
		Заказ.ИТКИсторияРаспределения = Предыдущий.ИТКИсторияРаспределения;
	КонецЕсли;

КонецПроцедуры

Процедура ЗафиксироватьИсториюРаспределения(Заказ)

	Если Заказ.Состояние <> Перечисления.ИТКСостоянияЗаказов.Отправлен Тогда
		Возврат;
	КонецЕсли;
	// Старому уже отправленному заказу нельзя приписывать первоначальное
	// распределение на основании изменившегося остатка.
	Предыдущий = Заказ.Ссылка.ПолучитьОбъект();
	Если Предыдущий.Состояние <> Перечисления.ИТКСостоянияЗаказов.Подготовлен Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Заявки.Ссылка КАК Заявка, Заявки.ТорговаяТочка КАК Точка
	|ИЗ Документ.ЗаявкаТорговойТочки КАК Заявки
	|ГДЕ Заявки.Ссылка В (&Заявки)");
	Запрос.УстановитьПараметр("Заявки", Заказ.Заявки.ВыгрузитьКолонку("Заявка"));
	Точки = Запрос.Выполнить().Выгрузить();
	История = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Точка,Товар,Единица,Количество,КоличествоЗаказа", ",") Цикл
		История.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Для Каждого Распределение Из Заказ.Распределение Цикл
		Точка = Точки.Найти(Распределение.Заявка, "Заявка");
		Если Точка = Неопределено Тогда
			ВызватьИсключение "Не найдена заявка для сохранения истории распределения закупки.";
		КонецЕсли;
		Товары = Заказ.Товары.НайтиСтроки(Новый Структура("Товар,ЕдиницыИзмерения",
			Распределение.Товар, Распределение.ЕдиницыИзмерения));
		Если Товары.Количество() <> 1 Тогда
			ВызватьИсключение "Распределение не соответствует товару заказа.";
		КонецЕсли;
		Строка = История.Добавить();
		Строка.Точка = Точка.Точка; Строка.Товар = Распределение.Товар;
		Строка.Единица = Распределение.ЕдиницыИзмерения;
		Строка.Количество = Распределение.Количество;
		Строка.КоличествоЗаказа = Товары[0].Количество;
	КонецЦикла;
	Заказ.ИТКИсторияРаспределения = Новый ХранилищеЗначения(Новый Структура("Версия,Строки", 1, История));

КонецПроцедуры

Процедура ПроверитьРедактированиеЗаказа(Заказ)

	Если Заказ.ЭтоНовый() Тогда
		Если Заказ.Состояние <> Перечисления.ИТКСостоянияЗаказов.Подготовлен Тогда
			ВызватьИсключение "Новый заказ должен иметь состояние «Подготовлен».";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Предыдущий = Заказ.Ссылка.ПолучитьОбъект();
	Принято = ПолучитьПриемкиЗаказа(Заказ.Ссылка);
	ПолностьюПринят = ЗаказПолученПолностью(Заказ, Принято);
	Если Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Завершен И Не ПолностьюПринят Тогда
		ВызватьИсключение "Заказ завершается после проведения приёмок на всё его количество.";
	КонецЕсли;
	Если (Заказ.ПометкаУдаления Или Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Отменен)
		И Принято.Количество() > 0 Тогда
		ВызватьИсключение "По заказу есть проведённые приёмки. Сначала отмените их проведение.";
	КонецЕсли;
	Если Предыдущий.Поставщик <> Заказ.Поставщик Или Предыдущий.Валюта <> Заказ.Валюта Тогда
		ВызватьИсключение "Для другого поставщика или валюты отмените заказ и сформируйте новый по актуальным условиям закупки.";
	КонецЕсли;
	Если Предыдущий.Состояние = Перечисления.ИТКСостоянияЗаказов.Подготовлен Тогда
		Если Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Завершен Тогда
			ВызватьИсключение "Сначала отметьте заказ отправленным.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Предыдущий.Состояние = Перечисления.ИТКСостоянияЗаказов.Отправлен Тогда
		Если Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Подготовлен Тогда
			ВызватьИсключение "Отправленный заказ нельзя вернуть в подготовку. При необходимости отмените его.";
		КонецЕсли;
	ИначеЕсли Предыдущий.Состояние <> Заказ.Состояние
		И Не (Предыдущий.Состояние = Перечисления.ИТКСостоянияЗаказов.Завершен
			И Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Отправлен И Не ПолностьюПринят) Тогда
		ВызватьИсключение "Завершённый или отменённый заказ нельзя повторно сделать действующим.";
	КонецЕсли;
	Если Предыдущий.Товары.Количество() <> Заказ.Товары.Количество() Тогда
		ВызватьИсключение "После отправки состав заказа изменять нельзя.";
	КонецЕсли;
	Отбор = Новый Структура("Товар,ЕдиницыИзмерения");
	Для Каждого СтрокаТовара Из Заказ.Товары Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТовара);
		Строки = Предыдущий.Товары.НайтиСтроки(Отбор);
		Если Строки.Количество() <> 1 Тогда
			ВызватьИсключение "После отправки товары заказа изменять нельзя.";
		КонецЕсли;
		Если Строки[0].Количество <> СтрокаТовара.Количество Или Строки[0].Цена <> СтрокаТовара.Цена Тогда
			ВызватьИсключение "После отправки количество и цену заказа изменять нельзя.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаблокироватьЗакупки()

	// Такой же первый шаг, как у заявок, приёмки, списания и ТТН после №5.
	ИТКРезервыСервер.ЗаблокироватьУчет();
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ИТКУсловияЗакупки");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ПолучитьПотребности(Момент, ИсключитьЗаказ)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстПотребностей();
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("ГраницаОстатков", Новый Граница(Момент, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(Момент));
	Запрос.УстановитьПараметр("ИсключитьЗаказ", ИсключитьЗаказ);
	Запрос.УстановитьПараметр("Подготовлен", Перечисления.ИТКСостоянияЗаказов.Подготовлен);
	Запрос.УстановитьПараметр("Отправлен", Перечисления.ИТКСостоянияЗаказов.Отправлен);
	Запрос.УстановитьПараметр("Завершен", Перечисления.ИТКСостоянияЗаказов.Завершен);
	Данные = Запрос.ВыполнитьПакет();
	Свободно = Данные[Данные.Количество() - 2].Выгрузить();
	Потребности = Данные[Данные.Количество() - 1].Выгрузить();
	Потребности.Колонки.Добавить("КЗакупке", Новый ОписаниеТипов("Число"));
	Отбор = Новый Структура("Товар,ЕдиницыИзмерения");
	// Распределение свободного склада по ВСЕМ заявкам, затем отбор отчёта.
	// Один и тот же свободный остаток не вычитается повторно при выборе разных точек.
	Для Каждого Потребность Из Потребности Цикл
		Отбор.Товар = Потребность.Товар;
		Отбор.ЕдиницыИзмерения = Потребность.ЕдиницыИзмерения;
		Потребность.КЗакупке = Макс(0, Потребность.Количество - Потребность.Зарезервировано - Потребность.Заказано);
		СтрокиОстатка = Свободно.НайтиСтроки(Отбор);
		Если СтрокиОстатка.Количество() > 0 Тогда
			Остаток = СтрокиОстатка[0];
			Покрытие = Мин(Потребность.КЗакупке, Макс(0, Остаток.Количество));
			Потребность.КЗакупке = Потребность.КЗакупке - Покрытие;
			Остаток.Количество = Остаток.Количество - Покрытие;
		КонецЕсли;
	КонецЦикла;
	Возврат Потребности;

КонецФункции

Функция ТекстПотребностей()

	Возврат
	"ВЫБРАТЬ Товары.Ссылка.Заявка КАК Заявка, Товары.Товар КАК Товар,
	| Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения, СУММА(Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТОтгружено
	|ИЗ Документ.ТоварноТранспортнаяНакладная.Товары КАК Товары
	|ГДЕ Товары.Ссылка.Проведен И Товары.Ссылка.Дата <= &Момент
	|СГРУППИРОВАТЬ ПО Товары.Ссылка.Заявка, Товары.Товар, Товары.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Резервы.Заявка КАК Заявка, Резервы.Товар КАК Товар,
	| Резервы.ЕдиницыИзмерения КАК ЕдиницыИзмерения, СУММА(Резервы.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТРезервы
	|ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(&ГраницаОстатков) КАК Резервы
	|ГДЕ Резервы.Партия.СрокГодности >= &Сегодня
	|СГРУППИРОВАТЬ ПО Резервы.Заявка, Резервы.Товар, Резервы.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Потребности.Заявка КАК Заявка, Потребности.Ассортимент КАК Товар,
	| Потребности.ЕдиницыИзмерения КАК ЕдиницыИзмерения, СУММА(Потребности.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТИсходныеЗаявки
	|ИЗ РегистрНакопления.Заявки.Остатки(&ГраницаОстатков) КАК Потребности
	|ГДЕ Потребности.Заявка.Проведен И НЕ Потребности.Заявка.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО Потребности.Заявка, Потребности.Ассортимент, Потребности.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Потребности.Заявка КАК Заявка, Потребности.Товар КАК Товар,
	| Потребности.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| Потребности.Количество - ЕСТЬNULL(Отгружено.Количество, 0) КАК Количество,
	| ЕСТЬNULL(Резервы.Количество, 0) КАК Зарезервировано
	|ПОМЕСТИТЬ ВТПотребности
	|ИЗ ВТИсходныеЗаявки КАК Потребности
	| ЛЕВОЕ СОЕДИНЕНИЕ ВТОтгружено КАК Отгружено
	| ПО Потребности.Заявка = Отгружено.Заявка И Потребности.Товар = Отгружено.Товар
	|  И Потребности.ЕдиницыИзмерения = Отгружено.ЕдиницыИзмерения
	| ЛЕВОЕ СОЕДИНЕНИЕ ВТРезервы КАК Резервы
	| ПО Потребности.Заявка = Резервы.Заявка И Потребности.Товар = Резервы.Товар
	|  И Потребности.ЕдиницыИзмерения = Резервы.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Приемка.ИТКЗаказПоставщику КАК Заказ, Приемка.Товар КАК Товар,
	| Приемка.ЕдиницыИзмерения КАК ЕдиницыИзмерения, СУММА(Приемка.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТПринято
	|ИЗ Документ.ИТКПриемкаПартии КАК Приемка
	|ГДЕ Приемка.Проведен И Приемка.Дата <= &Момент
	|СГРУППИРОВАТЬ ПО Приемка.ИТКЗаказПоставщику, Приемка.Товар, Приемка.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Товары.Ссылка КАК Заказ, Товары.Товар КАК Товар,
	| Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| ВЫБОР КОГДА Товары.Количество > ЕСТЬNULL(Принято.Количество, 0)
	| ТОГДА Товары.Количество - ЕСТЬNULL(Принято.Количество, 0) ИНАЧЕ 0 КОНЕЦ КАК Количество
	|ПОМЕСТИТЬ ВТОжидается
	|ИЗ Документ.ИТКЗаказПоставщику.Товары КАК Товары
	| ЛЕВОЕ СОЕДИНЕНИЕ ВТПринято КАК Принято
	| ПО Товары.Ссылка = Принято.Заказ И Товары.Товар = Принято.Товар
	| И Товары.ЕдиницыИзмерения = Принято.ЕдиницыИзмерения
	|ГДЕ НЕ Товары.Ссылка.ПометкаУдаления И Товары.Ссылка <> &ИсключитьЗаказ
	| И Товары.Ссылка.Состояние В (&Подготовлен, &Отправлен, &Завершен)
	|;
	|ВЫБРАТЬ Распределение.Заявка КАК Заявка, Распределение.Товар КАК Товар,
	| Распределение.ЕдиницыИзмерения КАК ЕдиницыИзмерения, СУММА(Распределение.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТЗаказыИсходные
	|ИЗ Документ.ИТКЗаказПоставщику.Распределение КАК Распределение
	|ГДЕ НЕ Распределение.Ссылка.ПометкаУдаления И Распределение.Ссылка <> &ИсключитьЗаказ
	| И Распределение.Ссылка.Состояние В (&Подготовлен, &Отправлен, &Завершен)
	|СГРУППИРОВАТЬ ПО Распределение.Заявка, Распределение.Товар, Распределение.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Заказы.Заявка КАК Заявка, Заказы.Товар КАК Товар,
	| Заказы.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| ВЫБОР КОГДА Потребности.Количество - Потребности.Зарезервировано <= 0 ТОГДА 0
	|  КОГДА Заказы.Количество > Потребности.Количество - Потребности.Зарезервировано
	|   ТОГДА Потребности.Количество - Потребности.Зарезервировано
	|  ИНАЧЕ Заказы.Количество КОНЕЦ КАК Количество
	|ПОМЕСТИТЬ ВТЗаказано
	|ИЗ ВТЗаказыИсходные КАК Заказы
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПотребности КАК Потребности
	| ПО Заказы.Заявка = Потребности.Заявка И Заказы.Товар = Потребности.Товар
	|  И Заказы.ЕдиницыИзмерения = Потребности.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Заказанные.Товар КАК Товар, Заказанные.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| СУММА(Заказанные.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТСверхПотребности
	|ИЗ (ВЫБРАТЬ Товары.Товар КАК Товар, Товары.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| Товары.Количество КАК Количество
	| ИЗ ВТОжидается КАК Товары
	| ОБЪЕДИНИТЬ ВСЕ
	| ВЫБРАТЬ Заказано.Товар, Заказано.ЕдиницыИзмерения, -Заказано.Количество
	| ИЗ ВТЗаказано КАК Заказано) КАК Заказанные
	|СГРУППИРОВАТЬ ПО Заказанные.Товар, Заказанные.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Свободно.Товар КАК Товар, Свободно.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| СУММА(Свободно.Количество) КАК Количество
	|ИЗ (ВЫБРАТЬ Остатки.Товар КАК Товар, Остатки.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	|  Остатки.КоличествоОстаток КАК Количество
	| ИЗ РегистрНакопления.ИТКОстаткиПартий.Остатки(&ГраницаОстатков) КАК Остатки
	| ГДЕ Остатки.Партия.СрокГодности >= &Сегодня
	| ОБЪЕДИНИТЬ ВСЕ
	| ВЫБРАТЬ Резервы.Товар, Резервы.ЕдиницыИзмерения, -Резервы.Количество
	| ИЗ ВТРезервы КАК Резервы
	| ОБЪЕДИНИТЬ ВСЕ
	| ВЫБРАТЬ СверхПотребности.Товар, СверхПотребности.ЕдиницыИзмерения, СверхПотребности.Количество
	| ИЗ ВТСверхПотребности КАК СверхПотребности) КАК Свободно
	|СГРУППИРОВАТЬ ПО Свободно.Товар, Свободно.ЕдиницыИзмерения
	|;
	|ВЫБРАТЬ Потребности.Заявка КАК Заявка, Потребности.Товар КАК Товар,
	| Потребности.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| Потребности.Количество КАК Количество, Потребности.Зарезервировано КАК Зарезервировано,
	| ЕСТЬNULL(Заказано.Количество, 0) КАК Заказано
	|ИЗ ВТПотребности КАК Потребности
	| ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказано КАК Заказано
	| ПО Потребности.Заявка = Заказано.Заявка И Потребности.Товар = Заказано.Товар
	|  И Потребности.ЕдиницыИзмерения = Заказано.ЕдиницыИзмерения
	|УПОРЯДОЧИТЬ ПО Потребности.Заявка.Дата, Потребности.Заявка, Товар, ЕдиницыИзмерения";

КонецФункции

Функция ПолучитьУсловия(Момент)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Условия.Товар КАК Товар, Условия.ЕдиницыИзмерения КАК ЕдиницыИзмерения,
	| Условия.Поставщик КАК Поставщик, Условия.Валюта КАК Валюта, Условия.Цена КАК Цена,
	| Условия.Поставщик.ПометкаУдаления КАК ПоставщикУдален
	|ИЗ РегистрСведений.ИТКУсловияЗакупки.СрезПоследних(&Момент) КАК Условия";
	Запрос.УстановитьПараметр("Момент", Момент);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПостроитьЗаказы(План, Условия, Момент)

	Заказы = Новый Массив;
	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Поставщик");
	Группы.Колонки.Добавить("Валюта");
	Группы.Колонки.Добавить("ОбъектЗаказа");
	ОтборУсловий = Новый Структура("Товар,ЕдиницыИзмерения");
	ОтборГруппы = Новый Структура("Поставщик,Валюта");
	ОтборТовара = Новый Структура("Товар,ЕдиницыИзмерения");
	Для Каждого Потребность Из План Цикл
		ОтборУсловий.Товар = Потребность.Товар;
		ОтборУсловий.ЕдиницыИзмерения = Потребность.ЕдиницыИзмерения;
		СтрокиУсловий = Условия.НайтиСтроки(ОтборУсловий);
		Если СтрокиУсловий.Количество() <> 1 Тогда
			ВызватьИсключение СтрШаблон("Для %1 (%2) нет условий закупки на текущую дату. Заполните предпочтительного поставщика, валюту и закупочную цену.", Потребность.Товар, Потребность.ЕдиницыИзмерения);
		КонецЕсли;
		Условие = СтрокиУсловий[0];
		Если Не ЗначениеЗаполнено(Условие.Поставщик) Или Условие.ПоставщикУдален
			Или Не ЗначениеЗаполнено(Условие.Валюта) Или Условие.Цена <= 0 Тогда
			ВызватьИсключение СтрШаблон("Условия закупки %1 (%2) заполнены не полностью: проверьте поставщика, валюту и положительную цену.", Потребность.Товар, Потребность.ЕдиницыИзмерения);
		КонецЕсли;
		ОтборГруппы.Поставщик = Условие.Поставщик;
		ОтборГруппы.Валюта = Условие.Валюта;
		СтрокиГруппы = Группы.НайтиСтроки(ОтборГруппы);
		Если СтрокиГруппы.Количество() = 0 Тогда
			Заказ = Документы.ИТКЗаказПоставщику.СоздатьДокумент();
			Заказ.Дата = Момент;
			Заказ.Поставщик = Условие.Поставщик;
			Заказ.Валюта = Условие.Валюта;
			Заказ.Состояние = Перечисления.ИТКСостоянияЗаказов.Подготовлен;
			Группа = Группы.Добавить();
			ЗаполнитьЗначенияСвойств(Группа, ОтборГруппы);
			Группа.ОбъектЗаказа = Заказ;
			Заказы.Добавить(Заказ);
		Иначе
			Заказ = СтрокиГруппы[0].ОбъектЗаказа;
		КонецЕсли;
		Если Заказ.Заявки.Найти(Потребность.Заявка, "Заявка") = Неопределено Тогда
			Заказ.Заявки.Добавить().Заявка = Потребность.Заявка;
		КонецЕсли;
		ОтборТовара.Товар = Потребность.Товар;
		ОтборТовара.ЕдиницыИзмерения = Потребность.ЕдиницыИзмерения;
		СтрокиТовара = Заказ.Товары.НайтиСтроки(ОтборТовара);
		Если СтрокиТовара.Количество() = 0 Тогда
			СтрокаТовара = Заказ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ОтборТовара);
			СтрокаТовара.Цена = Условие.Цена;
		Иначе
			СтрокаТовара = СтрокиТовара[0];
		КонецЕсли;
		СтрокаТовара.Количество = СтрокаТовара.Количество + Потребность.КЗакупке;
	КонецЦикла;
	Возврат Заказы;

КонецФункции

#КонецОбласти


Функция ПолучитьПриемкиЗаказа(Заказ, ИсключитьПриемку = Неопределено)

	Если ИсключитьПриемку = Неопределено Тогда
		ИсключитьПриемку = Документы.ИТКПриемкаПартии.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Приемка.Товар КАК Товар,
	| Приемка.ЕдиницыИзмерения КАК ЕдиницыИзмерения, СУММА(Приемка.Количество) КАК Количество
	|ИЗ Документ.ИТКПриемкаПартии КАК Приемка
	|ГДЕ Приемка.ИТКЗаказПоставщику = &Заказ И Приемка.Проведен
	| И Приемка.Ссылка <> &ИсключитьПриемку
	|СГРУППИРОВАТЬ ПО Приемка.Товар, Приемка.ЕдиницыИзмерения");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ИсключитьПриемку", ИсключитьПриемку);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция КоличествоПринято(Принято, Товар, ЕдиницыИзмерения)

	Строки = Принято.НайтиСтроки(Новый Структура("Товар,ЕдиницыИзмерения", Товар, ЕдиницыИзмерения));
	Если Строки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Строки[0].Количество;

КонецФункции

Функция ЗаказПолученПолностью(Заказ, Принято)

	Для Каждого СтрокаТовара Из Заказ.Товары Цикл
		Если СтрокаТовара.Количество > КоличествоПринято(Принято, СтрокаТовара.Товар, СтрокаТовара.ЕдиницыИзмерения) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Заказ.Товары.Количество() > 0;

КонецФункции

Процедура ИзменитьРезервПриемки(Заявка, Приемка, Количество)

	Набор = РегистрыНакопления.ИТКРезервыТоваров.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Заявка);
	Набор.Прочитать();
	Индекс = Набор.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Набор[Индекс].Партия = Приемка.Ссылка Тогда
			Набор.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Если Количество > 0 Тогда
		Движение = Набор.Добавить();
		Движение.Период = Приемка.Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Заявка = Заявка;
		Движение.Товар = Приемка.Товар;
		Движение.ЕдиницыИзмерения = Приемка.ЕдиницыИзмерения;
		Движение.Партия = Приемка.Ссылка;
		Движение.Количество = Количество;
	КонецЕсли;
	Набор.Записать();

КонецПроцедуры
