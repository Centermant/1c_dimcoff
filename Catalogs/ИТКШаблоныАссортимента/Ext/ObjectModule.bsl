#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Отказ = Истина;
		СообщитьОшибку("Укажите начало и окончание действия шаблона.");
		Возврат;
	КонецЕсли;
	Если НачалоДня(ДатаОкончания) < НачалоДня(ДатаНачала) Тогда
		Отказ = Истина;
		СообщитьОшибку("Дата окончания шаблона не может быть раньше даты начала.");
	КонецЕсли;

	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		СообщитьОшибку("Добавьте хотя бы один обязательный товар в шаблон.");
	КонецЕсли;

	ПроверенныеТовары = Новый Соответствие;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			Отказ = Истина;
			СообщитьОшибку(СтрШаблон("Не выбран товар в строке %1.", СтрокаТовара.НомерСтроки));
		ИначеЕсли ПроверенныеТовары.Получить(СтрокаТовара.Товар) <> Неопределено Тогда
			Отказ = Истина;
			СообщитьОшибку(СтрШаблон("Товар повторяется в строке %1. Удалите повтор.", СтрокаТовара.НомерСтроки));
		Иначе
			ПроверенныеТовары.Вставить(СтрокаТовара.Товар, Истина);
		КонецЕсли;
	КонецЦикла;

	Если Не Отказ Тогда
		ДатаНачала = НачалоДня(ДатаНачала);
		ДатаОкончания = НачалоДня(ДатаОкончания);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьОшибку(ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти