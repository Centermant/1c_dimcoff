&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
 ИТК03Реквизиты = Новый Массив;
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Себестоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4))));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03МинимальнаяЦена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2))));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03ЦелеваяМаржа", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2))));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Поставка", Новый ОписаниеТипов("ДокументСсылка.ИТКПриемкаПартии")));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Единица", Новый ОписаниеТипов("ПеречислениеСсылка.ЕдиницыИзмерения")));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03ДатаПоставки", Новый ОписаниеТипов("Дата")));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Валюта", Новый ОписаниеТипов("ПеречислениеСсылка.ИТКВалютыЗакупки")));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Курс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 6))));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Транспорт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2))));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Потери", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2))));
 ИТК03Реквизиты.Добавить(Новый РеквизитФормы("ИТК03Сообщение", Новый ОписаниеТипов("Строка")));
 ИзменитьРеквизиты(ИТК03Реквизиты);
 ИТК03ДобавитьПоле("ИТК03Код", "Объект.Код", "Код", Ложь, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03Наименование", "Объект.Наименование", "Наименование", Ложь, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03ВидАссортимента", "Объект.ВидАссортимента", "Вид ассортимента", Ложь, ЭтаФорма);
 ИТК03Единицы = Элементы.Добавить("ИТК03Единицы", Тип("ТаблицаФормы"), ЭтаФорма);
 ИТК03Единицы.ПутьКДанным = "Объект.Единицы";
 ИТК03ДобавитьПоле("ИТК03ВходящиеЕдиницыИзмерения", "Объект.Единицы.ВходящиеЕдиницыИзмерения", "Единица закупки", Ложь, ИТК03Единицы);
 ИТК03ДобавитьПоле("ИТК03ВнутренниеЕдиницыИзмерения", "Объект.Единицы.ВнутренниеЕдиницыИзмерения", "Единица розничной продажи", Ложь, ИТК03Единицы);
 ИТК03ДобавитьПоле("ИТК03Коэффициент", "Объект.Единицы.Коэффициент", "Число единиц продажи в единице закупки", Ложь, ИТК03Единицы);
 ИТК03ДобавитьПоле("ИТК03РасчетСебестоимость", "ИТК03Себестоимость", "Плановая себестоимость, RUB", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетМинимальнаяЦена", "ИТК03МинимальнаяЦена", "Минимальная розничная цена, RUB", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетЦелеваяМаржа", "ИТК03ЦелеваяМаржа", "Целевая маржа, %", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетЕдиница", "ИТК03Единица", "Единица розничной цены", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетПоставка", "ИТК03Поставка", "Последняя проведённая поставка", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетДатаПоставки", "ИТК03ДатаПоставки", "Дата поставки", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетВалюта", "ИТК03Валюта", "Валюта поставки", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетКурс", "ИТК03Курс", "Зафиксированный курс", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетТранспорт", "ИТК03Транспорт", "Транспорт этой поставки, RUB", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетПотери", "ИТК03Потери", "Расходы на потери этой поставки, RUB", Истина, ЭтаФорма);
 ИТК03ДобавитьПоле("ИТК03РасчетСообщение", "ИТК03Сообщение", "Результат расчёта", Истина, ЭтаФорма);
 ИТК03ДобавитьКоманду("ИТК03Обновить", "Обновить себестоимость");
 ИТК03ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИТК03Обновить(Команда)
 ИТК03ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИТК03ОбновитьНаСервере()
 ЭтаФорма.ИТК03Поставка = Документы.ИТКПриемкаПартии.ПустаяСсылка();
 ЭтаФорма.ИТК03ДатаПоставки = Дата(1, 1, 1);
 ЭтаФорма.ИТК03Единица = Перечисления.ЕдиницыИзмерения.ПустаяСсылка();
 ЭтаФорма.ИТК03Валюта = Перечисления.ИТКВалютыЗакупки.ПустаяСсылка();
 ЭтаФорма.ИТК03Курс = 0;
 ЭтаФорма.ИТК03Транспорт = 0;
 ЭтаФорма.ИТК03Потери = 0;
 ЭтаФорма.ИТК03Себестоимость = 0;
 ЭтаФорма.ИТК03МинимальнаяЦена = 0;
 ЭтаФорма.ИТК03Сообщение = "";
 ЭтаФорма.ИТК03ЦелеваяМаржа = ИТКМаржаСервер.ПолучитьЦелевуюМаржу();

 Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
  ЭтаФорма.ИТК03Сообщение = "Запишите товар и проведите его первую приёмку с оценкой стоимости.";
  Возврат;
 КонецЕсли;

 Попытка
  ИТК03Данные = ИТКМаржаСервер.ПолучитьСебестоимостьТовара(Объект.Ссылка, ТекущаяДатаСеанса());
  ЭтаФорма.ИТК03Себестоимость = ИТК03Данные.Себестоимость;
  ЭтаФорма.ИТК03Поставка = ИТК03Данные.Поставка;
  ЭтаФорма.ИТК03ДатаПоставки = ИТК03Данные.ДатаПоставки;
  ЭтаФорма.ИТК03Единица = ИТК03Данные.ЕдиницаПродажи;
  ЭтаФорма.ИТК03Валюта = ИТК03Данные.Валюта;
  ЭтаФорма.ИТК03Курс = ИТК03Данные.Курс;
  ЭтаФорма.ИТК03Транспорт = ИТК03Данные.Транспорт;
  ЭтаФорма.ИТК03Потери = ИТК03Данные.Потери;
  ИТК03Расчет = ИТКМаржаСервер.РассчитатьПоказателиЦены(ЭтаФорма.ИТК03Себестоимость, 0, ЭтаФорма.ИТК03ЦелеваяМаржа);
  ЭтаФорма.ИТК03МинимальнаяЦена = ИТК03Расчет.МинимальнаяЦена;
 Исключение
  ЭтаФорма.ИТК03Сообщение = ОписаниеОшибки();
 КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
 Если ИмяСобытия = "ИТК03ПриемкаИзменена" И Параметр.Товар = Объект.Ссылка Тогда
  ПодключитьОбработчикОжидания("ИТК03ОбновитьПослеОповещения", 0.1, Истина);
 КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИТК03ОбновитьПослеОповещения() Экспорт
 ИТК03Изменено = Модифицированность;
 ИТК03ОбновитьНаСервере();
 Модифицированность = ИТК03Изменено;
КонецПроцедуры

&НаСервере
Процедура ИТК03ДобавитьПоле(Имя, Путь, Заголовок, Просмотр, Родитель, Действие = "")
 ИТК03Поле = Элементы.Найти(Имя);
 Если ИТК03Поле = Неопределено Тогда
  ИТК03Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
 КонецЕсли;
 ИТК03Поле.ПутьКДанным = Путь;
 ИТК03Поле.Вид = ВидПоляФормы.ПолеВвода;
 ИТК03Поле.Заголовок = Заголовок;
 ИТК03Поле.ТолькоПросмотр = Просмотр;
 Если Не ПустаяСтрока(Действие) Тогда
  ИТК03Поле.УстановитьДействие("ПриИзменении", Действие);
 КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИТК03ДобавитьКоманду(Имя, Заголовок)
 ИТК03Команда = Команды.Найти(Имя);
 Если ИТК03Команда = Неопределено Тогда
  ИТК03Команда = Команды.Добавить(Имя);
 КонецЕсли;
 ИТК03Команда.Заголовок = Заголовок;
 ИТК03Команда.Действие = Имя;
 ИТК03Кнопка = Элементы.Добавить(Имя + "Кнопка", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
 ИТК03Кнопка.ИмяКоманды = Имя;
 ИТК03Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
КонецПроцедуры
