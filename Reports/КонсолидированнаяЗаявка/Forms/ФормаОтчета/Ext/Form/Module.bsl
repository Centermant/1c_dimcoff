&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИТК01Команда = Команды.Добавить("ИТК01СформироватьАвтозаявки");
	ИТК01Команда.Заголовок = "Сформировать автозаявки за сегодня";
	ИТК01Команда.Действие = "ИТК01СформироватьАвтозаявки";
	ИТК01Кнопка = Элементы.Добавить("ИТК01КнопкаАвтозаявок", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
	ИТК01Кнопка.ИмяКоманды = "ИТК01СформироватьАвтозаявки";
	ИТК01Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;

	Команда = Команды.Добавить("ИТКСформироватьЗаказы");
	Команда.Заголовок = "Сформировать заказы поставщикам";
	Команда.Действие = "ИТКСформироватьЗаказы";
	Кнопка = Элементы.Добавить("ИТККнопкаЗаказов", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
	Кнопка.ИмяКоманды = "ИТКСформироватьЗаказы";
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;

КонецПроцедуры

&НаКлиенте
Процедура ИТКСформироватьЗаказы(Команда)

	Перем ИТКРезультатЗакупки;

	ИТКРезультатЗакупки = ИТКСформироватьЗаказыНаСервере();
	Если Не ИТКРезультатЗакупки.ЕстьСтроки Тогда
		ПоказатьПредупреждение(, "По текущему отбору не получены заявки с неотгруженным количеством. Проверьте отбор и сформируйте отчёт.");
		Возврат;
	КонецЕсли;
	Заказы = ИТКРезультатЗакупки.Заказы;
	Для Каждого СсылкаЗаказа Из Заказы Цикл
		ОповеститьОбИзменении(СсылкаЗаказа);
	КонецЦикла;
	Если Заказы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Новых заказов нет: потребность уже покрыта складом или действующими заказами поставщикам.");
	ИначеЕсли Заказы.Количество() = 1 Тогда
		ОткрытьФорму("Документ.ИТКЗаказПоставщику.ФормаОбъекта", Новый Структура("Ключ", Заказы[0]));
	Иначе
		ПоказатьПредупреждение(, "Создано заказов: " + Строка(Заказы.Количество()) + ". Они записаны и доступны в списке заказов поставщикам.");
		ОткрытьФорму("Документ.ИТКЗаказПоставщику.ФормаСписка");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИТКСформироватьЗаказыНаСервере()

	Перем ИТКРезультатЗакупки;

	ОбъектОтчета = РеквизитФормыВЗначение("Отчет");
	СтрокиОтчета = ОбъектОтчета.ПолучитьСтрокиЗакупки();
	ИТКРезультатЗакупки = Новый Структура("ЕстьСтроки,Заказы", СтрокиОтчета.Количество() > 0, Новый Массив);
	Если ИТКРезультатЗакупки.ЕстьСтроки Тогда
		ИТКРезультатЗакупки.Заказы = ИТКЗакупкиСервер.СформироватьЗаказы(СтрокиОтчета);
	КонецЕсли;
	Возврат ИТКРезультатЗакупки;

КонецФункции


&НаКлиенте
Процедура ИТК01СформироватьАвтозаявки(Команда)
    Перем ИТК01РезультатАвтозаказа;

    ИТК01РезультатАвтозаказа = ИТК01АвтозаявкиНаСервере();
    Если ИТК01РезультатАвтозаказа.Заявки.Количество() = 1 Тогда
        ОткрытьФорму("Документ.ЗаявкаТорговойТочки.ФормаОбъекта", Новый Структура("Ключ", ИТК01РезультатАвтозаказа.Заявки[0]));
    Иначе
        Сообщить("Новых автозаявок: " + Строка(ИТК01РезультатАвтозаказа.Создано) + ". Результат доступен в списке заявок торговых точек.");
        Если ИТК01РезультатАвтозаказа.Заявки.Количество() > 0 Тогда
            ОткрытьФорму("Документ.ЗаявкаТорговойТочки.ФормаСписка");
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ИТК01АвтозаявкиНаСервере()
    Возврат ИТКАвтозаказСервер.РассчитатьЗаСегодня();
КонецФункции
