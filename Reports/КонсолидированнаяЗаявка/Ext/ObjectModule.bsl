#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	// Получаем итоговые настройки с учётом сохранённых пользовательских значений.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрДаты = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("Дата"));
	Если ПараметрДаты = Неопределено Тогда
		ВызватьИсключение "В схеме компоновки не найден параметр Дата. Проверьте настройку отчёта по инструкции.";
	КонецЕсли;
	ПараметрДаты.Значение = ТекущаяДатаСеанса();
	ПараметрДаты.Использование = Истина;
	// Загрузка обновляет и основные, и пользовательские настройки даты.
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);

КонецПроцедуры

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Получает ключи детальных строк с общими отборами текущего отчёта.
// Возвращаемое значение:
//  ТаблицаЗначений - Заявка, Ассортимент, ЕдиницыИзмерения.
Функция ПолучитьСтрокиЗакупки() Экспорт

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПроверитьОтборыГруппировок(Настройки.Структура);
	ПараметрДаты = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Дата"));
	Если ПараметрДаты = Неопределено Тогда
		ВызватьИсключение "В схеме компоновки не найден параметр Дата.";
	КонецЕсли;
	ПараметрДаты.Значение = ТекущаяДатаСеанса();
	ПараметрДаты.Использование = Истина;
	// Меняем только отдельную копию настроек для машинного чтения; вид отчёта сохраняется.
	Настройки.Структура.Очистить();
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Использование = Истина;
	Настройки.Выбор.Элементы.Очистить();
	Для Каждого ИмяПоля Из СтрРазделить("Заявка,Ассортимент,ЕдиницыИзмерения", ",") Цикл
		ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ВыбранноеПоле.Использование = Истина;
		// Новая детальная группировка имеет собственный выбор полей.
		// Без него общий выбор не выводится в таблицу автоматически.
		ПолеГруппировки = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ПолеГруппировки.Использование = Истина;
	КонецЦикла;
	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Таблица = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Таблица);
	Таблица = Вывод.Вывести(Процессор);
	Если Таблица.Количество() = 0 Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Заявка");
		Таблица.Колонки.Добавить("Ассортимент");
		Таблица.Колонки.Добавить("ЕдиницыИзмерения");
	КонецЕсли;
	Таблица.Свернуть("Заявка,Ассортимент,ЕдиницыИзмерения");
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОтборыГруппировок(СтруктураНастроек)

	Для Каждого Элемент Из СтруктураНастроек Цикл
		Если ТипЗнч(Элемент) <> Тип("ГруппировкаКомпоновкиДанных") Тогда
			ВызватьИсключение "Для закупки выберите основной вариант отчёта с детальными строками.";
		КонецЕсли;
		Если Элемент.Отбор.Элементы.Количество() > 0 Тогда
			ВызватьИсключение "Для закупки задайте отбор в общих настройках отчёта, а не внутри отдельной группировки.";
		КонецЕсли;
		ПроверитьОтборыГруппировок(Элемент.Структура);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
