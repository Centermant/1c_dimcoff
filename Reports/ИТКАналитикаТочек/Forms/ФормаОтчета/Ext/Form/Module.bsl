#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ИТК07Реквизиты = Новый Массив;
    ИТК07Реквизиты.Добавить(Новый РеквизитФормы("ИТК07ДатаНачала", Новый ОписаниеТипов("Дата")));
    ИТК07Реквизиты.Добавить(Новый РеквизитФормы("ИТК07ДатаОкончания", Новый ОписаниеТипов("Дата")));
    ИТК07Реквизиты.Добавить(Новый РеквизитФормы("ИТК07Точка", Новый ОписаниеТипов("СправочникСсылка.ТочкиПродаж")));
    ИТК07Реквизиты.Добавить(Новый РеквизитФормы("ИТК07Категория", Новый ОписаниеТипов("ПеречислениеСсылка.ВидАссортимента")));
    ИТК07Реквизиты.Добавить(Новый РеквизитФормы("ИТК07ПоМесяцам", Новый ОписаниеТипов("Булево")));
    ИзменитьРеквизиты(ИТК07Реквизиты);
    ЭтаФорма.ИТК07ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
    ЭтаФорма.ИТК07ДатаОкончания = НачалоДня(ТекущаяДатаСеанса());
    ЭтаФорма.ИТК07ПоМесяцам = Ложь;
    ИТК07Группа = Элементы.Добавить("ИТК07Параметры", Тип("ГруппаФормы"));
    ИТК07Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ИТК07Группа.Заголовок = "Условия отчёта";
    Если Элементы.Найти("Результат") <> Неопределено Тогда
        Элементы.Переместить(ИТК07Группа, ЭтаФорма, Элементы.Результат);
    КонецЕсли;
    ИТК07Поле("ИТК07ДатаНачалаПоле", "ИТК07ДатаНачала", "Начало периода", ИТК07Группа);
    ИТК07Поле("ИТК07ДатаОкончанияПоле", "ИТК07ДатаОкончания", "Окончание периода", ИТК07Группа);
    ИТК07Поле("ИТК07ТочкаПоле", "ИТК07Точка", "Торговая точка (пусто - все)", ИТК07Группа);
    ИТК07Поле("ИТК07КатегорияПоле", "ИТК07Категория", "Категория (пусто - все)", ИТК07Группа);
    ИТК07Поле("ИТК07ПоМесяцамПоле", "ИТК07ПоМесяцам", "Группировать продажи по месяцам", ИТК07Группа, Истина);
    ИТК07Команда = Команды.Добавить("ИТК07Сформировать");
    ИТК07Команда.Заголовок = "Сформировать аналитику";
    ИТК07Команда.Действие = "ИТК07Сформировать";
    ИТК07Кнопка = Элементы.Добавить("ИТК07КнопкаСформировать", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
    ИТК07Кнопка.ИмяКоманды = "ИТК07Сформировать";
    ИТК07Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИТК07Сформировать(Команда)
    Попытка
        ИТК07СформироватьНаСервере();
    Исключение
        ПоказатьПредупреждение(, "Отчёт не сформирован: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИТК07СформироватьНаСервере()
    Перем ИТК07ОбъектОтчета, ИТК07Периодичность, ИТК07ТабличныйДокумент;
    ИТК07ОбъектОтчета = РеквизитФормыВЗначение("Отчет");
    ИТК07Периодичность = "День";
    Если ЭтаФорма.ИТК07ПоМесяцам Тогда
        ИТК07Периодичность = "Месяц";
    КонецЕсли;
    ИТК07ТабличныйДокумент = ИТК07ОбъектОтчета.ИТК07Сформировать(
        ЭтаФорма.ИТК07ДатаНачала, ЭтаФорма.ИТК07ДатаОкончания,
        ЭтаФорма.ИТК07Точка, ЭтаФорма.ИТК07Категория, ИТК07Периодичность);
    // Результат - штатный реквизит формы типа ТабличныйДокумент, а не локальная переменная.
    Результат = ИТК07ТабличныйДокумент;
КонецПроцедуры

&НаСервере
Процедура ИТК07Поле(Имя, Путь, Заголовок, Родитель, Флажок = Ложь)
    ИТК07Элемент = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Если Флажок Тогда
        ИТК07Элемент.Вид = ВидПоляФормы.ПолеФлажка;
    Иначе
        ИТК07Элемент.Вид = ВидПоляФормы.ПолеВвода;
    КонецЕсли;
    ИТК07Элемент.ПутьКДанным = Путь;
    ИТК07Элемент.Заголовок = Заголовок;
    Если СтрНайти(Путь, "Дата") > 0 Тогда
        ИТК07Элемент.Формат = "ДФ=dd.MM.yyyy";
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
