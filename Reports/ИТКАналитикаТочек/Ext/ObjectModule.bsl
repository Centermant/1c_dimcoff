#Область ПрограммныйИнтерфейс

// Параметры: даты включительно; пустая точка/категория означает все значения.
// Возвращает Структуру с таблицами отчёта. Операции записи не выполняются.
Функция ИТК07ПолучитьДанные(ДатаНачала, ДатаОкончания, ТорговаяТочка = Неопределено,
    Категория = Неопределено, Периодичность = "День") Экспорт

    Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания)
        Или НачалоДня(ДатаНачала) > НачалоДня(ДатаОкончания)
        Или НачалоДня(ДатаОкончания) > НачалоДня(ТекущаяДатаСеанса()) Тогда
        ВызватьИсключение "Укажите начало и окончание периода: начало не позже окончания, окончание не в будущем.";
    КонецЕсли;
    Если Периодичность <> "День" И Периодичность <> "Месяц" Тогда
        ВызватьИсключение "Периодичность должна быть День или Месяц.";
    КонецЕсли;
    ИТК07Начало = НачалоДня(ДатаНачала);
    ИТК07Конец = Мин(КонецДня(ДатаОкончания), ТекущаяДатаСеанса());
    Если ТорговаяТочка = Неопределено Тогда
        ТорговаяТочка = Справочники.ТочкиПродаж.ПустаяСсылка();
    КонецЕсли;
    Если Категория = Неопределено Тогда
        Категория = Перечисления.ВидАссортимента.ПустаяСсылка();
    КонецЕсли;
    ИТК07Дней = (НачалоДня(ДатаОкончания) - ИТК07Начало) / 86400 + 1;
    ИТК07Параметры = Новый Структура("Начало,Конец,Дней,Точка,Категория,ЕстьТочка,ЕстьКатегория",
        ИТК07Начало, ИТК07Конец, ИТК07Дней, ТорговаяТочка, Категория,
        ЗначениеЗаполнено(ТорговаяТочка), ЗначениеЗаполнено(Категория));
    ИТК07Показатели = ИТК07Таблица(
        "Точка,ИмяТочки,Товар,ИмяТовара,Категория,Единица,Продано,Выручка,Себестоимость,Прибыль,Маржа,НеОценено,"
        + "НачальныйОстаток,Остаток,СреднийОстаток,Оборачиваемость,План,Поставлено,Дефицит,Цена,СтоимостьЕдиницы,"
        + "СтоимостьОстатка,СтоимостьДефицита,ПлощадьОстатка,ОшибкаОстатка,ОшибкаЕдиниц,ДвиженияДней");
    ИТК07Продажи = ИТК07Таблица("Период,Точка,ИмяТочки,Категория,Выручка,Себестоимость,Прибыль,Маржа,НеОценено");
    ИТК07ИндексТоваров = Новый Соответствие;
    ИТК07ИндексПериодов = Новый Соответствие;
    ИТК07Предупреждения = Новый Массив;
    ИТК07Единицы = ИТК07ПолучитьЕдиницы();

    // Все чтения пакетные. В циклах ниже используются только таблицы и соответствия в памяти.
    ИТК07Доставки = ИТК07Запрос(
        "ВЫБРАТЬ Строки.Ссылка.Дата КАК Дата, Строки.Ссылка.ТорговаяТочка КАК Точка,
        | Строки.Ссылка.ТорговаяТочка.Наименование КАК ИмяТочки, Строки.Товар КАК Товар,
        | Строки.Товар.Наименование КАК ИмяТовара, Строки.Товар.ВидАссортимента КАК Категория,
        | Строки.Количество КАК Количество, Строки.ЕдиницыИзмерения КАК Единица
        |ИЗ Документ.ТоварноТранспортнаяНакладная.Товары КАК Строки
        |ГДЕ Строки.Ссылка.Проведен И НЕ Строки.Ссылка.ПометкаУдаления И Строки.Ссылка.Дата <= &Конец
        | И (НЕ &ЕстьТочка ИЛИ Строки.Ссылка.ТорговаяТочка = &Точка)
        | И (НЕ &ЕстьКатегория ИЛИ Строки.Товар.ВидАссортимента = &Категория)", ИТК07Параметры);
    ИТК07СырыеПродажи = ИТК07Запрос(
        "ВЫБРАТЬ Строки.Ссылка.Дата КАК Дата, Строки.Ссылка.ТочкаПродажи КАК Точка,
        | Строки.Ссылка.ТочкаПродажи.Наименование КАК ИмяТочки, Строки.Товар КАК Товар,
        | Строки.Товар.Наименование КАК ИмяТовара, Строки.Товар.ВидАссортимента КАК Категория,
        | Строки.Количество КАК Количество, Строки.Сумма КАК Выручка
        |ИЗ Документ.РозничнаяПродажа.Товары КАК Строки
        |ГДЕ Строки.Ссылка.Проведен И НЕ Строки.Ссылка.ПометкаУдаления И Строки.Ссылка.Дата <= &Конец
        | И (НЕ &ЕстьТочка ИЛИ Строки.Ссылка.ТочкаПродажи = &Точка)
        | И (НЕ &ЕстьКатегория ИЛИ Строки.Товар.ВидАссортимента = &Категория)", ИТК07Параметры);
    ИТК07Заявки = ИТК07Запрос(
        "ВЫБРАТЬ Строки.Ссылка.ТорговаяТочка КАК Точка,
        | Строки.Ссылка.ТорговаяТочка.Наименование КАК ИмяТочки, Строки.Ассортимент КАК Товар,
        | Строки.Ассортимент.Наименование КАК ИмяТовара, Строки.Ассортимент.ВидАссортимента КАК Категория,
        | Строки.Количество КАК Количество, Строки.ЕдиницыИзмерения КАК Единица
        |ИЗ Документ.ЗаявкаТорговойТочки.Товары КАК Строки
        |ГДЕ Строки.Ссылка.Проведен И НЕ Строки.Ссылка.ПометкаУдаления
        | И Строки.Ссылка.Дата >= &Начало И Строки.Ссылка.Дата <= &Конец
        | И (НЕ &ЕстьТочка ИЛИ Строки.Ссылка.ТорговаяТочка = &Точка)
        | И (НЕ &ЕстьКатегория ИЛИ Строки.Ассортимент.ВидАссортимента = &Категория)", ИТК07Параметры);
    ИТК07Нехватка = ИТК07ПолучитьДефицит(ИТК07Параметры);
    ИТК07СписокТоваров = Новый Массив;
    ИТК07Наборы = Новый Массив;
    ИТК07Наборы.Добавить(ИТК07Доставки); ИТК07Наборы.Добавить(ИТК07СырыеПродажи);
    ИТК07Наборы.Добавить(ИТК07Заявки); ИТК07Наборы.Добавить(ИТК07Нехватка);
    Для Каждого ИТК07Набор Из ИТК07Наборы Цикл
        Для Каждого ИТК07ИсходнаяСтрока Из ИТК07Набор Цикл
            Если ИТК07СписокТоваров.Найти(ИТК07ИсходнаяСтрока.Товар) = Неопределено Тогда
                ИТК07СписокТоваров.Добавить(ИТК07ИсходнаяСтрока.Товар);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    ИТК07Параметры.Вставить("Товары", ИТК07СписокТоваров);
    ИТК07ИсторияЦен = ИТК07ПолучитьИсториюСтоимости(ИТК07Параметры, ИТК07Единицы);

    Для Каждого ИТК07Доставка Из ИТК07Доставки Цикл
        ИТК07Строка = ИТК07СтрокаТовара(ИТК07Показатели, ИТК07ИндексТоваров, ИТК07Доставка, ИТК07Единицы);
        ИТК07Количество = ИТК07КоличествоВРознице(ИТК07Единицы, ИТК07Доставка.Товар,
            ИТК07Доставка.Единица, ИТК07Доставка.Количество);
        Если ИТК07Количество = Неопределено Тогда
            ИТК07Строка.ОшибкаЕдиниц = Истина;
            Продолжить;
        КонецЕсли;
        ИТК07ДвижениеОстатка(ИТК07Строка, ИТК07Доставка.Дата, ИТК07Количество, ИТК07Параметры);
        Если ИТК07Доставка.Дата >= ИТК07Начало Тогда
            ИТК07Строка.Поставлено = ИТК07Строка.Поставлено + ИТК07Количество;
        КонецЕсли;
    КонецЦикла;
    Для Каждого ИТК07Продажа Из ИТК07СырыеПродажи Цикл
        ИТК07Строка = ИТК07СтрокаТовара(ИТК07Показатели, ИТК07ИндексТоваров, ИТК07Продажа, ИТК07Единицы);
        ИТК07ДвижениеОстатка(ИТК07Строка, ИТК07Продажа.Дата, -ИТК07Продажа.Количество, ИТК07Параметры);
        Если ИТК07Продажа.Дата < ИТК07Начало Тогда
            Продолжить;
        КонецЕсли;
        ИТК07Период = НачалоДня(ИТК07Продажа.Дата);
        Если Периодичность = "Месяц" Тогда
            ИТК07Период = НачалоМесяца(ИТК07Период);
        КонецЕсли;
        ИТК07ПериодСтрока = ИТК07СтрокаПериода(ИТК07Продажи, ИТК07ИндексПериодов, ИТК07Продажа, ИТК07Период);
        ИТК07Строка.Продано = ИТК07Строка.Продано + ИТК07Продажа.Количество;
        ИТК07Строка.Выручка = ИТК07Строка.Выручка + ИТК07Продажа.Выручка;
        ИТК07ПериодСтрока.Выручка = ИТК07ПериодСтрока.Выручка + ИТК07Продажа.Выручка;
        ИТК07Стоимость = ИТК07СтоимостьНаДату(ИТК07ИсторияЦен, ИТК07Продажа.Товар, ИТК07Продажа.Дата);
        Если ИТК07Стоимость = Неопределено Тогда
            ИТК07Строка.НеОценено = Истина;
            ИТК07ПериодСтрока.НеОценено = Истина;
        Иначе
            ИТК07Затраты = Окр(ИТК07Продажа.Количество * ИТК07Стоимость, 2);
            ИТК07Строка.Себестоимость = ИТК07Строка.Себестоимость + ИТК07Затраты;
            ИТК07ПериодСтрока.Себестоимость = ИТК07ПериодСтрока.Себестоимость + ИТК07Затраты;
        КонецЕсли;
    КонецЦикла;
    Для Каждого ИТК07План Из ИТК07Заявки Цикл
        ИТК07Строка = ИТК07СтрокаТовара(ИТК07Показатели, ИТК07ИндексТоваров, ИТК07План, ИТК07Единицы);
        ИТК07Количество = ИТК07КоличествоВРознице(ИТК07Единицы, ИТК07План.Товар, ИТК07План.Единица, ИТК07План.Количество);
        Если ИТК07Количество = Неопределено Тогда
            ИТК07Строка.ОшибкаЕдиниц = Истина;
        Иначе
            ИТК07Строка.План = ИТК07Строка.План + ИТК07Количество;
        КонецЕсли;
    КонецЦикла;
    Для Каждого ИТК07Дефицит Из ИТК07Нехватка Цикл
        ИТК07Строка = ИТК07СтрокаТовара(ИТК07Показатели, ИТК07ИндексТоваров, ИТК07Дефицит, ИТК07Единицы);
        ИТК07Количество = ИТК07КоличествоВРознице(ИТК07Единицы, ИТК07Дефицит.Товар, ИТК07Дефицит.Единица,
            Макс(0, ИТК07Дефицит.Количество));
        Если ИТК07Количество = Неопределено Тогда
            ИТК07Строка.ОшибкаЕдиниц = Истина;
        Иначе
            ИТК07Строка.Дефицит = ИТК07Строка.Дефицит + ИТК07Количество;
        КонецЕсли;
    КонецЦикла;
    ИТК07Товары = ИТК07Показатели.ВыгрузитьКолонку("Товар");
    ИТК07Цены = Неопределено;
    Если ИТК07Товары.Количество() > 0 Тогда
        ИТК07Цены = ИТКМаржаСервер.ПолучитьДанныеЕдиницЦен(ИТК07Товары, ИТК07Конец);
    КонецЕсли;
    Для Каждого ИТК07Строка Из ИТК07Показатели Цикл
        ИТК07ЗавершитьПрибыль(ИТК07Строка);
        ИТК07Строка.СреднийОстаток = ИТК07Строка.ПлощадьОстатка / ИТК07Дней;
        ИТК07Строка.ОшибкаОстатка = ИТК07Строка.НачальныйОстаток < 0 Или ИТК07Строка.Остаток < 0
            Или ИТК07Строка.СреднийОстаток < 0;
        ИТК07Строка.ДвиженияДней.Свернуть("Дата", "Количество");
        ИТК07Строка.ДвиженияДней.Сортировать("Дата");
        ИТК07ДневнойОстаток = ИТК07Строка.НачальныйОстаток;
        Для Каждого ИТК07ДневноеДвижение Из ИТК07Строка.ДвиженияДней Цикл
            ИТК07ДневнойОстаток = ИТК07ДневнойОстаток + ИТК07ДневноеДвижение.Количество;
            Если ИТК07ДневнойОстаток < 0 Тогда
                ИТК07Строка.ОшибкаОстатка = Истина;
            КонецЕсли;
        КонецЦикла;
        ИТК07Строка.Оборачиваемость = Неопределено;
        Если ИТК07Строка.Продано > 0 И Не ИТК07Строка.ОшибкаОстатка И Не ИТК07Строка.ОшибкаЕдиниц Тогда
            ИТК07Строка.Оборачиваемость = ИТК07Строка.СреднийОстаток / (ИТК07Строка.Продано / ИТК07Дней);
        КонецЕсли;
        ИТК07Строка.СтоимостьЕдиницы = ИТК07СтоимостьНаДату(ИТК07ИсторияЦен, ИТК07Строка.Товар, ИТК07Конец);
        ИТК07Строка.Цена = 0;
        Если ЗначениеЗаполнено(ИТК07Строка.Единица) Тогда
            Попытка
                ИТК07Строка.Цена = ИТКМаржаСервер.ЦенаДляЕдиницыИзДанных(ИТК07Цены, ИТК07Строка.Товар, ИТК07Строка.Единица);
            Исключение
                ИТК07Предупреждения.Добавить(ИТК07Строка.ИмяТовара + ": не удалось пересчитать розничную цену: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЕсли;
        ИТК07Строка.СтоимостьОстатка = Неопределено;
        Если ИТК07Строка.СтоимостьЕдиницы <> Неопределено И Не ИТК07Строка.ОшибкаЕдиниц Тогда
            ИТК07Строка.СтоимостьОстатка = Окр(ИТК07Строка.Остаток * ИТК07Строка.СтоимостьЕдиницы, 2);
        КонецЕсли;
        ИТК07Строка.СтоимостьДефицита = Неопределено;
        Если ИТК07Строка.Цена > 0 И Не ИТК07Строка.ОшибкаЕдиниц Тогда
            ИТК07Строка.СтоимостьДефицита = Окр(ИТК07Строка.Дефицит * ИТК07Строка.Цена, 2);
        КонецЕсли;
        Если ИТК07Строка.НеОценено Тогда
            ИТК07Предупреждения.Добавить(ИТК07Строка.ИмяТовара + ": нет себестоимости на дату части продаж; прибыль и маржа не рассчитаны.");
        КонецЕсли;
        Если ИТК07Строка.ОшибкаОстатка Тогда
            ИТК07Предупреждения.Добавить(ИТК07Строка.ИмяТочки + " / " + ИТК07Строка.ИмяТовара
                + ": продажи превышают доставку; проверьте исходные документы.");
        КонецЕсли;
        Если ИТК07Строка.Остаток > 0 И ИТК07Строка.СтоимостьЕдиницы = Неопределено Тогда
            ИТК07Предупреждения.Добавить(ИТК07Строка.ИмяТовара + ": остаток без оценки не включён в стоимостный топ.");
        КонецЕсли;
        Если ИТК07Строка.Дефицит > 0 И ИТК07Строка.Цена <= 0 Тогда
            ИТК07Предупреждения.Добавить(ИТК07Строка.ИмяТовара + ": дефицит без розничной цены не включён в стоимостный топ.");
        КонецЕсли;
        Если ИТК07Строка.ОшибкаЕдиниц Тогда
            ИТК07Предупреждения.Добавить(ИТК07Строка.ИмяТочки + " / " + ИТК07Строка.ИмяТовара
                + ": единицы документа не согласованы с карточкой; количественные показатели помечены как неизвестные.");
            Для Каждого ИТК07Имя Из СтрРазделить("НачальныйОстаток,Остаток,СреднийОстаток,Оборачиваемость,План,Поставлено,Дефицит", ",") Цикл
                ИТК07Строка[ИТК07Имя] = Неопределено;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Для Каждого ИТК07ПериодСтрока Из ИТК07Продажи Цикл
        ИТК07ЗавершитьПрибыль(ИТК07ПериодСтрока);
    КонецЦикла;
    ИТК07Продажи.Сортировать("Период, ИмяТочки, Категория");
    ИТК07Показатели.Сортировать("ИмяТочки, ИмяТовара");
    ИТК07ABC = ИТК07СформироватьABC(ИТК07Показатели);
    ИТК07Закупки = ИТК07ПолучитьЗакупки(ИТК07Параметры, ИТК07Единицы, ИТК07Предупреждения);
    Возврат Новый Структура("Продажи,Товары,ABC,Закупки,ТопДефицит,ТопОстатки,Предупреждения,Начало,Конец,Дней,Точка,Категория",
        ИТК07Продажи, ИТК07Показатели, ИТК07ABC, ИТК07Закупки,
        ИТК07Топ(ИТК07Показатели, "СтоимостьДефицита", "Дефицит"),
        ИТК07Топ(ИТК07Показатели, "СтоимостьОстатка", "Остаток"),
        ИТК07Предупреждения, ИТК07Начало, ИТК07Конец, ИТК07Дней, ТорговаяТочка, Категория);
КонецФункции

// Возвращает готовый табличный документ для формы или программного формирования отчёта.
Функция ИТК07Сформировать(ДатаНачала, ДатаОкончания, ТорговаяТочка = Неопределено,
    Категория = Неопределено, Периодичность = "День") Экспорт
    ИТК07Данные = ИТК07ПолучитьДанные(ДатаНачала, ДатаОкончания, ТорговаяТочка, Категория, Периодичность);
    Возврат ИТК07ВывестиОтчет(ИТК07Данные);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИТК07Запрос(ТекстЗапроса, Параметры)
    ИТК07Запрос = Новый Запрос(ТекстЗапроса);
    Для Каждого ИТК07Параметр Из Параметры Цикл
        ИТК07Запрос.УстановитьПараметр(ИТК07Параметр.Ключ, ИТК07Параметр.Значение);
    КонецЦикла;
    Возврат ИТК07Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ИТК07Таблица(Имена)
    ИТК07Таблица = Новый ТаблицаЗначений;
    Для Каждого ИТК07Имя Из СтрРазделить(Имена, ",") Цикл
        ИТК07Таблица.Колонки.Добавить(ИТК07Имя);
    КонецЦикла;
    Возврат ИТК07Таблица;
КонецФункции

Функция ИТК07Ключ(Точка, Товар)
    Возврат Строка(Точка.УникальныйИдентификатор()) + "/" + Строка(Товар.УникальныйИдентификатор());
КонецФункции

Функция ИТК07ПолучитьЕдиницы()
    ИТК07Запрос = Новый Запрос(
        "ВЫБРАТЬ Единицы.Ссылка КАК Товар, Единицы.ВходящиеЕдиницыИзмерения КАК Входящая,
        | Единицы.ВнутренниеЕдиницыИзмерения КАК Розничная, Единицы.Коэффициент КАК Коэффициент
        |ИЗ Справочник.Ассортимент.Единицы КАК Единицы");
    Возврат ИТК07Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ИТК07ЕдиницаРозницы(Единицы, Товар)
    ИТК07Строки = Единицы.НайтиСтроки(Новый Структура("Товар", Товар));
    ИТК07Единица = Неопределено;
    Для Каждого ИТК07Строка Из ИТК07Строки Цикл
        Если Не ЗначениеЗаполнено(ИТК07Строка.Розничная) Или Не ЗначениеЗаполнено(ИТК07Строка.Входящая)
            Или ИТК07Строка.Коэффициент <= 0 Тогда
            Возврат Перечисления.ЕдиницыИзмерения.ПустаяСсылка();
        КонецЕсли;
        Если ИТК07Единица <> Неопределено И ИТК07Единица <> ИТК07Строка.Розничная Тогда
            Возврат Перечисления.ЕдиницыИзмерения.ПустаяСсылка();
        КонецЕсли;
        ИТК07Единица = ИТК07Строка.Розничная;
    КонецЦикла;
    Если ИТК07Единица = Неопределено Тогда
        Возврат Перечисления.ЕдиницыИзмерения.ПустаяСсылка();
    КонецЕсли;
    Возврат ИТК07Единица;
КонецФункции

Функция ИТК07КоличествоВРознице(Единицы, Товар, Единица, Количество)
    ИТК07Розничная = ИТК07ЕдиницаРозницы(Единицы, Товар);
    Если Не ЗначениеЗаполнено(ИТК07Розничная) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Единица = ИТК07Розничная Тогда
        Возврат Количество;
    КонецЕсли;
    ИТК07Строки = Единицы.НайтиСтроки(Новый Структура("Товар,Входящая", Товар, Единица));
    ИТК07Коэффициент = Неопределено;
    Для Каждого ИТК07Строка Из ИТК07Строки Цикл
        Если ИТК07Коэффициент <> Неопределено И ИТК07Коэффициент <> ИТК07Строка.Коэффициент Тогда
            Возврат Неопределено;
        КонецЕсли;
        ИТК07Коэффициент = ИТК07Строка.Коэффициент;
    КонецЦикла;
    Если ИТК07Коэффициент = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Количество * ИТК07Коэффициент;
КонецФункции

Функция ИТК07СтрокаТовара(Таблица, Индекс, Данные, Единицы)
    ИТК07Ключ = ИТК07Ключ(Данные.Точка, Данные.Товар);
    ИТК07Строка = Индекс.Получить(ИТК07Ключ);
    Если ИТК07Строка = Неопределено Тогда
        ИТК07Строка = Таблица.Добавить();
        ЗаполнитьЗначенияСвойств(ИТК07Строка, Данные, "Точка,ИмяТочки,Товар,ИмяТовара,Категория");
        ИТК07Строка.Единица = ИТК07ЕдиницаРозницы(Единицы, Данные.Товар);
        Для Каждого ИТК07Имя Из СтрРазделить(
            "Продано,Выручка,Себестоимость,НачальныйОстаток,Остаток,СреднийОстаток,План,Поставлено,Дефицит,ПлощадьОстатка", ",") Цикл
            ИТК07Строка[ИТК07Имя] = 0;
        КонецЦикла;
        ИТК07Строка.НеОценено = Ложь;
        ИТК07Строка.ОшибкаЕдиниц = Не ЗначениеЗаполнено(ИТК07Строка.Единица);
        ИТК07Строка.ДвиженияДней = ИТК07Таблица("Дата,Количество");
        Индекс.Вставить(ИТК07Ключ, ИТК07Строка);
    КонецЕсли;
    Возврат ИТК07Строка;
КонецФункции

Функция ИТК07СтрокаПериода(Таблица, Индекс, Данные, Период)
    ИТК07Ключ = Строка(Данные.Точка.УникальныйИдентификатор()) + "/" + Строка(Данные.Категория) + "/" + Строка(Период);
    ИТК07Строка = Индекс.Получить(ИТК07Ключ);
    Если ИТК07Строка = Неопределено Тогда
        ИТК07Строка = Таблица.Добавить();
        ЗаполнитьЗначенияСвойств(ИТК07Строка, Данные, "Точка,ИмяТочки,Категория");
        ИТК07Строка.Период = Период;
        ИТК07Строка.Выручка = 0; ИТК07Строка.Себестоимость = 0; ИТК07Строка.НеОценено = Ложь;
        Индекс.Вставить(ИТК07Ключ, ИТК07Строка);
    КонецЕсли;
    Возврат ИТК07Строка;
КонецФункции

Процедура ИТК07ДвижениеОстатка(СтрокаТовара, ДатаДвижения, Количество, Параметры)
    СтрокаТовара.Остаток = СтрокаТовара.Остаток + Количество;
    Если ДатаДвижения < Параметры.Начало Тогда
        СтрокаТовара.НачальныйОстаток = СтрокаТовара.НачальныйОстаток + Количество;
        СтрокаТовара.ПлощадьОстатка = СтрокаТовара.ПлощадьОстатка + Количество * Параметры.Дней;
    Иначе
        ИТК07ДнейДоКонца = (НачалоДня(Параметры.Конец) - НачалоДня(ДатаДвижения)) / 86400 + 1;
        СтрокаТовара.ПлощадьОстатка = СтрокаТовара.ПлощадьОстатка + Количество * ИТК07ДнейДоКонца;
        ИТК07Дневное = СтрокаТовара.ДвиженияДней.Добавить();
        ИТК07Дневное.Дата = НачалоДня(ДатаДвижения); ИТК07Дневное.Количество = Количество;
    КонецЕсли;
КонецПроцедуры

Функция ИТК07ПолучитьИсториюСтоимости(Параметры, Единицы)
    ИТК07История = ИТК07Запрос(
        "ВЫБРАТЬ Приемки.Товар КАК Товар, Приемки.Дата КАК Дата,
        | Приемки.ИТКСебестоимостьЕдиницы КАК Стоимость, Приемки.ЕдиницыИзмерения КАК Единица
        |ИЗ Документ.ИТКПриемкаПартии КАК Приемки
        |ГДЕ Приемки.Проведен И НЕ Приемки.ПометкаУдаления И Приемки.Дата <= &Конец
        | И Приемки.Товар В (&Товары)
        | И (НЕ &ЕстьКатегория ИЛИ Приемки.Товар.ВидАссортимента = &Категория)
        |УПОРЯДОЧИТЬ ПО Товар, Дата УБЫВ, Приемки.Ссылка УБЫВ", Параметры);
    Для Каждого ИТК07Строка Из ИТК07История Цикл
        Если ИТК07Строка.Стоимость > 0 Тогда
            ИТК07ВРознице = ИТК07КоличествоВРознице(Единицы, ИТК07Строка.Товар, ИТК07Строка.Единица, 1);
            Если ИТК07ВРознице = Неопределено Тогда
                ИТК07Строка.Стоимость = 0;
            Иначе
                ИТК07Строка.Стоимость = ИТК07Строка.Стоимость / ИТК07ВРознице;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат ИТК07История;
КонецФункции

Функция ИТК07СтоимостьНаДату(История, Товар, Дата)
    Для Каждого ИТК07Строка Из История.НайтиСтроки(Новый Структура("Товар", Товар)) Цикл
        Если ИТК07Строка.Дата <= Дата Тогда
            Если ИТК07Строка.Стоимость > 0 Тогда
                Возврат ИТК07Строка.Стоимость;
            КонецЕсли;
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Процедура ИТК07ЗавершитьПрибыль(СтрокаДанных)
    СтрокаДанных.Прибыль = Неопределено; СтрокаДанных.Маржа = Неопределено;
    Если Не СтрокаДанных.НеОценено Тогда
        СтрокаДанных.Прибыль = СтрокаДанных.Выручка - СтрокаДанных.Себестоимость;
        Если СтрокаДанных.Выручка > 0 Тогда
            СтрокаДанных.Маржа = СтрокаДанных.Прибыль / СтрокаДанных.Выручка * 100;
        КонецЕсли;
    Иначе
        СтрокаДанных.Себестоимость = Неопределено;
    КонецЕсли;
КонецПроцедуры

Функция ИТК07ПолучитьДефицит(Параметры)
    // Та же семантика ожидания и годных резервов, что в отчёте требований №4/№5/№1.
    Возврат ИТК07Запрос(
        "ВЫБРАТЬ Остатки.Заявка КАК Заявка, Остатки.Ассортимент КАК Товар,
        | Остатки.ТорговаяТочка КАК Точка, Остатки.ЕдиницыИзмерения КАК Единица,
        | СУММА(Остатки.КоличествоОстаток) КАК Количество
        |ПОМЕСТИТЬ ВТПлан
        |ИЗ РегистрНакопления.Заявки.Остатки(&Конец) КАК Остатки
        |ГДЕ Остатки.Заявка.Проведен И НЕ Остатки.Заявка.ПометкаУдаления
        | И (НЕ &ЕстьТочка ИЛИ Остатки.ТорговаяТочка = &Точка)
        | И (НЕ &ЕстьКатегория ИЛИ Остатки.Ассортимент.ВидАссортимента = &Категория)
        |СГРУППИРОВАТЬ ПО Остатки.Заявка, Остатки.Ассортимент, Остатки.ТорговаяТочка, Остатки.ЕдиницыИзмерения
        |;
        |ВЫБРАТЬ Строки.Ссылка.Заявка КАК Заявка, Строки.Товар КАК Товар,
        | Строки.ЕдиницыИзмерения КАК Единица, СУММА(Строки.Количество) КАК Количество
        |ПОМЕСТИТЬ ВТОтгрузки
        |ИЗ Документ.ТоварноТранспортнаяНакладная.Товары КАК Строки
        |ГДЕ Строки.Ссылка.Проведен И НЕ Строки.Ссылка.ПометкаУдаления И Строки.Ссылка.Дата <= &Конец
        |СГРУППИРОВАТЬ ПО Строки.Ссылка.Заявка, Строки.Товар, Строки.ЕдиницыИзмерения
        |;
        |ВЫБРАТЬ Резервы.Заявка КАК Заявка, Резервы.Товар КАК Товар,
        | Резервы.ЕдиницыИзмерения КАК Единица, СУММА(Резервы.КоличествоОстаток) КАК Количество
        |ПОМЕСТИТЬ ВТРезервы
        |ИЗ РегистрНакопления.ИТКРезервыТоваров.Остатки(&Конец,
        | Партия.СрокГодности >= НАЧАЛОПЕРИОДА(&Конец, ДЕНЬ)) КАК Резервы
        |СГРУППИРОВАТЬ ПО Резервы.Заявка, Резервы.Товар, Резервы.ЕдиницыИзмерения
        |;
        |ВЫБРАТЬ План.Точка КАК Точка, План.Точка.Наименование КАК ИмяТочки,
        | План.Товар КАК Товар, План.Товар.Наименование КАК ИмяТовара,
        | План.Товар.ВидАссортимента КАК Категория, План.Единица КАК Единица,
        | План.Количество - ЕСТЬNULL(Отгрузки.Количество, 0) - ЕСТЬNULL(Резервы.Количество, 0) КАК Количество
        |ИЗ ВТПлан КАК План
        | ЛЕВОЕ СОЕДИНЕНИЕ ВТОтгрузки КАК Отгрузки
        | ПО План.Заявка = Отгрузки.Заявка И План.Товар = Отгрузки.Товар И План.Единица = Отгрузки.Единица
        | ЛЕВОЕ СОЕДИНЕНИЕ ВТРезервы КАК Резервы
        | ПО План.Заявка = Резервы.Заявка И План.Товар = Резервы.Товар И План.Единица = Резервы.Единица", Параметры);
КонецФункции

Функция ИТК07СформироватьABC(Показатели)
    ИТК07ABC = ИТК07Таблица("Товар,ИмяТовара,Категория,Выручка,Прибыль,НеОценено,ДоляВыручки,ABCВыручки,ДоляПрибыли,ABCПрибыли");
    ИТК07Индекс = Новый Соответствие;
    Для Каждого ИТК07Показатель Из Показатели Цикл
        ИТК07Строка = ИТК07Индекс.Получить(ИТК07Показатель.Товар);
        Если ИТК07Строка = Неопределено Тогда
            ИТК07Строка = ИТК07ABC.Добавить();
            ЗаполнитьЗначенияСвойств(ИТК07Строка, ИТК07Показатель, "Товар,ИмяТовара,Категория");
            ИТК07Строка.Выручка = 0; ИТК07Строка.Прибыль = 0; ИТК07Строка.НеОценено = Ложь;
            ИТК07Индекс.Вставить(ИТК07Показатель.Товар, ИТК07Строка);
        КонецЕсли;
        ИТК07Строка.Выручка = ИТК07Строка.Выручка + ИТК07Показатель.Выручка;
        Если ИТК07Показатель.Прибыль = Неопределено Тогда
            ИТК07Строка.НеОценено = Истина;
        Иначе
            ИТК07Строка.Прибыль = ИТК07Строка.Прибыль + ИТК07Показатель.Прибыль;
        КонецЕсли;
    КонецЦикла;
    ИТК07ВсегоПрибыль = 0;
    Для Каждого ИТК07Строка Из ИТК07ABC Цикл
        Если ИТК07Строка.НеОценено Тогда
            ИТК07Строка.Прибыль = Неопределено;
        Иначе
            ИТК07ВсегоПрибыль = ИТК07ВсегоПрибыль + Макс(0, ИТК07Строка.Прибыль);
        КонецЕсли;
    КонецЦикла;
    ИТК07ВсегоВыручка = ИТК07ABC.Итог("Выручка");
    ИТК07ABC.Сортировать("Выручка Убыв, ИмяТовара");
    ИТК07Накоплено = 0;
    Для Каждого ИТК07Строка Из ИТК07ABC Цикл
        ИТК07Строка.ДоляВыручки = Неопределено; ИТК07Строка.ABCВыручки = "-";
        Если ИТК07ВсегоВыручка > 0 Тогда
            ИТК07Строка.ДоляВыручки = ИТК07Строка.Выручка / ИТК07ВсегоВыручка * 100;
            ИТК07Строка.ABCВыручки = ИТК07КлассABC(ИТК07Накоплено, ИТК07Строка.Выручка);
            ИТК07Накоплено = ИТК07Накоплено + ИТК07Строка.ДоляВыручки;
        КонецЕсли;
    КонецЦикла;
    ИТК07ABC.Сортировать("Прибыль Убыв, ИмяТовара");
    ИТК07Накоплено = 0;
    Для Каждого ИТК07Строка Из ИТК07ABC Цикл
        ИТК07Строка.ДоляПрибыли = Неопределено; ИТК07Строка.ABCПрибыли = "-";
        Если Не ИТК07Строка.НеОценено И ИТК07ВсегоПрибыль > 0 Тогда
            ИТК07Строка.ДоляПрибыли = Макс(0, ИТК07Строка.Прибыль) / ИТК07ВсегоПрибыль * 100;
            ИТК07Строка.ABCПрибыли = ИТК07КлассABC(ИТК07Накоплено, ИТК07Строка.Прибыль);
            ИТК07Накоплено = ИТК07Накоплено + ИТК07Строка.ДоляПрибыли;
        КонецЕсли;
    КонецЦикла;
    ИТК07ABC.Сортировать("Выручка Убыв, ИмяТовара");
    Возврат ИТК07ABC;
КонецФункции

Функция ИТК07КлассABC(НакопленоДоТовара, Вклад)
    Если Вклад <= 0 Тогда
        Возврат "C";
    ИначеЕсли НакопленоДоТовара < 80 Тогда
        Возврат "A";
    ИначеЕсли НакопленоДоТовара < 95 Тогда
        Возврат "B";
    КонецЕсли;
    Возврат "C";
КонецФункции

Функция ИТК07ПолучитьЗакупки(Параметры, Единицы, Предупреждения)
    ИТК07Распределение = ИТК07РаспределениеЗакупок(Параметры, Предупреждения);
    ИТК07План = ИТК07Запрос(
        "ВЫБРАТЬ Строки.Ссылка КАК Заказ, Строки.Товар КАК Товар,
        | Строки.Товар.Наименование КАК ИмяТовара, Строки.ЕдиницыИзмерения КАК Единица,
        | Строки.Количество КАК Количество
        |ИЗ Документ.ИТКЗаказПоставщику.Товары КАК Строки
        |ГДЕ НЕ Строки.Ссылка.ПометкаУдаления И Строки.Ссылка.Дата >= &Начало И Строки.Ссылка.Дата <= &Конец
        | И Строки.Ссылка.Состояние <> ЗНАЧЕНИЕ(Перечисление.ИТКСостоянияЗаказов.Отменен)
        | И (НЕ &ЕстьКатегория ИЛИ Строки.Товар.ВидАссортимента = &Категория)", Параметры);
    ИТК07Факт = ИТК07Запрос(
        "ВЫБРАТЬ Приемки.ИТКЗаказПоставщику КАК Заказ, Приемки.Товар КАК Товар,
        | Приемки.Товар.Наименование КАК ИмяТовара, Приемки.ЕдиницыИзмерения КАК Единица,
        | Приемки.Количество КАК Количество, Приемки.ИТКСебестоимостьПартии КАК Стоимость
        |ИЗ Документ.ИТКПриемкаПартии КАК Приемки
        |ГДЕ Приемки.Проведен И НЕ Приемки.ПометкаУдаления И Приемки.Дата >= &Начало И Приемки.Дата <= &Конец
        | И (НЕ &ЕстьКатегория ИЛИ Приемки.Товар.ВидАссортимента = &Категория)", Параметры);
    ИТК07Таблица = ИТК07Таблица("Товар,ИмяТовара,Единица,ПланЗакупки,ФактЗакупки,СтоимостьПриемок,НеОценено");
    ИТК07Индекс = Новый Соответствие;
    ИТК07Наборы = Новый Массив; ИТК07Наборы.Добавить(ИТК07План); ИТК07Наборы.Добавить(ИТК07Факт);
    Для ИТК07Номер = 0 По 1 Цикл
        Для Каждого ИТК07Данные Из ИТК07Наборы[ИТК07Номер] Цикл
            ИТК07Доля = ИТК07ДоляТочки(ИТК07Распределение, ИТК07Данные, Параметры);
            Если ИТК07Доля <= 0 Тогда
                Продолжить;
            КонецЕсли;
            ИТК07Строка = ИТК07Индекс.Получить(ИТК07Данные.Товар);
            Если ИТК07Строка = Неопределено Тогда
                ИТК07Строка = ИТК07Таблица.Добавить();
                ЗаполнитьЗначенияСвойств(ИТК07Строка, ИТК07Данные, "Товар,ИмяТовара");
                ИТК07Строка.Единица = ИТК07ЕдиницаРозницы(Единицы, ИТК07Данные.Товар);
                ИТК07Строка.ПланЗакупки = 0; ИТК07Строка.ФактЗакупки = 0;
                ИТК07Строка.СтоимостьПриемок = 0; ИТК07Строка.НеОценено = Ложь;
                ИТК07Индекс.Вставить(ИТК07Данные.Товар, ИТК07Строка);
            КонецЕсли;
            ИТК07Количество = ИТК07КоличествоВРознице(Единицы, ИТК07Данные.Товар,
                ИТК07Данные.Единица, ИТК07Данные.Количество);
            ИТК07Поле = "ПланЗакупки";
            Если ИТК07Номер = 1 Тогда
                ИТК07Поле = "ФактЗакупки";
                Если ИТК07Данные.Стоимость > 0 Тогда
                    ИТК07Строка.СтоимостьПриемок = ИТК07Строка.СтоимостьПриемок + ИТК07Данные.Стоимость * ИТК07Доля;
                Иначе
                    ИТК07Строка.НеОценено = Истина;
                КонецЕсли;
            КонецЕсли;
            Если ИТК07Количество = Неопределено Тогда
                ИТК07Строка[ИТК07Поле] = Неопределено;
            ИначеЕсли ИТК07Строка[ИТК07Поле] <> Неопределено Тогда
                ИТК07Строка[ИТК07Поле] = ИТК07Строка[ИТК07Поле] + ИТК07Количество * ИТК07Доля;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Для Каждого ИТК07Строка Из ИТК07Таблица Цикл
        Если ИТК07Строка.НеОценено Тогда
            ИТК07Строка.СтоимостьПриемок = Неопределено;
        Иначе
            ИТК07Строка.СтоимостьПриемок = Окр(ИТК07Строка.СтоимостьПриемок, 2);
        КонецЕсли;
        Если ИТК07Строка.ПланЗакупки <> Неопределено Тогда
            ИТК07Строка.ПланЗакупки = Окр(ИТК07Строка.ПланЗакупки, 4);
        КонецЕсли;
        Если ИТК07Строка.ФактЗакупки <> Неопределено Тогда
            ИТК07Строка.ФактЗакупки = Окр(ИТК07Строка.ФактЗакупки, 4);
        КонецЕсли;
    КонецЦикла;
    Если Параметры.ЕстьТочка И ИТК07Факт.Количество() > 0 Тогда
        Предупреждения.Добавить("Центральные закупки отнесены к точке по распределению, сохранённому при отправке заказа. Нераспределённая часть и приёмки без заказа остаются в общем итоге закупок; фактические поставки точки показаны по ТТН.");
    КонецЕсли;
    ИТК07Таблица.Сортировать("ИмяТовара");
    Возврат ИТК07Таблица;
КонецФункции

// Подготовленные заказы используют текущий план. Отправленные и завершённые
// используют неизменяемый снимок на момент отправки.
Функция ИТК07РаспределениеЗакупок(Параметры, Предупреждения)
    ИТК07Таблица = ИТК07Таблица("Заказ,Товар,Точка,Единица,Количество,КоличествоЗаказа");
    Если Не Параметры.ЕстьТочка Тогда
        Возврат ИТК07Таблица;
    КонецЕсли;
    ИТК07Черновики = ИТК07Запрос(
        "ВЫБРАТЬ Строки.Ссылка КАК Заказ, Строки.Товар КАК Товар,
        | Строки.Заявка.ТорговаяТочка КАК Точка, Строки.ЕдиницыИзмерения КАК Единица,
        | Строки.Количество КАК Количество, Товары.Количество КАК КоличествоЗаказа
        |ИЗ Документ.ИТКЗаказПоставщику.Распределение КАК Строки
        | ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИТКЗаказПоставщику.Товары КАК Товары
        | ПО Товары.Ссылка = Строки.Ссылка И Товары.Товар = Строки.Товар
        | И Товары.ЕдиницыИзмерения = Строки.ЕдиницыИзмерения
        |ГДЕ Строки.Ссылка.Дата <= &Конец И НЕ Строки.Ссылка.ПометкаУдаления
        | И Строки.Ссылка.Состояние = ЗНАЧЕНИЕ(Перечисление.ИТКСостоянияЗаказов.Подготовлен)", Параметры);
    Для Каждого ИТК07Строка Из ИТК07Черновики Цикл
        ЗаполнитьЗначенияСвойств(ИТК07Таблица.Добавить(), ИТК07Строка);
    КонецЦикла;
    ИТК07Истории = ИТК07Запрос(
        "ВЫБРАТЬ Заказы.Ссылка КАК Заказ, Заказы.ИТКИсторияРаспределения КАК История
        |ИЗ Документ.ИТКЗаказПоставщику КАК Заказы
        |ГДЕ Заказы.Дата <= &Конец И НЕ Заказы.ПометкаУдаления
        | И (Заказы.Дата >= &Начало ИЛИ Заказы.Ссылка В
        | (ВЫБРАТЬ Приемки.ИТКЗаказПоставщику ИЗ Документ.ИТКПриемкаПартии КАК Приемки
        |  ГДЕ Приемки.Проведен И НЕ Приемки.ПометкаУдаления
        |  И Приемки.Дата >= &Начало И Приемки.Дата <= &Конец))
        | И Заказы.Ссылка В (ВЫБРАТЬ Товары.Ссылка ИЗ Документ.ИТКЗаказПоставщику.Товары КАК Товары
        |  ГДЕ НЕ &ЕстьКатегория ИЛИ Товары.Товар.ВидАссортимента = &Категория)
        | И Заказы.Состояние В (ЗНАЧЕНИЕ(Перечисление.ИТКСостоянияЗаказов.Отправлен),
        | ЗНАЧЕНИЕ(Перечисление.ИТКСостоянияЗаказов.Завершен))", Параметры);
    ИТК07НетИстории = Ложь;
    Для Каждого ИТК07Заказ Из ИТК07Истории Цикл
        Если ТипЗнч(ИТК07Заказ.История) <> Тип("ХранилищеЗначения") Тогда
            ИТК07НетИстории = Истина;
            Продолжить;
        КонецЕсли;
        ИТК07Снимок = ИТК07Заказ.История.Получить();
        Если ТипЗнч(ИТК07Снимок) <> Тип("Структура") Тогда
            ИТК07НетИстории = Истина;
            Продолжить;
        КонецЕсли;
        ИТК07Версия = Неопределено; ИТК07Строки = Неопределено;
        Если Не ИТК07Снимок.Свойство("Версия", ИТК07Версия)
            Или Не ИТК07Снимок.Свойство("Строки", ИТК07Строки) Тогда
            ИТК07НетИстории = Истина;
            Продолжить;
        КонецЕсли;
        Если ИТК07Версия <> 1 Или ТипЗнч(ИТК07Строки) <> Тип("ТаблицаЗначений") Тогда
            ИТК07НетИстории = Истина;
            Продолжить;
        КонецЕсли;
        Для Каждого ИТК07Строка Из ИТК07Строки Цикл
            ИТК07Новая = ИТК07Таблица.Добавить();
            ЗаполнитьЗначенияСвойств(ИТК07Новая, ИТК07Строка);
            ИТК07Новая.Заказ = ИТК07Заказ.Заказ;
        КонецЦикла;
    КонецЦикла;
    Если ИТК07НетИстории Тогда
        Предупреждения.Добавить("В выбранном периоде есть старые отправленные или завершённые заказы без сохранённой истории распределения. Их закупки не отнесены к точкам в блоке 4.1; общий итог закупок и поставки по ТТН сохраняются.");
    КонецЕсли;
    Возврат ИТК07Таблица;
КонецФункции

Функция ИТК07ДоляТочки(Распределение, Данные, Параметры)
    Если Не Параметры.ЕстьТочка Тогда
        Возврат 1;
    КонецЕсли;
    ИТК07Доля = 0;
    Для Каждого ИТК07Строка Из Распределение.НайтиСтроки(Новый Структура("Заказ,Товар", Данные.Заказ, Данные.Товар)) Цикл
        Если ИТК07Строка.Точка = Параметры.Точка И ИТК07Строка.КоличествоЗаказа > 0 Тогда
            ИТК07Доля = ИТК07Доля + ИТК07Строка.Количество / ИТК07Строка.КоличествоЗаказа;
        КонецЕсли;
    КонецЦикла;
    Возврат Мин(1, Макс(0, ИТК07Доля));
КонецФункции

Функция ИТК07Топ(Показатели, ПолеСтоимость, ПолеКоличество)
    ИТК07Таблица = Показатели.СкопироватьКолонки();
    ИТК07Индекс = Новый Соответствие;
    Для Каждого ИТК07Строка Из Показатели Цикл
        ИТК07ТоварСтрока = ИТК07Индекс.Получить(ИТК07Строка.Товар);
        Если ИТК07ТоварСтрока = Неопределено Тогда
            ИТК07ТоварСтрока = ИТК07Таблица.Добавить();
            ЗаполнитьЗначенияСвойств(ИТК07ТоварСтрока, ИТК07Строка, "Товар,ИмяТовара,Единица,Категория");
            ИТК07ТоварСтрока[ПолеКоличество] = 0;
            ИТК07ТоварСтрока[ПолеСтоимость] = 0;
            ИТК07Индекс.Вставить(ИТК07Строка.Товар, ИТК07ТоварСтрока);
        КонецЕсли;
        Если ИТК07ТоварСтрока[ПолеКоличество] <> Неопределено Тогда
            Если ИТК07Строка[ПолеКоличество] = Неопределено Тогда
                ИТК07ТоварСтрока[ПолеКоличество] = Неопределено;
            Иначе
                ИТК07ТоварСтрока[ПолеКоличество] = ИТК07ТоварСтрока[ПолеКоличество] + ИТК07Строка[ПолеКоличество];
            КонецЕсли;
        КонецЕсли;
        Если ИТК07ТоварСтрока[ПолеСтоимость] <> Неопределено Тогда
            Если ИТК07Строка[ПолеСтоимость] = Неопределено Тогда
                ИТК07ТоварСтрока[ПолеСтоимость] = Неопределено;
            Иначе
                ИТК07ТоварСтрока[ПолеСтоимость] = ИТК07ТоварСтрока[ПолеСтоимость] + ИТК07Строка[ПолеСтоимость];
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    ИТК07Таблица.Сортировать(ПолеСтоимость + " Убыв, ИмяТовара");
    ИТК07Итог = ИТК07Таблица.СкопироватьКолонки();
    Для Каждого ИТК07Строка Из ИТК07Таблица Цикл
        Если ИТК07Итог.Количество() >= 5 Тогда
            Прервать;
        КонецЕсли;
        Если ИТК07Строка[ПолеСтоимость] <> Неопределено И ИТК07Строка[ПолеСтоимость] > 0
            И ИТК07Строка[ПолеКоличество] <> Неопределено И ИТК07Строка[ПолеКоличество] > 0 Тогда
            ЗаполнитьЗначенияСвойств(ИТК07Итог.Добавить(), ИТК07Строка);
        КонецЕсли;
    КонецЦикла;
    Возврат ИТК07Итог;
КонецФункции

Функция ИТК07ВывестиОтчет(Данные)
    ИТК07Документ = Новый ТабличныйДокумент;
    ИТК07Документ.АвтоМасштаб = Истина;
    ИТК07НомерСтроки = 1;
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки, "Аналитика точек и ассортимента");
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Период: " + Формат(Данные.Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Данные.Конец, "ДФ=dd.MM.yyyy"));
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Точка: " + ?(ЗначениеЗаполнено(Данные.Точка), Строка(Данные.Точка), "все")
        + "; категория: " + ?(ЗначениеЗаполнено(Данные.Категория), Строка(Данные.Категория), "все"));
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Суммы - RUB. Прибыль расчётная: себестоимость последней проведённой приёмки на дату продажи.");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "1. Продажи и маржинальность",
        Данные.Продажи, "Период,ИмяТочки,Категория,Выручка,Себестоимость,Прибыль,Маржа",
        "Период|Точка|Категория|Выручка, RUB|Себестоимость, RUB|Расчётная прибыль, RUB|Маржинальность, %");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "2. Остатки и оборачиваемость",
        Данные.Товары, "ИмяТочки,ИмяТовара,Единица,НачальныйОстаток,Остаток,СреднийОстаток,Продано,Оборачиваемость",
        "Точка|Товар|Единица|Остаток на начало|Остаток на конец|Средний дневной остаток|Продано|Оборачиваемость, дней");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "3. ABC-анализ ассортимента",
        Данные.ABC, "ИмяТовара,Категория,Выручка,ДоляВыручки,ABCВыручки,Прибыль,ДоляПрибыли,ABCПрибыли",
        "Товар|Категория|Выручка, RUB|Доля выручки, %|ABC выручки|Прибыль, RUB|Доля положит. прибыли, %|ABC прибыли");
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "ABC: A - до 80%, B - до 95%, C - остальное; товар пересечения порога входит в текущую группу.");
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Убытки показаны в прибыли, но не увеличивают базу положительной прибыли для ABC. Нет базы - «-».");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "4.1. План и факт закупок поставщикам",
        Данные.Закупки, "ИмяТовара,Единица,ПланЗакупки,ФактЗакупки,СтоимостьПриемок",
        "Товар|Единица|План: заказы поставщикам|Факт: проведённые приёмки|Стоимость приёмок, RUB");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "4.2. Заявки, поставки и продажи торговых точек",
        Данные.Товары, "ИмяТочки,ИмяТовара,Единица,План,Поставлено,Продано",
        "Точка|Товар|Единица|План: проведённые заявки|Факт: поставки по ТТН|Фактические продажи");
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Блок 4.1: без отбора точки - все закупки; по точке - доля, сохранённая при отправке заказа. Нераспределённая часть остаётся в общем итоге.");
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Блок 4.2: заявки, ТТН и продажи внутри периода; поставки по ТТН - фактически доставленные на точку товары.");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "5. Топ-5 товаров по дефициту",
        Данные.ТопДефицит, "ИмяТовара,Единица,Дефицит,СтоимостьДефицита",
        "Товар|Единица|Не обеспечено резервом|Оценка по розничной цене, RUB");
    ИТК07ВывестиБлок(ИТК07Документ, ИТК07НомерСтроки, "6. Топ-5 товаров по остаткам на точках",
        Данные.ТопОстатки, "ИмяТовара,Единица,Остаток,СтоимостьОстатка",
        "Товар|Единица|Остаток|Оценка по себестоимости, RUB");
    ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки,
        "Оба топа ранжируются по оценке в RUB на конец периода: количества в разных единицах напрямую не сравниваются.");
    Если Данные.Предупреждения.Количество() > 0 Тогда
        ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки, "Проверка исходных данных");
        Для Каждого ИТК07Текст Из Данные.Предупреждения Цикл
            ИТК07Заголовок(ИТК07Документ, ИТК07НомерСтроки, ИТК07Текст);
        КонецЦикла;
    КонецЕсли;
    Возврат ИТК07Документ;
КонецФункции

Процедура ИТК07Заголовок(Документ, НомерСтроки, Текст)
    ИТК07Область = Документ.Область(НомерСтроки, 1, НомерСтроки, 8);
    ИТК07Область.Объединить();
    ИТК07Область.Текст = Текст;
    ИТК07Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    ИТК07Область.АвтоВысотаСтроки = Истина;
    НомерСтроки = НомерСтроки + 1;
КонецПроцедуры

Процедура ИТК07ВывестиБлок(Документ, НомерСтроки, Название, Таблица, ИменаПолей, Заголовки)
    НомерСтроки = НомерСтроки + 1;
    ИТК07Заголовок(Документ, НомерСтроки, Название);
    ИТК07Имена = СтрРазделить(ИменаПолей, ",");
    ИТК07Шапка = СтрРазделить(Заголовки, "|");
    Для ИТК07Колонка = 0 По ИТК07Имена.Количество() - 1 Цикл
        Документ.Область(НомерСтроки, ИТК07Колонка + 1).Текст = ИТК07Шапка[ИТК07Колонка];
        Документ.Область(НомерСтроки, ИТК07Колонка + 1).ШиринаКолонки = 22;
    КонецЦикла;
    НомерСтроки = НомерСтроки + 1;
    ИТК07ОбластьШапки = Документ.Область(НомерСтроки - 1, 1, НомерСтроки - 1, ИТК07Имена.Количество());
    ИТК07ОбластьШапки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    ИТК07ОбластьШапки.АвтоВысотаСтроки = Истина;
    Если Таблица.Количество() = 0 Тогда
        ИТК07Заголовок(Документ, НомерСтроки, "Нет данных по выбранным условиям.");
    КонецЕсли;
    Для Каждого ИТК07Строка Из Таблица Цикл
        Для ИТК07Колонка = 0 По ИТК07Имена.Количество() - 1 Цикл
            ИТК07Значение = ИТК07Строка[ИТК07Имена[ИТК07Колонка]];
            Документ.Область(НомерСтроки, ИТК07Колонка + 1).Текст = ИТК07Представление(ИТК07Значение);
        КонецЦикла;
        ИТК07ОбластьСтроки = Документ.Область(НомерСтроки, 1, НомерСтроки, ИТК07Имена.Количество());
        ИТК07ОбластьСтроки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
        ИТК07ОбластьСтроки.АвтоВысотаСтроки = Истина;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
КонецПроцедуры

Функция ИТК07Представление(Значение)
    Если Значение = Неопределено Тогда
        Возврат "-";
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат Формат(Значение, "ЧДЦ=2;ЧГ=0;ЧН=0");
    ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
        Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
    КонецЕсли;
    Возврат Строка(Значение);
КонецФункции

#КонецОбласти
